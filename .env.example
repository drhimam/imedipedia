# ============================================================================
# iMedipedia — Environment Variables
# ----------------------------------------------------------------------------
# Copy this file to .dev.vars for local development:
#   cp .env.example .dev.vars
# For production, set the SAME variables in:
#   Cloudflare Dashboard → Pages → imedipedia → Settings → Environment variables
#
# wrangler.toml [vars] only holds EMPTY placeholders — the real values live in
# .dev.vars (local) and the Cloudflare dashboard (production). Never commit
# .dev.vars to git.
# ============================================================================

# ----------------------------------------------------------------------------
# AI — CONTENT GENERATION (chat) — the OpenAI-compatible primary provider
# Used by: AI Studio article generation, admin "Generate/Summarize/Improve" buttons.
# ----------------------------------------------------------------------------
# Base URL of the OpenAI-compatible API. Include the version path, e.g. /v1.
AI_API_BASE_URL = "https://api.openai.com/v1"
# The chat model to call on the endpoint above.
AI_MODEL_NAME = "gpt-4o"
# API key for the endpoint above. Keep secret.
AI_API_KEY = "sk-..."

# ----------------------------------------------------------------------------
# AI — FALLBACK PROVIDERS (optional) — tried in order if the primary fails
# Used by: every chat/embedding call (a network error, non-2xx, or empty reply
# advances to the next provider). Leave all three fields empty to disable a fallback.
# ----------------------------------------------------------------------------
AI_FALLBACK1_BASE_URL = ""
AI_FALLBACK1_MODEL_NAME = ""
AI_FALLBACK1_API_KEY = ""
AI_FALLBACK2_BASE_URL = ""
AI_FALLBACK2_MODEL_NAME = ""
AI_FALLBACK2_API_KEY = ""

# ----------------------------------------------------------------------------
# AI — EMBEDDINGS (used by the Knowledge Base / RAG grounding)
# Used by: /api/admin/kb/ingest, /api/admin/kb/search, and grounded article
# generation in the AI Studio.
# ----------------------------------------------------------------------------
# The embedding model name. If left empty, the code defaults to
# "text-embedding-3-small" on whichever AI provider is currently reachable.
# Override this only if your provider uses a different embedding model name.
AI_EMBEDDING_MODEL_NAME = "text-embedding-3-small"

# ----------------------------------------------------------------------------
# TAVILY — WEB SEARCH (used by the Knowledge Base "Web search" ingestion source)
# Used by: /admin/kb → "🔎 Web search" tab, which fetches search-result content
# and ingests it as evidence sources.
# ----------------------------------------------------------------------------
# Get a free API key at https://app.tavily.com (Tavily Search API).
# Leave empty to disable the "Web search" source type (the other three —
# paste text, web URL, file upload — still work without it).
TAVILY_API_KEY = ""

# ----------------------------------------------------------------------------
# MISTRAL — DOCUMENT AI (used by the AI Studio Context Attachments)
# Used by: /api/admin/studio/extract-content to extract text/structured data
# from PDFs, DOCX, PPTX, and images (PNG, JPEG, etc.).
# ----------------------------------------------------------------------------
# Get an API key at https://console.mistral.ai
# Leave empty to disable document/image support in the Studio Context section
# (text paste, web URL, and YouTube transcripts will still work without it).
MISTRAL_API_KEY = ""

# ----------------------------------------------------------------------------
# AI — IMAGE GENERATION (cover images in the AI Studio)
# Used by: /api/admin/studio/cover → "✨ Generate cover".
# This is a SEPARATE provider config from the chat provider above.
# ----------------------------------------------------------------------------
AI_IMAGE_BASE_URL = ""
AI_IMAGE_MODEL_NAME = ""
AI_IMAGE_API_KEY = ""

# Optional image-quality overrides (safe to delete — defaults are cost-optimized
# for web covers). Leave commented unless you want to tune cost/size:
#   AI_IMAGE_SIZE = "1536x1024"          # landscape; also 1024x1024, 1024x1536
#   AI_IMAGE_QUALITY = "low"             # low | medium | high | auto
#   AI_IMAGE_OUTPUT_FORMAT = "webp"      # webp | jpeg | png
#   AI_IMAGE_COMPRESSION = "50"          # 0-100 (lower = smaller file, only for webp/jpeg)

# ----------------------------------------------------------------------------
# AWS SES — EMAIL (password reset, contributor notifications)
# Used by: forgot-password, application review, submission create/review emails.
# ----------------------------------------------------------------------------
AWS_REGION = "us-east-1"
AWS_ACCESS_KEY_ID = "AKIA..."
AWS_SECRET_ACCESS_KEY = "..."
# Must be a verified sender identity in your SES account.
SES_FROM_EMAIL = "noreply@imedipedia.org"
# Display name displayed in email clients (defaults to "iMedipedia Admin")
SES_FROM_NAME = "iMedipedia Admin"

# ----------------------------------------------------------------------------
# CLOUDFLARE R2 — IMAGE STORAGE (cover + inline + upload images)
# Used by: /api/images/upload and the AI Studio cover upload.
# ----------------------------------------------------------------------------
# Cloudflare account ID (Dashboard → your account → Overview).
R2_ACCOUNT_ID = ""
# R2 API token credentials — only needed for the S3-compatible fallback used in
# local dev; production uses the native R2 binding from wrangler.toml.
# Create: Dashboard → R2 → Manage R2 API Tokens.
R2_ACCESS_KEY_ID = ""
R2_SECRET_ACCESS_KEY = ""
# Bucket name (default imedipedia-images).
R2_BUCKET_NAME = "imedipedia-images"
# Public base URL of the bucket (Dashboard → R2 → bucket → Settings → Public access).
R2_PUBLIC_URL = ""

# ----------------------------------------------------------------------------
# GITHUB — ADMIN PUBLISH & TAXONOMY SYNC
# Used by: /api/admin/publish, /api/admin/update-article, subjects-save, exams-save
# — all push markdown/JSON to the repo via the GitHub Contents API.
# ----------------------------------------------------------------------------
# Personal access token with "Contents: Read and Write" on the repo.
GITHUB_TOKEN = "ghp_..."
# Repository as "owner/repo".
GITHUB_REPO = "drhimam/imedipedia"
