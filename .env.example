# iMedipedia Environment Variables
# Copy this file to .dev.vars and fill in your values

# AI API (OpenAI-compatible endpoint for content generation)
AI_API_BASE_URL = "https://api.openai.com/v1"
AI_MODEL_NAME = "gpt-4o"
AI_API_KEY = "sk-..."

# AI fallback providers — used in order if the primary fails
AI_FALLBACK1_BASE_URL = ""
AI_FALLBACK1_MODEL_NAME = ""
AI_FALLBACK1_API_KEY = ""
AI_FALLBACK2_BASE_URL = ""
AI_FALLBACK2_MODEL_NAME = ""
AI_FALLBACK2_API_KEY = ""

# Embeddings (used for Knowledge Base / RAG grounding)
# Defaults to text-embedding-3-small on the primary AI provider if unset.
AI_EMBEDDING_MODEL_NAME = "text-embedding-3-small"

# Tavily web search (Knowledge Base → Web search ingestion)
TAVILY_API_KEY = ""

# AI image generation (cover images)
AI_IMAGE_BASE_URL = ""
AI_IMAGE_MODEL_NAME = ""
AI_IMAGE_API_KEY = ""
# Optional overrides (defaults are cost-optimized for web covers):
# AI_IMAGE_SIZE = "1536x1024"          # landscape
# AI_IMAGE_QUALITY = "low"             # low | medium | high | auto
# AI_IMAGE_OUTPUT_FORMAT = "webp"      # webp | jpeg | png
# AI_IMAGE_COMPRESSION = "50"          # 0-100 for webp/jpeg (lower = smaller file)

# AWS SES (for password reset emails)
AWS_REGION = "us-east-1"
AWS_ACCESS_KEY_ID = "AKIA..."
AWS_SECRET_ACCESS_KEY = "..."
SES_FROM_EMAIL = "noreply@imedipedia.org"

# Cloudflare R2 (for image storage)
# Create bucket: npx wrangler r2 bucket create imedipedia-images
# Get credentials from Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID = ""
R2_ACCESS_KEY_ID = ""
R2_SECRET_ACCESS_KEY = ""
R2_BUCKET_NAME = "imedipedia-images"
R2_PUBLIC_URL = ""

# GitHub (for admin publish — auto-push approved articles to the repo)
GITHUB_TOKEN = "ghp_..."
GITHUB_REPO = "drhimam/imedipedia"
