---
export interface Props {
  title: string;
  description?: string;
  /** Which nav link is active: 'general' | 'clinical-guidelines' | 'cases' | 'education' | 'contributors' */
  currentPage?: string;
}

const { title, description, currentPage } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, 'https://imedipedia.com').href} />
    <meta property="og:site_name" content="iMedipedia" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={new URL(Astro.url.pathname, 'https://imedipedia.com').href} />

    <!-- Preconnect to Google Fonts (eliminates @import render-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Plus+Jakarta+Sans:wght@300;400;500;700&display=swap"
    />

    <!--
      THEME-BLOCKING SCRIPT: runs synchronously before any CSS or body content,
      so the correct data-theme attribute is on <html> before the first paint.
      No more black flash on page navigation.
    -->
    <script is:inline>
      (function(){var t=localStorage.getItem('theme')||'dark';document.documentElement.setAttribute('data-theme',t);})();
    </script>

    <style>
      /* ============================================================
         GLOBAL DESIGN TOKENS & SHARED CHROME
         ============================================================
         :global() punches through Astro's scoping so these target
         the real <html>, <body>, and DOM elements.
      */

      /* ---- Dark theme (default) ---- */
      :global(:root) {
        --bg: #030712;
        --card-bg: rgba(17, 24, 39, 0.7);
        --accent: #0d9488;
        --accent-glow: rgba(13, 148, 136, 0.15);
        --text: #f3f4f6;
        --muted: #9ca3af;
        --border: rgba(255, 255, 255, 0.08);
        --success: #10b981;
        --warning: #f59e0b;
        --success-glow: rgba(16, 185, 129, 0.1);
        --warning-glow: rgba(245, 158, 11, 0.1);
        --navbar-bg: rgba(3, 7, 18, 0.75);
        --hero-bg: rgba(3, 7, 18, 0.6);
        --footer-bg: rgba(15, 23, 42, 0.4);
        --footer-input-bg: rgba(255, 255, 255, 0.05);
      }

      /* ---- Light theme ---- */
      :global([data-theme="light"]) {
        --bg: #f0f4f8;
        --card-bg: rgba(255, 255, 255, 1);
        --accent: #0d9488;
        --accent-glow: rgba(13, 148, 136, 0.12);
        --text: #0f172a;
        --muted: #374151;
        --border: rgba(0, 0, 0, 0.12);
        --success: #059669;
        --warning: #d97706;
        --success-glow: rgba(5, 150, 105, 0.1);
        --warning-glow: rgba(217, 119, 6, 0.1);
        --navbar-bg: rgba(255, 255, 255, 0.92);
        --hero-bg: rgba(240, 244, 248, 0.8);
        --footer-bg: #e2e8f0;
        --footer-input-bg: rgba(255, 255, 255, 0.1);
      }

      /* ---- <html> background: prevents any flash of wrong color ---- */
      :global(html) {
        background-color: var(--bg);
      }

      /* ---- Body ---- */
      :global(body) {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background-color: var(--bg);
        color: var(--text);
        margin: 0;
        padding: 0;
        line-height: 1.6;
        transition: background-color 0.3s, color 0.3s;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      /* ---- Responsive Images & Content Media ---- */
      :global(img) {
        max-width: 100%;
        height: auto;
        box-sizing: border-box;
      }

      :global(.article-body img),
      :global(.content img),
      :global(.article-view img) {
        max-width: 100% !important;
        height: auto !important;
        border-radius: 8px;
        display: block;
        margin: 1.5rem auto;
      }

      /* ============================================================
         NAVBAR
         ============================================================ */
      :global(.navbar) {
        border-bottom: 1px solid var(--border);
        backdrop-filter: blur(16px);
        background: var(--navbar-bg);
        position: sticky;
        top: 0;
        z-index: 50;
        padding: 0.75rem 2rem;
      }

      :global(.nav-container) {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
      }

      :global(.logo-link:any-link) {
        text-decoration: none;
      }

      :global(.logo) {
        font-family: 'Outfit', sans-serif;
        font-weight: 800;
        font-size: 1.6rem;
        background: linear-gradient(135deg, #0ea5e9, #0d9488);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -0.5px;
      }

      :global(.nav-links) {
        display: flex;
        align-items: center;
        gap: 1.25rem;
      }

      /* ---- Hamburger menu (hidden on desktop) ---- */
      :global(.nav-toggle-hidden) {
        display: none;
      }

      :global(.hamburger) {
        display: none;
        flex-direction: column;
        gap: 5px;
        cursor: pointer;
        padding: 8px;
        z-index: 51;
      }

      :global(.hamburger span) {
        display: block;
        width: 24px;
        height: 2.5px;
        background: var(--text);
        border-radius: 2px;
        transition: all 0.3s ease;
      }

      /* ---- Dropdown Menus ---- */
      :global(.nav-dropdown) {
        position: relative;
      }
      
      :global(.nav-dropdown-btn) {
        background: none;
        border: none;
        color: var(--text);
        font-weight: 600;
        font-size: 0.95rem;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        font-family: inherit;
        display: flex;
        align-items: center;
        gap: 0.3rem;
      }
      
      :global(.nav-dropdown-btn::after) {
        content: '▾';
        font-size: 0.85em;
        transition: transform 0.2s;
      }
      
      :global(.nav-dropdown:hover .nav-dropdown-btn) {
        color: #0d9488;
      }
      
      :global(.nav-dropdown:hover .nav-dropdown-btn::after) {
        transform: rotate(180deg);
      }
      
      :global(.nav-dropdown-content) {
        position: absolute;
        top: 100%;
        left: 0;
        background: var(--navbar-bg);
        backdrop-filter: blur(16px);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 0.5rem;
        min-width: 220px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        opacity: 0;
        visibility: hidden;
        transform: translateY(10px);
        transition: all 0.2s ease;
        z-index: 60;
      }
      
      :global(.nav-dropdown:hover .nav-dropdown-content) {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }
      
      :global(.nav-dropdown-content a) {
        color: var(--text);
        text-decoration: none;
        font-weight: 500;
        font-size: 0.9rem;
        padding: 0.6rem 1rem;
        border-radius: 8px;
        transition: all 0.2s ease;
      }
      
      :global(.nav-dropdown-content a:hover) {
        background: rgba(13, 148, 136, 0.1);
        color: #0d9488;
      }
      
      :global(.nav-actions) {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      
      /* Display contents on desktop so space-between still works */
      @media (min-width: 769px) {
        :global(.mobile-nav-drawer) {
          display: contents;
        }
      }

      /* :any-link bumps specificity to beat browser's a:link / a:visited defaults */
      :global(.nav-link:any-link) {
        color: var(--text);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        transition: all 0.2s ease;
        position: relative;
      }

      :global(.nav-link:hover) {
        color: #0d9488;
      }

      :global(.nav-link.active) {
        background: rgba(13, 148, 136, 0.1);
        color: #0d9488 !important;
      }

      :global(.nav-link.active::after) {
        content: '';
        position: absolute;
        bottom: 0px;
        left: 25%;
        width: 50%;
        height: 2.5px;
        background: #0d9488;
        border-radius: 2px;
      }

      :global(.btn-contributors:any-link) {
        background: var(--card-bg);
        border: 1px solid var(--border);
        color: var(--text);
        padding: 0.5rem 1.25rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        transition: all 0.2s ease;
      }

      :global(.btn-contributors:hover) {
        background: rgba(13, 148, 136, 0.05);
        border-color: #0d9488;
        color: #0d9488;
      }

      :global(.btn-contributors.active) {
        background: rgba(13, 148, 136, 0.1);
        color: #0d9488 !important;
        border-color: #0d9488;
      }

      /* ---- Contact Button ---- */
      :global(.btn-contact) {
        background: #0d9488;
        color: #ffffff !important;
        border: none;
        padding: 0.5rem 1.25rem;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
      }

      :global(.btn-contact:hover) {
        background: #0f766e;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(13, 148, 136, 0.2);
      }

      /* ---- Theme Toggle ---- */
      :global(.theme-btn) {
        background: var(--card-bg);
        border: 1px solid var(--border);
        color: var(--text);
        width: 38px;
        height: 38px;
        border-radius: 8px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        transition: all 0.2s;
        padding: 0;
      }

      :global(.theme-btn:hover) {
        border-color: #0d9488;
        color: #0d9488;
      }

      /* ---- Navbar mobile (≤768px) ---- */
      @media (max-width: 768px) {
        :global(.navbar) {
          padding: 0.6rem 1rem;
        }

        :global(.logo) {
          font-size: 1.3rem;
        }

        :global(.hamburger) {
          display: flex;
        }
        
        :global(#nav-toggle:checked ~ .hamburger span:nth-child(1)) {
          transform: translateY(7.5px) rotate(45deg);
        }
        
        :global(#nav-toggle:checked ~ .hamburger span:nth-child(2)) {
          opacity: 0;
        }
        
        :global(#nav-toggle:checked ~ .hamburger span:nth-child(3)) {
          transform: translateY(-7.5px) rotate(-45deg);
        }



        /* Dropdown when hamburger is clicked */
        :global(.mobile-nav-drawer) {
          position: fixed;
          top: 0;
          right: -300px;
          width: 300px;
          height: 100vh;
          height: 100dvh;
          box-sizing: border-box;
          background: var(--navbar-bg);
          backdrop-filter: blur(24px);
          border-left: 1px solid var(--border);
          transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
          z-index: 100;
          display: flex;
          flex-direction: column;
          padding-top: 5rem;
          padding-bottom: 2rem;
          box-shadow: -10px 0 40px rgba(0, 0, 0, 0.2);
          overflow-y: auto;
        }

        :global(#nav-toggle:checked ~ .mobile-nav-drawer) {
          transform: translateX(-300px);
        }

        :global(.nav-links) {
          flex-direction: column;
          gap: 0;
          padding: 0 1.5rem;
          display: flex;
        }

        :global(.nav-actions) {
          display: flex;
          flex-wrap: wrap;
          padding: 1.5rem;
          margin-top: auto;
          border-top: 1px solid var(--border);
          justify-content: center;
          gap: 1rem;
        }
        
        :global(.nav-dropdown-content) {
          position: static;
          box-shadow: none;
          background: rgba(0, 0, 0, 0.03);
          border: none;
          padding: 0.5rem;
          margin-top: 0.25rem;
          border-radius: 8px;
          display: none;
          opacity: 1;
          visibility: visible;
          transform: none;
        }
        
        :global(.nav-dropdown:hover .nav-dropdown-content),
        :global(.nav-dropdown:active .nav-dropdown-content) {
          display: flex;
        }
        
        :global(.nav-dropdown-btn) {
          width: 100%;
          justify-content: space-between;
          padding: 0.75rem 1rem;
        }
      }



      /* ============================================================
         FOOTER
         ============================================================ */
      :global(.footer) {
        background: var(--footer-bg);
        border-top: 1px solid var(--border);
        padding: 5rem 2rem 2rem 2rem;
        margin-top: 6rem;
        font-size: 0.9rem;
        color: var(--text);
        opacity: 0.8;
      }

      :global(.footer-container) {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 2fr 1.5fr 1.5fr;
        gap: 4rem;
        margin-bottom: 4rem;
      }

      :global(.footer-brand-section) {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        text-align: left;
      }

      :global(.footer-logo) {
        font-family: 'Outfit', sans-serif;
        font-weight: 800;
        font-size: 1.5rem;
        background: linear-gradient(135deg, #0ea5e9, #0d9488);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -0.5px;
      }

      :global(.footer-text) {
        line-height: 1.6;
        color: var(--muted);
        text-align: left;
      }

      :global(.footer-disclaimer) {
        font-size: 0.78rem;
        line-height: 1.5;
        color: var(--muted);
        opacity: 0.85;
        border-left: 2px solid var(--accent);
        padding-left: 1rem;
        text-align: left;
      }

      :global(.footer-heading) {
        font-family: 'Outfit', sans-serif;
        color: var(--text);
        font-size: 1.05rem;
        font-weight: 700;
        margin-top: 0;
        margin-bottom: 1.5rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        text-align: left;
      }

      :global(.footer-links) {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        text-align: left;
      }

      :global(.footer-link:any-link) {
        color: var(--muted);
        text-decoration: none;
        transition: color 0.2s, transform 0.2s;
        display: inline-block;
      }

      :global(.footer-link:hover) {
        color: var(--accent);
        transform: translateX(2px);
      }

      :global(.footer-subscribe-form) {
        display: flex;
        gap: 0.5rem;
        margin-top: 1rem;
      }

      :global(.footer-input) {
        background: var(--footer-input-bg);
        border: 1px solid rgba(255, 255, 255, 0.15);
        padding: 0.6rem 1rem;
        border-radius: 8px;
        color: #e2e8f0;
        font-size: 0.88rem;
        flex-grow: 1;
        outline: none;
      }

      :global(.footer-input:focus) {
        border-color: var(--accent);
      }

      :global(.footer-btn) {
        background: var(--accent);
        color: white;
        border: none;
        padding: 0.6rem 1.25rem;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.88rem;
        cursor: pointer;
        transition: background 0.2s;
      }

      :global(.footer-btn:hover) {
        background: #0f766e;
      }

      :global(.footer-bottom) {
        max-width: 1200px;
        margin: 0 auto;
        border-top: 1px solid var(--border);
        padding-top: 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1.5rem;
      }

      :global(.footer-badge-list) {
        display: flex;
        gap: 1.5rem;
        align-items: center;
      }

      :global(.footer-badge) {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        border: 1px solid var(--border);
        padding: 0.25rem 0.6rem;
        border-radius: 4px;
        color: var(--muted);
      }

      @media (max-width: 900px) {
        :global(.footer-container) {
          grid-template-columns: 1fr 1fr;
          gap: 2.5rem;
        }
      }

      @media (max-width: 600px) {
        :global(.footer-container) {
          grid-template-columns: 1fr;
        }
        :global(.footer-bottom) {
          flex-direction: column;
          align-items: flex-start;
        }
      }

      @media (max-width: 480px) {
        :global(.footer) {
          padding: 3rem 1rem 1.5rem 1rem;
        }
        :global(.footer-bottom) {
          gap: 1rem;
        }
        :global(.contact-modal-content) {
          padding: 1.5rem;
        }
        :global(.contact-modal-content) h2 {
          padding-right: 1.5rem;
        }
        :global(.contact-modal-content) input,
        :global(.contact-modal-content) textarea {
          font-size: 16px; /* prevents iOS zoom on focus */
        }
      }
    </style>

    <!-- Page-specific head content (extra meta tags, page-level styles) -->
    <slot name="head" />
  </head>
  <body>
    <!-- ============================================================
    NAVBAR
    ============================================================ -->
    <nav class="navbar">
      <div class="nav-container">
        <a href="/" class="logo-link"><div class="logo">iMedipedia</div></a>
        <input type="checkbox" id="nav-toggle" class="nav-toggle-hidden" />
        <label for="nav-toggle" class="hamburger" aria-label="Toggle navigation" style="z-index: 101;">
          <span></span><span></span><span></span>
        </label>
        
        <div class="mobile-nav-drawer">
          <div class="nav-links">
            <div class="nav-dropdown">
              <button class="nav-dropdown-btn">Browse</button>
              <div class="nav-dropdown-content">
                <a href="/general">Research Digest</a>
                <a href="/clinical-guidelines">Clinical Guidelines</a>
                <a href="/cases">Case Reports</a>
                <a href="/education">Board Review</a>
                <a href="/research-articles">Research Articles</a>
              </div>
            </div>
            
            <div class="nav-dropdown">
              <button class="nav-dropdown-btn">Get Involved</button>
              <div class="nav-dropdown-content">
                <a href="/contributors">Contributor</a>
                <a href="/reviewers">Peer Review</a>
                <a href="/manuscript-submission">Manuscript Submission</a>
                <a href="/subscribe">Subscribe</a>
                <a href="/volunteer">Volunteer</a>
                <a href="/donate">Donate</a>
              </div>
            </div>

            <div class="nav-dropdown">
              <button class="nav-dropdown-btn">Resources</button>
              <div class="nav-dropdown-content">
                <a href="/journals">Journals</a>
                <a href="/tools">Tools</a>
                <a href="/dissertation">Dissertation</a>
                <a href="/publications">Publications</a>
                <a href="/cme-courses">CME and Courses</a>
              </div>
            </div>
          </div>

          <div class="nav-actions">
            <a href="/admin" class="btn-contributors" id="adminNavLink" style="display:none;">Admin</a>
            <a href="/contact" class="btn-contact" id="contactNavBtn">Contact</a>
            <button id="themeToggle" class="theme-btn">☀️</button>
          </div>
        </div>
      </div>
    </nav>

    <!-- ============================================================
    PAGE CONTENT
    ============================================================ -->
    <slot />



    <!-- ============================================================
    FOOTER
    ============================================================ -->
    <footer class="footer">
      <div class="footer-container">
        <div class="footer-brand-section">
          <div class="footer-logo">iMedipedia</div>
          <p class="footer-text">An open-access, peer-reviewed medical and scientific research platform. Providing evidence-based summaries, clinical updates, and board review insights for practitioners globally.</p>
          <div class="footer-disclaimer">
            <strong>Disclaimer:</strong> The contents of iMedipedia are for educational and informational purposes only. This platform does not provide professional medical advice, diagnosis, or treatment.
          </div>
        </div>

        <div>
          <h4 class="footer-heading">Research Digests</h4>
          <div class="footer-links">
            <a href="/general" class="footer-link">Clinical &amp; Research Digest</a>
            <a href="/clinical-guidelines" class="footer-link">Clinical Guidelines</a>
            <a href="/cases" class="footer-link">Case Reports Database</a>
            <a href="/education" class="footer-link">Board Prep &amp; CME</a>
          </div>
        </div>

        <div>
          <h4 class="footer-heading">Contributors &amp; Reviewers</h4>
          <div class="footer-links">
            <a href="/contributors" class="footer-link">Our Medical Authors</a>
            <a href="/reviewers" class="footer-link">Peer Review Board</a>
            <a href="/contributors" class="footer-link">Join as Contributor</a>
            <a href="/reviewers" class="footer-link">Join as Peer Reviewer</a>
            <a href="/contributors/dashboard" class="footer-link">Author Dashboard</a>
            <a href="/reviewers/login" class="footer-link">Peer Reviewer Login</a>
            <a href="/reviewers/dashboard" class="footer-link">Reviewer Dashboard</a>
          </div>
        </div>


      </div>

      <div class="footer-bottom">
        <div class="footer-text" style="font-size: 0.85rem; margin: 0;">
          &copy; {new Date().getFullYear()} iMedipedia. All rights reserved.
        </div>
        <div class="footer-badge-list">
          <span class="footer-badge">Evidence-Based</span>
          <span class="footer-badge">Peer-Reviewed</span>
          <span class="footer-badge">HONcode Compliant</span>
        </div>
      </div>
    </footer>

    <!-- ============================================================
    COMMON SCRIPTS: theme toggle + contact modal
    ============================================================ -->
    <script is:inline>
      // Update the theme toggle icon to match what the blocking script set
      (function(){
        var tt = document.getElementById('themeToggle');
        if (tt) {
          tt.textContent = (localStorage.getItem('theme') || 'dark') === 'dark' ? '☀️' : '🌙';
        }
      })();

      // Show admin nav link for admin/co-admin users
      (function(){
        try {
          var userData = sessionStorage.getItem('user');
          if (userData) {
            var user = JSON.parse(userData);
            if (user && (user.role === 'admin' || user.role === 'co-admin')) {
              var adminLink = document.getElementById('adminNavLink');
              if (adminLink) adminLink.style.display = '';
            }
          }
        } catch(e) {}
      })();

      // Theme Toggle
      var themeToggle = document.getElementById('themeToggle');
      if (themeToggle) {
        themeToggle.addEventListener('click', function () {
          var current = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', current);
          localStorage.setItem('theme', current);
          themeToggle.textContent = current === 'dark' ? '☀️' : '🌙';
        });
      }


    </script>

    <!-- Page-specific scripts -->
