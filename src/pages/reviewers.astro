---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Peer Review Board - iMedipedia Medical Research"
  description="iMedipedia upholds the highest standards of scientific and clinical rigor through structured, independent peer review by practicing physicians and medical researchers."
  currentPage="reviewers"
>
  <slot name="head">
    <style>
      /* Layout & Structure */
      .portal-layout {
        max-width: 1220px;
        margin: 3.5rem auto;
        padding: 0 1.5rem;
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 2.5rem;
        width: 100%;
        box-sizing: border-box;
        align-items: start;
      }

      .portal-main {
        min-width: 0;
      }

      .portal-sidebar {
        min-width: 0;
      }

      .sticky-panel {
        position: sticky;
        top: 5.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }

      /* Hero Header */
      .portal-header {
        text-align: left;
        margin-bottom: 3.5rem;
        position: relative;
      }

      .portal-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--accent);
        background: rgba(13, 148, 136, 0.12);
        padding: 0.35rem 0.85rem;
        border-radius: 20px;
        margin-bottom: 1rem;
        border: 1px solid rgba(13, 148, 136, 0.2);
      }

      .portal-header h1 {
        font-family: 'Outfit', sans-serif;
        font-size: 3rem;
        font-weight: 800;
        letter-spacing: -1px;
        margin: 0 0 0.75rem 0;
        line-height: 1.15;
      }

      .portal-header p {
        color: var(--muted);
        font-size: 1.1rem;
        max-width: 720px;
        margin: 0;
        line-height: 1.6;
      }
      
      .hero-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 2rem;
      }

      .btn {
        background: var(--accent);
        color: #ffffff;
        border: none;
        padding: 0.85rem 1.75rem;
        font-size: 1rem;
        font-weight: 700;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        text-decoration: none;
      }

      .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px var(--accent-glow);
        background: #0f766e;
      }

      .btn-secondary {
        background: var(--card-bg);
        border: 1px solid var(--border);
        color: var(--text);
      }

      .btn-secondary:hover {
        border-color: var(--accent);
        color: var(--accent);
        background: rgba(13, 148, 136, 0.08);
      }

      /* Review Process Cards */
      .process-section {
        margin-bottom: 4.5rem;
      }

      .section-subtitle-tag {
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--accent);
        margin-bottom: 0.5rem;
        display: block;
      }

      .process-heading {
        font-family: 'Outfit', sans-serif;
        font-size: 1.85rem;
        font-weight: 800;
        margin: 0 0 1.5rem 0;
        letter-spacing: -0.5px;
      }

      .process-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.25rem;
      }

      .process-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 1.75rem;
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
      }

      .process-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, transparent, var(--accent), transparent);
        opacity: 0;
        transition: opacity 0.3s;
      }

      .process-card:hover {
        transform: translateY(-4px);
        border-color: var(--accent);
        box-shadow: 0 10px 30px var(--accent-glow);
      }

      .process-card:hover::before {
        opacity: 1;
      }

      .process-icon {
        font-size: 2rem;
        margin-bottom: 1rem;
        display: inline-block;
      }

      .process-title {
        font-family: 'Outfit', sans-serif;
        font-size: 1.2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: var(--text);
      }

      .process-desc {
        color: var(--muted);
        font-size: 0.92rem;
        line-height: 1.55;
        margin: 0;
      }

      /* Reviewer Gallery */
      .gallery-section {
        scroll-margin-top: 6rem;
      }

      .gallery-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 2rem;
        border-bottom: 1px solid var(--border);
        padding-bottom: 1.25rem;
      }

      .gallery-title {
        font-family: 'Outfit', sans-serif;
        font-size: 2rem;
        font-weight: 800;
        margin: 0;
        letter-spacing: -0.5px;
      }

      .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
      }

      .reviewer-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 2rem 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
      }

      .reviewer-card:hover {
        transform: translateY(-5px);
        border-color: var(--accent);
        box-shadow: 0 12px 35px var(--accent-glow);
      }

      .reviewer-avatar {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid var(--border);
        margin-bottom: 1.25rem;
        background: #090d16;
        transition: border-color 0.2s ease;
      }

      .reviewer-card:hover .reviewer-avatar {
        border-color: var(--accent);
      }

      .reviewer-name {
        font-family: 'Outfit', sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        margin: 0 0 0.35rem 0;
        color: var(--text);
      }

      .reviewer-affiliation {
        color: var(--muted);
        font-size: 0.85rem;
        margin-bottom: 0.75rem;
        font-weight: 500;
        line-height: 1.4;
      }

      .reviewer-specialties {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        justify-content: center;
        margin-bottom: 1rem;
      }

      .spec-badge {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--accent);
        background: rgba(13, 148, 136, 0.1);
        padding: 0.25rem 0.55rem;
        border-radius: 10px;
        border: 1px solid rgba(13, 148, 136, 0.2);
      }

      .reviewer-bio {
        color: var(--muted);
        font-size: 0.86rem;
        line-height: 1.5;
        margin-bottom: 0;
        flex-grow: 1;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      /* Right Sidebar Navigation Widgets */
      .sidebar-widget {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 1.5rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        backdrop-filter: blur(12px);
      }

      .widget-title {
        font-family: 'Outfit', sans-serif;
        font-size: 1.1rem;
        font-weight: 700;
        margin: 0 0 1rem 0;
        padding-bottom: 0.6rem;
        border-bottom: 1px solid var(--border);
        color: var(--text);
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .sidebar-nav-list {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
      }

      .sidebar-action-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.85rem 1rem;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--border);
        color: var(--text);
        text-decoration: none;
        font-size: 0.92rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        text-align: left;
        width: 100%;
        box-sizing: border-box;
      }

      :global([data-theme="light"]) .sidebar-action-btn {
        background: rgba(0, 0, 0, 0.02);
      }

      .sidebar-action-btn:hover {
        border-color: var(--accent);
        background: rgba(13, 148, 136, 0.08);
        color: var(--accent);
        transform: translateX(3px);
      }

      .sidebar-action-btn.primary {
        background: linear-gradient(135deg, rgba(13, 148, 136, 0.2), rgba(14, 165, 233, 0.15));
        border-color: rgba(13, 148, 136, 0.4);
        color: var(--text);
      }

      .sidebar-action-btn.primary:hover {
        background: linear-gradient(135deg, rgba(13, 148, 136, 0.3), rgba(14, 165, 233, 0.25));
        border-color: var(--accent);
        color: var(--accent);
      }

      .action-left {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .action-icon {
        font-size: 1.25rem;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .action-text {
        display: flex;
        flex-direction: column;
      }

      .action-text strong {
        font-size: 0.9rem;
        color: var(--text);
        line-height: 1.2;
      }

      .action-text small {
        font-size: 0.75rem;
        color: var(--muted);
        font-weight: 400;
        margin-top: 2px;
      }

      .action-arrow {
        color: var(--muted);
        font-size: 1.1rem;
        transition: transform 0.2s;
      }

      .sidebar-action-btn:hover .action-arrow {
        color: var(--accent);
        transform: translateX(3px);
      }

      /* Sidebar Highlights Card */
      .sidebar-info-card {
        background: linear-gradient(180deg, rgba(13, 148, 136, 0.06), var(--card-bg));
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 1.25rem;
      }

      .info-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.85rem;
      }

      .info-card-title {
        font-family: 'Outfit', sans-serif;
        font-size: 0.95rem;
        font-weight: 700;
        margin: 0;
        color: var(--text);
      }

      .info-badge {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--accent);
        background: rgba(13, 148, 136, 0.15);
        padding: 0.15rem 0.5rem;
        border-radius: 6px;
      }

      .info-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
      }

      .info-list li {
        font-size: 0.82rem;
        color: var(--muted);
        line-height: 1.45;
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
      }

      .info-list li span.check {
        color: var(--accent);
        font-weight: bold;
      }

      /* Modal */
      .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(3, 7, 18, 0.75);
        backdrop-filter: blur(8px);
        z-index: 1000;
        display: none;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s ease;
        padding: 1.5rem;
        box-sizing: border-box;
      }

      .modal-overlay.active {
        display: flex;
        opacity: 1;
      }

      .modal-content {
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 24px;
        max-width: 600px;
        width: 100%;
        max-height: 90vh;
        overflow-y: auto;
        padding: 2.5rem;
        position: relative;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
      }

      .modal-close {
        position: absolute;
        top: 1.25rem;
        right: 1.25rem;
        background: transparent;
        border: none;
        color: var(--muted);
        font-size: 1.6rem;
        cursor: pointer;
        line-height: 1;
        transition: color 0.2s;
      }

      .modal-close:hover {
        color: var(--text);
      }

      .form-group {
        margin-bottom: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }

      .form-label {
        font-size: 0.82rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--muted);
      }

      .form-input, .form-textarea {
        padding: 0.8rem 1rem;
        border-radius: 10px;
        border: 1px solid var(--border);
        background: var(--card-bg);
        color: var(--text);
        font-size: 0.95rem;
        transition: border-color 0.2s;
      }

      .form-input:focus, .form-textarea:focus {
        outline: none;
        border-color: var(--accent);
      }

      .form-textarea {
        resize: vertical;
        min-height: 100px;
        font-family: inherit;
      }

      .alert {
        padding: 0.85rem 1.15rem;
        border-radius: 10px;
        font-size: 0.9rem;
        margin-bottom: 1.25rem;
        display: none;
      }

      .alert-error {
        background: rgba(239, 68, 68, 0.12);
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: #ef4444;
      }

      .alert-success {
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.3);
        color: #10b981;
      }

      @media (max-width: 992px) {
        .portal-layout {
          grid-template-columns: 1fr;
          gap: 3rem;
        }

        .sticky-panel {
          position: static;
        }

        .portal-header h1 {
          font-size: 2.5rem;
        }

        .process-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 600px) {
        .portal-layout {
          margin: 2rem auto;
          padding: 0 1rem;
        }

        .portal-header h1 {
          font-size: 2rem;
        }

        .hero-cta {
          flex-direction: column;
        }

        .modal-content {
          padding: 1.75rem 1.25rem;
        }
      }
    </style>
  </slot>

  <div class="portal-layout">
    <!-- Main Left Column -->
    <main class="portal-main">
      <header class="portal-header">
        <div class="portal-badge">🩺 Clinical Excellence &amp; Rigor</div>
        <h1>Peer Review Board</h1>
        <p>iMedipedia upholds the highest standards of scientific and clinical rigor through structured, independent peer review by practicing physicians, academicians, and medical researchers.</p>
        
        <div class="hero-cta">
          <button id="joinReviewerBtn" class="btn">🩺 Join as Peer Reviewer</button>
          <a href="/reviewers/login" class="btn btn-secondary">🔑 Peer Reviewer Login &rarr;</a>
        </div>
      </header>

      <!-- Standards & Rigor Section -->
      <section class="process-section">
        <span class="section-subtitle-tag">Evaluation Framework</span>
        <h2 class="process-heading">Our Peer Review Standards</h2>
        <div class="process-grid">
          <div class="process-card">
            <span class="process-icon">🔬</span>
            <h3 class="process-title">1. Clinical Rigor</h3>
            <p class="process-desc">Manuscripts are evaluated for pathophysiological validity, evidence classification, diagnostic criteria, and pharmacological safety.</p>
          </div>
          <div class="process-card">
            <span class="process-icon">🛡️</span>
            <h3 class="process-title">2. Double-Grounded Rubric</h3>
            <p class="process-desc">Standardized scoring across Clinical Accuracy, Article Clarity, and Evidence Base with actionable feedback delivered to authors.</p>
          </div>
          <div class="process-card">
            <span class="process-icon">⚡</span>
            <h3 class="process-title">3. Collaborative Revisions</h3>
            <p class="process-desc">Authors receive structured reviewer recommendations to refine manuscripts before final publication to the medical community.</p>
          </div>
        </div>
      </section>

      <!-- Showcase Gallery Section -->
      <section class="gallery-section" id="reviewBoardSection">
        <div class="gallery-header">
          <div>
            <span class="section-subtitle-tag">Editorial Community</span>
            <h2 class="gallery-title">Distinguished Review Board</h2>
            <p style="color:var(--muted);margin:0.25rem 0 0 0;font-size:0.95rem;">Meet the clinicians and researchers reviewing our medical manuscripts.</p>
          </div>
        </div>

        <div class="gallery-grid" id="reviewersGrid">
          <p style="color:var(--muted);text-align:center;grid-column:1/-1;">Loading review board members...</p>
        </div>
      </section>
    </main>

    <!-- Right Navigation Panel -->
    <aside class="portal-sidebar">
      <div class="sticky-panel">
        <!-- Navigation Widget -->
        <div class="sidebar-widget">
          <h3 class="widget-title">
            <span>⚡</span> Reviewer Navigation
          </h3>
          <div class="sidebar-nav-list">
            <button id="sideJoinReviewerBtn" class="sidebar-action-btn primary" type="button">
              <span class="action-left">
                <span class="action-icon">🩺</span>
                <span class="action-text">
                  <strong>Join as Peer Reviewer</strong>
                  <small>Apply with clinical credentials</small>
                </span>
              </span>
              <span class="action-arrow">&rarr;</span>
            </button>

            <a href="/reviewers/login" class="sidebar-action-btn">
              <span class="action-left">
                <span class="action-icon">🔑</span>
                <span class="action-text">
                  <strong>Peer Reviewer Login</strong>
                  <small>Access review queue</small>
                </span>
              </span>
              <span class="action-arrow">&rarr;</span>
            </a>

            <a href="#reviewBoardSection" id="sideBoardLink" class="sidebar-action-btn">
              <span class="action-left">
                <span class="action-icon">👥</span>
                <span class="action-text">
                  <strong>Our Review Board</strong>
                  <small>Meet verified reviewers</small>
                </span>
              </span>
              <span class="action-arrow">&darr;</span>
            </a>
          </div>
        </div>

        <!-- Rigor & Accreditation Info -->
        <div class="sidebar-info-card">
          <div class="info-card-header">
            <h4 class="info-card-title">Review Board Rigor</h4>
            <span class="info-badge">Accredited</span>
          </div>
          <ul class="info-list">
            <li><span class="check">✔</span> Double-blind evaluation framework</li>
            <li><span class="check">✔</span> Standardized clinical rubrics</li>
            <li><span class="check">✔</span> Verified faculty &amp; MD reviewers</li>
            <li><span class="check">✔</span> Reviewer citation recognition</li>
          </ul>
        </div>
      </div>
    </aside>
  </div>

  <!-- Join Modal -->
  <div class="modal-overlay" id="reviewerModalOverlay">
    <div class="modal-content">
      <button class="modal-close" id="closeReviewerModal" aria-label="Close modal">&times;</button>
      <h2 style="font-family:'Outfit',sans-serif;font-size:1.75rem;margin-top:0;margin-bottom:0.5rem;">Join the Peer Review Board</h2>
      <p style="color:var(--muted);font-size:0.9rem;margin-bottom:1.5rem;line-height:1.5;">Apply to evaluate prospective medical articles, case presentations, and clinical review digests in your subspecialty.</p>
      
      <div class="alert alert-error" id="modalAlertError"></div>
      <div class="alert alert-success" id="modalAlertSuccess"></div>

      <form id="reviewerApplyForm">
        <div class="form-group">
          <label class="form-label" for="revName">Full Name &amp; Degrees *</label>
          <input type="text" id="revName" class="form-input" placeholder="e.g. Dr. Eleanor Vance, MD, PhD" required />
        </div>

        <div class="form-group">
          <label class="form-label" for="revEmail">Institutional / Medical Email *</label>
          <input type="email" id="revEmail" class="form-input" placeholder="e.g. dr.vance@hospital.org" required />
        </div>

        <div class="form-group">
          <label class="form-label" for="revAffiliation">Primary Academic / Hospital Affiliation *</label>
          <input type="text" id="revAffiliation" class="form-input" placeholder="e.g. Department of Cardiology, Johns Hopkins Medicine" required />
        </div>

        <div class="form-group">
          <label class="form-label" for="revSpecialties">Clinical Specialties / Subspecialties *</label>
          <input type="text" id="revSpecialties" class="form-input" placeholder="e.g. Cardiology, Electrophysiology, Heart Failure (comma separated)" required />
        </div>

        <div class="form-group">
          <label class="form-label" for="revQualifications">Qualifications, Board Certifications &amp; Experience *</label>
          <textarea id="revQualifications" class="form-textarea" placeholder="Please list your clinical training, board certifications, faculty appointments, or prior peer review experience..." required></textarea>
        </div>

        <div class="form-group">
          <label class="form-label" for="revOrcid">ORCID iD, PubMed or Academic Profile Link <span style="font-weight:400;text-transform:none;">(optional)</span></label>
          <input type="text" id="revOrcid" class="form-input" placeholder="https://orcid.org/0000-... or PubMed URL" />
        </div>

        <button type="submit" id="submitAppBtn" class="btn" style="width:100%;margin-top:1rem;">Submit Application for Review</button>
      </form>
    </div>
  </div>

  <script is:inline>
    // Modal management
    const overlay = document.getElementById('reviewerModalOverlay');
    const joinBtn = document.getElementById('joinReviewerBtn');
    const sideJoinBtn = document.getElementById('sideJoinReviewerBtn');
    const closeBtn = document.getElementById('closeReviewerModal');
    const form = document.getElementById('reviewerApplyForm');
    const submitBtn = document.getElementById('submitAppBtn');
    const alertErr = document.getElementById('modalAlertError');
    const alertSucc = document.getElementById('modalAlertSuccess');
    const sideBoardLink = document.getElementById('sideBoardLink');

    function openModal() {
      overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      overlay.classList.remove('active');
      document.body.style.overflow = '';
    }

    if (joinBtn) joinBtn.addEventListener('click', openModal);
    if (sideJoinBtn) sideJoinBtn.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (overlay) overlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });

    // Smooth scroll for Our Review Board link
    if (sideBoardLink) {
      sideBoardLink.addEventListener('click', (e) => {
        e.preventDefault();
        const target = document.getElementById('reviewBoardSection');
        if (target) {
          target.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }

    // Escape key listener
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay.classList.contains('active')) {
        closeModal();
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      alertErr.style.display = 'none';
      alertSucc.style.display = 'none';
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting application...';

      const payload = {
        name: document.getElementById('revName').value.trim(),
        email: document.getElementById('revEmail').value.trim(),
        title_affiliation: document.getElementById('revAffiliation').value.trim(),
        specialties: document.getElementById('revSpecialties').value.trim(),
        qualifications: document.getElementById('revQualifications').value.trim(),
        orcid_or_portfolio: document.getElementById('revOrcid').value.trim(),
      };

      try {
        const resp = await fetch('/api/reviewers/apply', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await resp.json();
        if (resp.ok && data.success) {
          form.reset();
          alertSucc.textContent = data.message || 'Application submitted successfully!';
          alertSucc.style.display = 'block';
          setTimeout(() => { closeModal(); alertSucc.style.display = 'none'; }, 3000);
        } else {
          alertErr.textContent = data.error || 'Submission failed. Please check your information.';
          alertErr.style.display = 'block';
        }
      } catch (err) {
        alertErr.textContent = 'Network error: ' + err.message;
        alertErr.style.display = 'block';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit Application for Review';
      }
    });

    // Load active reviewers gallery
    async function loadReviewers() {
      const grid = document.getElementById('reviewersGrid');
      try {
        const resp = await fetch('/api/reviewers/apply');
        const data = await resp.json();
        if (!data.reviewers || data.reviewers.length === 0) {
          grid.innerHTML = '<p style="color:var(--muted);text-align:center;grid-column:1/-1;">No reviewers listed yet. Apply to be the first!</p>';
          return;
        }

        grid.innerHTML = data.reviewers.map(r => {
          let aff = '';
          try {
            const affArr = JSON.parse(r.affiliation || '[]');
            aff = Array.isArray(affArr) ? affArr.join(', ') : r.affiliation;
          } catch { aff = r.affiliation || ''; }

          let specs = [];
          try {
            const specArr = JSON.parse(r.specialty || '[]');
            specs = Array.isArray(specArr) ? specArr : [r.specialty];
          } catch { specs = r.specialty ? [r.specialty] : []; }

          const avatar = r.avatar_url || 'https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&q=80&w=300';

          return `
            <div class="reviewer-card">
              <img src="${escapeHTML(avatar)}" class="reviewer-avatar" alt="${escapeHTML(r.full_name || r.username)}" />
              <h3 class="reviewer-name">${escapeHTML(r.full_name || r.username)}</h3>
              <div class="reviewer-affiliation">${escapeHTML(aff || 'iMedipedia Peer Review Board')}</div>
              <div class="reviewer-specialties">
                ${specs.map(s => `<span class="spec-badge">${escapeHTML(s)}</span>`).join('')}
              </div>
              <div class="reviewer-bio">${escapeHTML(r.bio || 'Medical peer reviewer specializing in clinical evidence evaluation and research methodology.')}</div>
            </div>
          `;
        }).join('');

      } catch (e) {
        grid.innerHTML = '<p style="color:var(--muted);text-align:center;grid-column:1/-1;">Could not load review board members.</p>';
      }
    }

    function escapeHTML(str) {
      if (!str) return '';
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    loadReviewers();
  </script>
</BaseLayout>
