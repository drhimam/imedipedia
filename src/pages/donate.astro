---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Donate & Support Our Mission - iMedipedia" description="Support iMedipedia's mission to provide open-access, peer-reviewed medical research, clinical summaries, and board review preparation. Keep healthcare education free and accessible globally.">
  <div class="donate-wrapper">
    <div class="donate-container">
      
      <!-- Left side: Impact and Info -->
      <div class="donate-info-section">
        <div class="badge">Support Open-Access Science</div>
        <h1>Support Our Mission</h1>
        <p class="lead-text">
          iMedipedia is a non-profit initiative dedicated to providing evidence-based medical digests, peer-reviewed summaries, and board review insights to practitioners and students worldwide.
        </p>
        
        <div class="impact-grid">
          <div class="impact-card">
            <div class="impact-icon-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <h3>100% Ad-Free</h3>
            <p>We do not run commercial advertisements or accept pharma sponsorship, ensuring unbiased medical summaries.</p>
          </div>

          <div class="impact-card">
            <div class="impact-icon-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
              </svg>
            </div>
            <h3>Peer-Reviewed Integrity</h3>
            <p>Every digest is vetted by our medical board to maintain the highest clinical standards of evidence.</p>
          </div>

          <div class="impact-card">
            <div class="impact-icon-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                <path d="M2 12h20"></path>
              </svg>
            </div>
            <h3>Global Accessibility</h3>
            <p>Keeping clinical guidelines and research updates open to doctors, nurses, and students in developing nations.</p>
          </div>
        </div>
      </div>

      <!-- Right side: Donation Card -->
      <div class="donate-card-section">
        <div class="donate-card">
          <div class="card-header">
            <div class="heart-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </div>
            <h2>Make a Contribution</h2>
            <p>Choose your donation through PayPal to support independent medical research education.</p>
          </div>

          <!-- Impact Indicators -->
          <div class="suggested-amounts">
            <div class="amount-option" data-amount="15">
              <span class="amount-value">$15</span>
              <span class="amount-desc">Supports 1 Day of Hosting</span>
            </div>
            <div class="amount-option" data-amount="50">
              <span class="amount-value">$50</span>
              <span class="amount-desc">Funds Peer Review of 1 Digest</span>
            </div>
            <div class="amount-option active" data-amount="150">
              <span class="amount-value">$150</span>
              <span class="amount-desc">Maintains Database for 1 Month</span>
            </div>
            <div class="amount-option" id="customAmountOption" data-amount="custom">
              <span class="amount-value">Custom</span>
              <span class="amount-desc">Enter any amount</span>
            </div>
          </div>

          <!-- Custom Amount Input Field -->
          <div class="custom-amount-container" id="customAmountInputContainer" style="display: none;">
            <label for="customAmountVal">Enter Amount ($)</label>
            <div class="custom-input-wrapper">
              <span class="currency-symbol">$</span>
              <input type="number" id="customAmountVal" placeholder="2.00" min="1" step="any" />
            </div>
          </div>

          <!-- Form Integration -->
          <div class="form-container" id="paypalFormContainer">
            <form action="https://www.paypal.com/donate" method="post" target="_top" id="paypalDonateForm">
              <input type="hidden" name="hosted_button_id" value="BWUKW8NA59L6N" />
              
              <!-- Custom Interactive Donate Button -->
              <button type="submit" class="btn-donate-custom" id="customDonateSubmitBtn">
                <span>Donate with PayPal</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </button>

              <div class="or-separator">
                <span>Or use standard PayPal button</span>
              </div>

              <!-- Required original form image submit button for fallback and compliance -->
              <div class="paypal-original-wrapper">
                <input type="image" src="https://www.paypalobjects.com/en_US/i/btn/btn_donateCC_LG.gif" border="0" name="submit" title="PayPal - The safer, easier way to pay online!" alt="Donate with PayPal button" id="paypalOriginalSubmitBtn" />
                <img alt="" border="0" src="https://www.paypal.com/en_CA/i/scr/pixel.gif" width="1" height="1" />
              </div>
            </form>
          </div>

          <div class="card-footer">
            <p>Secure transactions via PayPal. You do not need a PayPal account to complete a credit or debit card donation.</p>
          </div>
        </div>
      </div>

    </div>
  </div>

  <style>
    .donate-wrapper {
      min-height: 80vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 4rem 2rem;
      position: relative;
      overflow: hidden;
    }

    /* Multi-layered premium glow background */
    .donate-wrapper::before {
      content: '';
      position: absolute;
      width: 60vw;
      height: 60vw;
      background: radial-gradient(circle, var(--accent-glow) 0%, transparent 60%);
      top: 20%;
      left: 10%;
      border-radius: 50%;
      z-index: -1;
      filter: blur(40px);
      animation: drift 8s ease-in-out infinite alternate;
    }

    .donate-wrapper::after {
      content: '';
      position: absolute;
      width: 40vw;
      height: 40vw;
      background: radial-gradient(circle, rgba(14, 165, 233, 0.1) 0%, transparent 60%);
      bottom: 10%;
      right: 10%;
      border-radius: 50%;
      z-index: -1;
      filter: blur(40px);
      animation: drift 12s ease-in-out infinite alternate-reverse;
    }

    @keyframes drift {
      0% { transform: translate(0, 0) scale(0.9); }
      100% { transform: translate(5%, 5%) scale(1.1); }
    }

    .donate-container {
      max-width: 1100px;
      width: 100%;
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 4rem;
      align-items: center;
      animation: slideUp 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    @keyframes slideUp {
      from { opacity: 0; transform: translateY(24px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Left Column Styles */
    .donate-info-section {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
    }

    .badge {
      background: rgba(13, 148, 136, 0.1);
      color: #0d9488;
      padding: 0.4rem 1rem;
      border-radius: 9999px;
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 1.5rem;
    }

    .donate-info-section h1 {
      font-family: 'Outfit', sans-serif;
      font-size: 3rem;
      font-weight: 800;
      line-height: 1.15;
      margin: 0 0 1.5rem;
      background: linear-gradient(135deg, #0ea5e9, #0d9488);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .lead-text {
      font-size: 1.15rem;
      line-height: 1.6;
      color: var(--muted);
      margin-bottom: 2.5rem;
    }

    .impact-grid {
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
      width: 100%;
    }

    .impact-card {
      display: flex;
      gap: 1.25rem;
      align-items: flex-start;
    }

    .impact-icon-wrapper {
      background: rgba(13, 148, 136, 0.08);
      color: #0d9488;
      border-radius: 12px;
      padding: 0.75rem;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      border: 1px solid var(--border);
    }

    .impact-card h3 {
      font-family: 'Outfit', sans-serif;
      font-size: 1.15rem;
      font-weight: 700;
      margin: 0 0 0.25rem;
      color: var(--text);
    }

    .impact-card p {
      font-size: 0.95rem;
      line-height: 1.5;
      color: var(--muted);
      margin: 0;
    }

    /* Right Column Styles (Glassmorphism Card) */
    .donate-card-section {
      display: flex;
      justify-content: center;
      width: 100%;
    }

    .donate-card {
      background: var(--card-bg);
      backdrop-filter: blur(20px);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 3rem 2.5rem;
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.2);
      width: 100%;
      max-width: 460px;
      display: flex;
      flex-direction: column;
      gap: 2rem;
      position: relative;
    }

    .card-header {
      text-align: center;
    }

    .heart-icon {
      width: 68px;
      height: 68px;
      margin: 0 auto 1.25rem;
      background: rgba(239, 68, 68, 0.1);
      color: #ef4444;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      animation: heartbeat 2s infinite ease-in-out;
    }

    @keyframes heartbeat {
      0%, 100% { transform: scale(1); }
      25% { transform: scale(1.08); }
      40% { transform: scale(1.02); }
      60% { transform: scale(1.06); }
    }

    .card-header h2 {
      font-family: 'Outfit', sans-serif;
      font-size: 1.75rem;
      font-weight: 700;
      margin: 0 0 0.5rem;
      color: var(--text);
    }

    .card-header p {
      font-size: 0.95rem;
      color: var(--muted);
      line-height: 1.5;
      margin: 0;
    }

    /* Suggested Amounts (interactive selection) */
    .suggested-amounts {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .amount-option {
      background: rgba(0, 0, 0, 0.03);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 0.85rem 1.25rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      transition: all 0.25s ease;
    }

    :global([data-theme="dark"]) .amount-option {
      background: rgba(255, 255, 255, 0.02);
    }

    .amount-option:hover {
      border-color: var(--accent);
      background: rgba(13, 148, 136, 0.04);
      transform: translateY(-1px);
    }

    .amount-option.active {
      border-color: var(--accent);
      background: rgba(13, 148, 136, 0.08);
      box-shadow: 0 0 0 3px var(--accent-glow);
    }

    .amount-value {
      font-family: 'Outfit', sans-serif;
      font-weight: 700;
      font-size: 1.25rem;
      color: var(--text);
    }

    .amount-desc {
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .amount-option.active .amount-value {
      color: #0d9488;
    }

    /* Button and Form Styles */
    .form-container {
      width: 100%;
    }

    #paypalDonateForm {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      align-items: center;
    }

    .btn-donate-custom {
      width: 100%;
      background: linear-gradient(135deg, #0ea5e9, #0d9488);
      color: white;
      border: none;
      padding: 1.1rem;
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 700;
      font-size: 1.05rem;
      border-radius: 14px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
      box-shadow: 0 10px 20px rgba(13, 148, 136, 0.2);
    }

    .btn-donate-custom:hover {
      transform: translateY(-2px);
      box-shadow: 0 15px 30px rgba(13, 148, 136, 0.35);
      background: linear-gradient(135deg, #0284c7, #0f766e);
    }

    .btn-donate-custom svg {
      transition: transform 0.2s ease;
    }

    .btn-donate-custom:hover svg {
      transform: translateX(4px);
    }

    .or-separator {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin: 0.5rem 0;
    }

    .or-separator::before,
    .or-separator::after {
      content: '';
      flex-grow: 1;
      height: 1px;
      background: var(--border);
    }

    .or-separator::before {
      margin-right: 1rem;
    }
    
    .or-separator::after {
      margin-left: 1rem;
    }

    .paypal-original-wrapper {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
      padding: 0.25rem 0;
      transition: transform 0.2s ease;
    }

    .paypal-original-wrapper:hover {
      transform: scale(1.03);
    }

    .card-footer {
      text-align: center;
    }

    .card-footer p {
      font-size: 0.75rem;
      color: var(--muted);
      line-height: 1.5;
      margin: 0;
    }

    /* Responsive adjustments */
    @media (max-width: 900px) {
      .donate-container {
        grid-template-columns: 1fr;
        gap: 3rem;
      }

      .donate-info-section {
        align-items: center;
        text-align: center;
      }

      .donate-info-section h1 {
        font-size: 2.5rem;
      }

      .lead-text {
        margin-bottom: 2rem;
      }

      .impact-grid {
        max-width: 600px;
        margin: 0 auto;
      }

      .impact-card {
        text-align: left;
      }

      .donate-card {
        max-width: 100%;
      }
    }

    @media (max-width: 480px) {
      .donate-wrapper {
        padding: 2.5rem 1.25rem;
      }

      .donate-card {
        padding: 2rem 1.5rem;
      }

      .donate-info-section h1 {
        font-size: 2.2rem;
      }
    }

    .custom-amount-container {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      text-align: left;
      animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-5px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .custom-amount-container label {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .custom-input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }

    .custom-input-wrapper .currency-symbol {
      position: absolute;
      left: 1.25rem;
      font-family: 'Outfit', sans-serif;
      font-weight: 700;
      font-size: 1.2rem;
      color: var(--text);
    }

    .custom-input-wrapper input {
      width: 100%;
      padding: 0.85rem 1rem 0.85rem 2.25rem;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: rgba(0,0,0,0.03);
      color: var(--text);
      font-size: 1.1rem;
      font-family: inherit;
      font-weight: 600;
      outline: none;
      box-sizing: border-box;
      transition: all 0.2s ease;
    }

    :global([data-theme="dark"]) .custom-input-wrapper input {
      background: rgba(255,255,255,0.02);
    }

    .custom-input-wrapper input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-glow);
    }
  </style>

  <!-- Interactive script to select suggested amounts -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const options = document.querySelectorAll('.amount-option');
      const form = document.getElementById('paypalDonateForm');
      
      if (form) {
        // Inject dynamic notify_url parameter for PayPal IPN webhook
        const notifyInput = document.createElement('input');
        notifyInput.type = 'hidden';
        notifyInput.name = 'notify_url';
        notifyInput.value = `${window.location.origin}/api/donate/ipn`;
        form.appendChild(notifyInput);

        // Inject dynamic amount parameter
        const amountInput = document.createElement('input');
        amountInput.type = 'hidden';
        amountInput.name = 'amount';
        form.appendChild(amountInput);

        const customInputContainer = document.getElementById('customAmountInputContainer');
        const customAmountVal = document.getElementById('customAmountVal');

        // Function to update the form's amount field
        const updateAmount = () => {
          const activeOption = document.querySelector('.amount-option.active');
          if (activeOption) {
            const amtType = activeOption.getAttribute('data-amount');
            if (amtType === 'custom') {
              if (customInputContainer) customInputContainer.style.display = 'flex';
              if (customAmountVal) {
                // Parse value or default to $2.00
                const rawVal = parseFloat(customAmountVal.value || '2');
                amountInput.value = isNaN(rawVal) ? '2.00' : rawVal.toFixed(2);
              }
            } else {
              if (customInputContainer) customInputContainer.style.display = 'none';
              amountInput.value = activeOption.getAttribute('data-amount');
            }
          }
        };

        // Set initial amount value
        updateAmount();

        // Listen for option selections
        options.forEach(opt => {
          opt.addEventListener('click', () => {
            options.forEach(o => o.classList.remove('active'));
            opt.classList.add('active');
            updateAmount();
          });
        });

        // Listen for typing changes on the custom amount input
        if (customAmountVal) {
          customAmountVal.addEventListener('input', () => {
            updateAmount();
          });
        }
      } else {
        // Fallback option switching if form isn't rendered
        options.forEach(opt => {
          opt.addEventListener('click', () => {
            options.forEach(o => o.classList.remove('active'));
            opt.classList.add('active');
          });
        });
      }
    });
  </script>
</BaseLayout>
