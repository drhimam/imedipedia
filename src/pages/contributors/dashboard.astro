---
import BaseLayout from '../../layouts/BaseLayout.astro';
import subjects from '../../data/subjects.json';
import exams from '../../data/exams.json';
---

<BaseLayout
  title="Contributor Dashboard - iMedipedia"
  currentPage="contributors"
>
  <slot name="head">
    <script src="/marked.min.js" is:inline></script>
    <style>
      .dashboard-container { max-width: 1200px; width: 100%; margin: 2rem auto; padding: 0 1.5rem; box-sizing: border-box; display: grid; grid-template-columns: 280px 1fr; gap: 2.5rem; flex-grow: 1; }
      .sidebar { display: flex; flex-direction: column; gap: 1.5rem; }
      .user-profile-summary { background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; padding: 1.5rem; text-align: center; }
      .avatar { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent); margin-bottom: 1rem; }
      .profile-name { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 1.1rem; margin: 0 0 0.25rem 0; }
      .profile-role { font-size: 0.75rem; color: var(--accent); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
      .tab-menu { background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem; }
      .tab-btn { background: transparent; border: none; color: var(--text); text-align: left; padding: 0.75rem 1rem; border-radius: 8px; cursor: pointer; font-size: 0.95rem; font-weight: 600; display: flex; align-items: center; gap: 0.75rem; transition: all 0.2s ease; font-family: inherit; }
      .tab-btn:hover { background: rgba(99, 102, 241, 0.08); color: var(--accent); } .tab-btn:active { transform: scale(0.98); }
      .tab-btn.active { background: var(--accent); color: #ffffff; }
      .main-content { background: var(--card-bg); border: 1px solid var(--border); border-radius: 20px; padding: 2.5rem; box-shadow: 0 4px 30px rgba(0, 0, 0, 0.03); min-height: 500px; }
      .tab-panel { display: none; }
      .tab-panel.active { display: block; animation: fadeIn2 0.3s ease-out; }
      @keyframes fadeIn2 { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
      .panel-title { font-family: 'Outfit', sans-serif; font-size: 2rem; font-weight: 800; margin-top: 0; margin-bottom: 0.5rem; letter-spacing: -0.5px; }
      .panel-desc { color: var(--muted); font-size: 0.95rem; margin-bottom: 2rem; }
      .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 2.5rem; }
      .stat-card { background: rgba(0, 0, 0, 0.15); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; text-align: center; }
      :global([data-theme="light"]) .stat-card { background: rgba(255, 255, 255, 0.5); }
      .stat-val { font-family: 'Outfit', sans-serif; font-size: 2.5rem; font-weight: 800; color: var(--accent); line-height: 1; margin-bottom: 0.5rem; }
      .stat-label { font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--muted); letter-spacing: 0.5px; }
      .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
      .form-group { margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem; }
      .form-group.full-width { grid-column: 1 / -1; }
      .form-label { font-size: 0.85rem; font-weight: 600; text-transform: uppercase; color: var(--muted); letter-spacing: 0.5px; }
      .form-hint { font-size: 0.75rem; color: var(--muted); margin-top: -0.25rem; }
      .form-input, .form-select { padding: 0.8rem 1rem; border-radius: 8px; border: 1px solid var(--border); background: rgba(0, 0, 0, 0.15); color: var(--text); font-size: 0.95rem; transition: border-color 0.2s, background-color 0.2s; box-sizing: border-box; width: 100%; }
      :global([data-theme="light"]) .form-input, :global([data-theme="light"]) .form-select { background: rgba(255, 255, 255, 0.8); }
      .form-input:focus, .form-select:focus { outline: none; border-color: var(--accent); background: rgba(0, 0, 0, 0.25); }
      :global([data-theme="light"]) .form-input:focus, :global([data-theme="light"]) .form-select:focus { background: #ffffff; }
      .form-input:read-only, .form-input[readonly] { opacity: 0.7; cursor: not-allowed; background: rgba(0, 0, 0, 0.05); }
      :global([data-theme="light"]) .form-input:read-only { background: rgba(0, 0, 0, 0.03); }
      .form-select { cursor: pointer; }
      .upload-zone { border: 2px dashed var(--border); border-radius: 12px; padding: 2rem; text-align: center; background: rgba(0, 0, 0, 0.1); cursor: pointer; transition: all 0.2s ease; position: relative; }
      .upload-zone.dragover { border-color: var(--accent); background: var(--accent-glow); }
      .upload-zone.compact { padding: 1rem; }
      .upload-icon { font-size: 1.5rem; margin-bottom: 0.5rem; color: var(--muted); display: block; }
      .upload-label { font-weight: 600; font-size: 0.9rem; margin-bottom: 0.25rem; }
      .upload-sublabel { font-size: 0.75rem; color: var(--muted); }
      .image-upload-row { display: flex; gap: 1rem; align-items: flex-start; flex-wrap: wrap; }
      .image-upload-row .upload-zone { flex: 1; min-width: 200px; }
      .image-upload-fields { flex: 2; min-width: 250px; }
      .image-slot { border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; margin-bottom: 1rem; background: rgba(0, 0, 0, 0.05); }
      :global([data-theme="light"]) .image-slot { background: rgba(0, 0, 0, 0.02); }
      .image-slot-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; }
      .image-slot-title { font-weight: 700; font-size: 0.9rem; }
      .image-slot-remove { background: transparent; border: 1px solid rgba(239,68,68,0.3); color: #ef4444; padding: 0.25rem 0.75rem; border-radius: 6px; cursor: pointer; font-size: 0.8rem; }
      .image-slot-add { background: transparent; cursor: pointer; font-family: inherit; border: 1px dashed var(--border); color: var(--accent); padding: 0.75rem; border-radius: 8px; cursor: pointer; font-size: 0.9rem; width: 100%; text-align: center; margin-top: 0.5rem; }
      .image-preview-container { display: none; flex-direction: column; align-items: center; position: relative; margin-top: 0.75rem; }
      .image-preview { max-width: 100%; max-height: 150px; border-radius: 8px; border: 1px solid var(--border); object-fit: cover; }
      .clear-img-btn { position: absolute; top: 0.25rem; right: 0.25rem; background: rgba(3, 7, 18, 0.8); border: none; color: white; border-radius: 50%; width: 26px; height: 26px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; font-weight: bold; }
      .progress-container { display: none; width: 100%; background-color: var(--border); border-radius: 4px; margin-top: 0.75rem; height: 5px; overflow: hidden; }
      .progress-bar { width: 0%; height: 100%; background-color: var(--accent); transition: width 0.1s ease; }
      .btn { background: var(--accent); color: #ffffff; border: none; padding: 0.85rem 1.75rem; font-size: 0.95rem; font-weight: 700; border-radius: 8px; cursor: pointer; transition: all 0.2s ease; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; }
      .btn:hover { transform: translateY(-2px); box-shadow: 0 4px 12px var(--accent-glow); }
      .btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
      .btn-secondary { background: transparent; border: 1px solid var(--border); color: var(--text); }
      .btn-secondary:hover { background: rgba(99, 102, 241, 0.08); }
      .btn-logout { background: transparent; border: 1px solid rgba(239,68,68,0.3); color: #ef4444; font-size: 0.85rem; padding: 0.5rem 1rem; cursor: pointer; font-family: inherit; }
      .btn-logout:hover { background: rgba(239,68,68,0.1); }
      .table-container { overflow-x: auto; border-radius: 12px; border: 1px solid var(--border); }
      .submissions-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.95rem; }
      .submissions-table th { background: rgba(0, 0, 0, 0.2); padding: 1rem 1.25rem; font-weight: 700; color: var(--muted); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.5px; border-bottom: 1px solid var(--border); }
      :global([data-theme="light"]) .submissions-table th { background: rgba(0, 0, 0, 0.02); }
      .submissions-table td { padding: 1.25rem; border-bottom: 1px solid var(--border); }
      .submissions-table tr:last-child td { border-bottom: none; }
      .badge { display: inline-block; padding: 0.25rem 0.65rem; border-radius: 12px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; }
      .badge-pending { background: rgba(245,158,11,0.15); color: #f59e0b; }
      .badge-approved { background: rgba(59,130,246,0.15); color: #3b82f6; }
      .badge-rejected { background: rgba(239,68,68,0.15); color: #ef4444; }
      .badge-published { background: rgba(16,185,129,0.15); color: #10b981; }
      .action-btn-sm { background: transparent; border: 1px solid var(--border); border-radius: 6px; padding: 0.3rem 0.45rem; cursor: pointer; font-size: 0.85rem; margin-right: 0.15rem; transition: all 0.15s; }
      .action-btn-sm:hover { background: rgba(99,102,241,0.1); border-color: var(--accent); }
      .btn-del-sm:hover { background: rgba(239,68,68,0.1); border-color: #ef4444; }
      .btn-del-disabled { opacity: 0.35; cursor: not-allowed; background: transparent; border: 1px solid var(--border); border-radius: 6px; padding: 0.3rem 0.45rem; font-size: 0.85rem; margin-right: 0.15rem; }
      .btn-edit-sm:hover { background: rgba(59,130,246,0.1); border-color: #3b82f6; }
      .btn-view:hover { background: rgba(16,185,129,0.1); border-color: #10b981; }
      /* View Article Modal */
      .view-modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 998; display: flex; align-items: center; justify-content: center; animation: modalFadeIn 0.2s ease-out; }
      .view-modal { background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; padding: 2rem; max-width: 700px; width: 90%; max-height: 85vh; overflow-y: auto; animation: modalPopIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
      .view-modal h2 { font-family: 'Outfit', sans-serif; font-size: 1.4rem; font-weight: 700; margin: 0 0 0.75rem 0; }
      .view-modal-meta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem; font-size: 0.85rem; color: var(--muted); }
      .view-modal-body { background: rgba(0,0,0,0.05); border: 1px solid var(--border); border-radius: 8px; padding: 1.25rem; font-size: 0.95rem; line-height: 1.7; white-space: pre-wrap; word-break: break-word; max-height: 400px; overflow-y: auto; font-family: inherit; }
      :global([data-theme="light"]) .view-modal-body { background: rgba(0,0,0,0.02); }
      .view-modal-close { position: absolute; top: 1rem; right: 1rem; background: transparent; border: none; color: var(--muted); font-size: 1.3rem; cursor: pointer; width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; }
      .view-modal-close:hover { background: rgba(239,68,68,0.1); color: #ef4444; }
      .view-modal-header { position: relative; }
      /* Edit warning banner */
      .edit-warning { background: rgba(251,191,36,0.1); border: 1px solid rgba(251,191,36,0.3); border-radius: 8px; padding: 0.75rem 1rem; color: #f59e0b; font-size: 0.85rem; font-weight: 600; margin-bottom: 1rem; display: none; }
      .alert { display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.25rem; border-radius: 8px; margin-bottom: 1.5rem; font-size: 0.95rem; font-weight: 500; border: 1px solid; animation: scaleIn3 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
      .alert-success { background: var(--success-glow); color: var(--success); border-color: rgba(16, 185, 129, 0.2); }
      .alert-error { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #ef4444; }
      @keyframes scaleIn3 { from { transform: scale(0); opacity: 0; } to { transform: scale(1); opacity: 1; } }
      /* Popup Modal */
      .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 999; display: flex; align-items: center; justify-content: center; animation: modalFadeIn 0.2s ease-out; }
      @keyframes modalFadeIn { from { opacity: 0; } to { opacity: 1; } }
      .modal-dialog { background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; padding: 2rem; max-width: 440px; width: 90%; text-align: center; animation: modalPopIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
      @keyframes modalPopIn { from { transform: scale(0.85); opacity: 0; } to { transform: scale(1); opacity: 1; } }
      .modal-icon { font-size: 3rem; margin-bottom: 0.75rem; }
      .modal-title { font-family: 'Outfit', sans-serif; font-size: 1.3rem; font-weight: 700; margin: 0 0 0.5rem 0; }
      .modal-message { color: var(--muted); font-size: 0.95rem; line-height: 1.5; margin: 0 0 1.5rem 0; }
      .modal-close-btn { background: var(--accent); color: #fff; border: none; padding: 0.7rem 2.5rem; font-size: 0.95rem; font-weight: 700; border-radius: 8px; cursor: pointer; transition: all 0.15s; font-family: inherit; }
      .modal-close-btn:hover { opacity: 0.9; transform: translateY(-1px); }
      .empty-state { text-align: center; padding: 2rem; color: var(--muted); }
      .image-guide { background: rgba(59,130,246,0.08); border: 1px solid rgba(59,130,246,0.2); border-radius: 10px; padding: 1.25rem; font-size: 0.85rem; line-height: 1.6; color: var(--muted); margin-top: 2rem; }
      .image-guide strong { color: var(--accent); }
      .image-guide code { background: rgba(0,0,0,0.1); padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.85em; }
      /* Subject Autocomplete */
      .subject-autocomplete-wrapper { position: relative; }
      .subject-dropdown { position: absolute; top: 100%; left: 0; right: 0; background: var(--card-bg); border: 1px solid var(--border); border-radius: 8px; max-height: 280px; overflow-y: auto; z-index: 10; box-shadow: 0 8px 24px rgba(0,0,0,0.2); margin-top: 4px; }
      .subject-option { padding: 0.65rem 1rem; cursor: pointer; font-size: 0.9rem; display: flex; justify-content: space-between; align-items: center; transition: background 0.15s; border-bottom: 1px solid rgba(255,255,255,0.03); }
      .subject-option:last-child { border-bottom: none; }
      .subject-option:hover, .subject-option.active { background: rgba(99,102,241,0.12); color: var(--accent); }
      .subject-option .subject-parent { font-size: 0.7rem; color: var(--muted); background: rgba(255,255,255,0.05); padding: 0.15rem 0.5rem; border-radius: 10px; }
      .subject-option .highlight { color: var(--accent); font-weight: 700; }
      .subject-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.5rem; min-height: 0; }
      .subj-chip { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.35rem 0.6rem; background: var(--accent); color: #fff; border-radius: 20px; font-size: 0.8rem; font-weight: 500; animation: chipIn 0.2s ease-out; }
      @keyframes chipIn { from { transform: scale(0.8); opacity: 0; } to { transform: scale(1); opacity: 1; } }
      .subj-chip-remove { background: transparent; border: none; color: rgba(255,255,255,0.8); cursor: pointer; font-size: 0.9rem; line-height: 1; padding: 0; width: 16px; height: 16px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
      .subj-chip-remove:hover { color: #fff; background: rgba(255,255,255,0.2); }
      .no-subjects-match { padding: 1rem; text-align: center; color: var(--muted); font-size: 0.85rem; }
      /* Settings Section & Multi-value Chips */
      .settings-section { background: rgba(0, 0, 0, 0.08); border: 1px solid var(--border); border-radius: 14px; padding: 1.75rem; }
      :global([data-theme="light"]) .settings-section { background: rgba(0, 0, 0, 0.02); }
      .settings-section-title { font-family: 'Outfit', sans-serif; font-size: 1.25rem; font-weight: 700; margin: 0 0 1.25rem 0; color: var(--text); border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; }
      .chip-container { display: flex; flex-wrap: wrap; gap: 0.5rem; min-height: 0; margin-bottom: 0.4rem; }
      .chip { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.65rem; background: var(--accent); color: #fff; border-radius: 20px; font-size: 0.82rem; font-weight: 500; animation: chipIn 0.2s ease-out; }
      .chip-remove { background: transparent; border: none; color: rgba(255, 255, 255, 0.85); cursor: pointer; font-size: 1rem; line-height: 1; padding: 0; width: 16px; height: 16px; border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: all 0.15s; }
      .chip-remove:hover { color: #fff; background: rgba(255, 255, 255, 0.25); }
      .chip-input-row { display: flex; gap: 0.5rem; }
      .chip-input { flex: 1; min-width: 0; }
      .chip-add-btn { padding: 0.6rem 0.9rem; border-radius: 8px; border: 1px dashed var(--border); background: transparent; color: var(--accent); cursor: pointer; font-size: 0.85rem; font-weight: 600; white-space: nowrap; transition: all 0.15s; font-family: inherit; }
      .chip-add-btn:hover { background: var(--accent); color: #fff; border-color: var(--accent); }
      @media (max-width: 768px) {
        .dashboard-container { grid-template-columns: 1fr; gap: 1.5rem; }
        .form-grid { grid-template-columns: 1fr; gap: 1rem; }
      }
      @media (max-width: 600px) {
        .main-content { padding: 1.5rem; }
        .stats-grid { grid-template-columns: 1fr; gap: 1rem; }
        .image-upload-row { flex-direction: column; }
      }
      @media (max-width: 480px) {
        .main-content { padding: 1rem; }
        .panel-title { font-size: 1.5rem; }
        .tab-btn { padding: 0.6rem 0.75rem; font-size: 0.9rem; }
        .dashboard-container { margin: 1rem auto; padding: 0 0.75rem; }
      }
    </style>
  </slot>

  <div class="dashboard-container">
    <aside class="sidebar">
      <div class="user-profile-summary">
        <div class="avatar" style="background:var(--accent);display:flex;align-items:center;justify-content:center;font-size:2rem;margin:0 auto 1rem auto;overflow:hidden;" id="avatarContainer">
          <span id="avatarInitial">C</span>
          <img id="sideAvatarImg" src="" alt="Avatar" style="width:100%;height:100%;object-fit:cover;display:none;" />
        </div>
        <h3 id="sideName" class="profile-name">Contributor</h3>
        <span class="profile-role" id="sideRole">Contributor</span>
      </div>
      <div class="tab-menu">
        <button class="tab-btn active" data-tab="overview">📊 Overview</button>
        <button class="tab-btn" data-tab="submit" id="submitTabBtn">✍️ Submit Article</button>
        <button class="tab-btn" data-tab="submissions" id="submissionsTabBtn">🗂️ My Submissions</button>
        <button class="tab-btn" data-tab="reviews" id="reviewsTabBtn" style="display:none;">🩺 Assigned Reviews</button>
        <button class="tab-btn" data-tab="settings" id="settingsTabBtn">⚙️ Settings</button>
      </div>
      <button class="btn-logout" onclick="sessionStorage.clear();window.location.href='/contributors';" style="width:100%;">Logout</button>
    </aside>

    <main class="main-content">
      <div id="alertBox" style="display: none;"></div>

      <!-- Popup Modal -->
      <div class="modal-overlay" id="modalOverlay" style="display:none;">
        <div class="modal-dialog" id="modalDialog">
          <div class="modal-icon" id="modalIcon"></div>
          <h3 class="modal-title" id="modalTitle"></h3>
          <p class="modal-message" id="modalMessage"></p>
          <button class="modal-close-btn" onclick="closeModal()">OK</button>
        </div>
      </div>

      <!-- Overview Panel -->
      <div id="overviewPanel" class="tab-panel active">
        <h2 class="panel-title">Dashboard Overview</h2>
        <p class="panel-desc">Welcome back to your clinical publishing hub. Submit new articles and track review status here.</p>
        <div class="stats-grid">
          <div class="stat-card"><div class="stat-val" id="statTotal">—</div><div class="stat-label">Total Submissions</div></div>
          <div class="stat-card"><div class="stat-val" id="statPending">—</div><div class="stat-label">Pending Review</div></div>
          <div class="stat-card"><div class="stat-val" id="statPublished">—</div><div class="stat-label">Published</div></div>
        </div>
        <div style="background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem;">
          <h3 style="font-family: 'Outfit', sans-serif; margin-top: 0; margin-bottom: 0.5rem;">Editorial Guidelines</h3>
          <p style="margin: 0; color: var(--muted); font-size: 0.95rem; line-height: 1.5;">All submissions undergo editorial review before publication. Ensure your article follows the content type guidelines, and include proper markdown formatting for headings, lists, and medical terminology.</p>
        </div>
      </div>

      <!-- Submit Panel -->
      <div id="submitPanel" class="tab-panel">
        <h2 class="panel-title">Submit Research Article</h2>
        <p class="panel-desc">Fill in all required fields. Articles are reviewed by the editorial board before publication.</p>
        <form id="articleForm" class="form-grid">
          <div class="form-group full-width"><label for="artTitle" class="form-label">Article Title *</label><input type="text" id="artTitle" class="form-input" placeholder="e.g., Efficacy of RNA Therapeutics on Glioblastoma Reoccurrence" required maxlength="500" /></div>
          <div class="form-group"><label for="artAuthor" class="form-label">Author Name (auto-filled)</label><input type="text" id="artAuthor" class="form-input" readonly /></div>
          <div class="form-group"><label for="artType" class="form-label">Content Type *</label>
            <select id="artType" class="form-select" required>
              <option value="general">Clinical Digest</option>
              <option value="update">Clinical Guidelines</option>
              <option value="case">Case Reports</option>
              <option value="education">Board Review</option>
            </select>
          </div>
          <div class="form-group full-width">
            <label for="subjectSearch" class="form-label">Subjects *</label>
            <div class="subject-autocomplete-wrapper">
              <input type="text" id="subjectSearch" class="form-input" placeholder="Search subjects (e.g., 'phy' → Physiology, Physics)..." autocomplete="off" />
              <div class="subject-dropdown" id="subjectDropdown" style="display:none;"></div>
            </div>
            <div class="subject-chips" id="subjectChips"></div>
            <span class="form-hint">Select one or more subjects from the managed taxonomy</span>
          </div>
          <div class="form-group"><label for="artTopic" class="form-label">Topic *</label><input type="text" id="artTopic" class="form-input" placeholder="e.g., Cancer Vaccines" required maxlength="200" /></div>
          <div class="form-group full-width"><label for="artDesc" class="form-label">Short Description / Abstract Summary <span style="font-weight:400;text-transform:none;font-size:0.8rem;">(optional)</span></label><input type="text" id="artDesc" class="form-input" placeholder="A concise summary of the article..." maxlength="1000" /></div>
          <div class="form-group full-width">
            <label for="examSearch" class="form-label">Relevant Exams <span style="font-weight:400;text-transform:none;font-size:0.8rem;">(optional)</span></label>
            <div class="subject-autocomplete-wrapper">
              <input type="text" id="examSearch" class="form-input" placeholder="Search exams (e.g., 'usmle' → USMLE Step 1, 2 CK...)" autocomplete="off" />
              <div class="subject-dropdown" id="examDropdown" style="display:none;"></div>
            </div>
            <div class="subject-chips" id="examChips"></div>
            <span class="form-hint">Select one or more relevant exams from the managed list</span>
          </div>

          <!-- Cover Image Upload & Direct URL -->
          <div class="form-group full-width">
            <label class="form-label">Article Cover Image <span style="font-weight:400;text-transform:none;font-size:0.8rem;">(Upload file up to 1MB or paste image URL)</span></label>
            <div class="image-upload-row">
              <div id="coverDropZone" class="upload-zone compact" style="flex: 1; min-width: 200px;">
                <span class="upload-icon">🖼️</span>
