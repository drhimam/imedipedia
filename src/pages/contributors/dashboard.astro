            <div style="text-align:center;margin-bottom:1.5rem;">
              <div style="display:inline-flex;align-items:center;gap:0.5rem;background:rgba(99,102,241,0.15);color:var(--accent);padding:0.3rem 0.85rem;border-radius:20px;font-size:0.8rem;font-weight:700;margin-bottom:0.6rem;text-transform:uppercase;letter-spacing:0.5px;">
