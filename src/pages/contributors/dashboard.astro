  <slot name="scripts">
    <script define:vars={{ subjects: subjects, exams: exams }}>
      // Subject + exam taxonomies embedded at build time (zero D1 reads)
      window.SUBJECTS = subjects;
      window.EXAMS = exams;
    </script>
    <script is:inline>
      // --- Auth Gate ---
      var userData = sessionStorage.getItem('user');
      if (!userData) { window.location.href = '/contributors'; }
      var user;
      try { user = JSON.parse(userData); } catch(e) { window.location.href = '/contributors'; }
      if (!user) { window.location.href = '/contributors'; }

      // Check force password change
      if (user.force_password_change) {
        showAlert('You must change your password before continuing.', 'error');
        setTimeout(function() {
          var settingsBtn = document.getElementById('settingsTabBtn');
          if (settingsBtn) settingsBtn.click();
        }, 300);
      }

      // Check if user is a reviewer — redirect to dedicated Reviewer Dashboard
      if (user.role === 'reviewer') {
        window.location.href = '/reviewers/dashboard';
      }

      function updateSidebarAvatar(avatarUrl, name) {
        var initial = (name || 'Contributor').charAt(0).toUpperCase();
        var initialEl = document.getElementById('avatarInitial');
        var sideAvatarImg = document.getElementById('sideAvatarImg');
        var avatarContainer = document.getElementById('avatarContainer');

        if (avatarUrl && avatarUrl.trim()) {
          if (sideAvatarImg) {
            sideAvatarImg.src = avatarUrl.trim();
            sideAvatarImg.style.display = 'block';
            sideAvatarImg.onerror = function() {
              sideAvatarImg.style.display = 'none';
              if (initialEl) initialEl.style.display = 'flex';
            };
          }
          if (initialEl) initialEl.style.display = 'none';
          if (avatarContainer) avatarContainer.style.background = 'transparent';
        } else {
          if (sideAvatarImg) sideAvatarImg.style.display = 'none';
          if (initialEl) {
            initialEl.textContent = initial;
            initialEl.style.display = 'flex';
          }
          if (avatarContainer) avatarContainer.style.background = 'var(--accent)';
        }
      }

      function applyUserRoleUI(currentUser) {
        if (currentUser.role === 'reviewer') {
          window.location.href = '/reviewers/dashboard';
          return;
        }
        var isAdm = currentUser.role === 'admin' || currentUser.role === 'co-admin';

        // Update sidebar profile
        document.getElementById('sideName').textContent = currentUser.full_name || currentUser.username;
        document.getElementById('sideRole').textContent = currentUser.role || 'Contributor';
        updateSidebarAvatar(currentUser.avatar_url, currentUser.full_name || currentUser.username);

        var reviewsTabBtn = document.getElementById('reviewsTabBtn');
        var submitTabBtn = document.getElementById('submitTabBtn');
        var submissionsTabBtn = document.getElementById('submissionsTabBtn');

        if (isAdm) {
          // Admins can see all tabs
          if (submitTabBtn) submitTabBtn.style.display = 'block';
          if (submissionsTabBtn) submissionsTabBtn.style.display = 'block';
          if (reviewsTabBtn) reviewsTabBtn.style.display = 'block';
        } else {
          // Regular contributor
          if (submitTabBtn) submitTabBtn.style.display = 'block';
          if (submissionsTabBtn) submissionsTabBtn.style.display = 'block';
          if (reviewsTabBtn) reviewsTabBtn.style.display = 'none';
        }
      }

      // Initial apply with cached user
      applyUserRoleUI(user);

      // Verify and sync live role from backend
      fetch('/api/profile/get').then(function(r){ return r.json(); }).then(function(d){
        if (d.profile && d.profile.role) {
          user.role = d.profile.role;
          user.full_name = d.profile.full_name;
          sessionStorage.setItem('user', JSON.stringify(user));
          applyUserRoleUI(user);
        }
      }).catch(function(err){ console.warn('Profile sync warning:', err); });

      // Auto-fill author name from user profile
      document.getElementById('artAuthor').value = user.full_name || user.username || '';

      // --- Tabs ---
      var tabBtns = document.querySelectorAll('.tab-btn');
      var tabPanels = document.querySelectorAll('.tab-panel');
      tabBtns.forEach(function(btn) {
        btn.addEventListener('click', function(e) { var tab = btn.getAttribute('data-tab'); if (!tab) return; e.preventDefault();
          tabBtns.forEach(function(b) { b.classList.remove('active'); });
          tabPanels.forEach(function(p) { p.classList.remove('active'); });
          btn.classList.add('active');
          var panelId = btn.getAttribute('data-tab') + 'Panel';
          var panel = document.getElementById(panelId); if (panel) panel.classList.add('active');
          if (btn.getAttribute('data-tab') === 'overview' || btn.getAttribute('data-tab') === 'submissions') {
            loadSubmissions();
          } else if (btn.getAttribute('data-tab') === 'reviews') {
            loadAssignedReviews();
          } else if (btn.getAttribute('data-tab') === 'settings') {
            loadProfileSettings();
          }
        });
      });

      // Check URL parameters for initial tab
      var urlParams = new URLSearchParams(window.location.search);
      var initialTab = urlParams.get('tab');
      if (initialTab) {
        var targetBtn = document.querySelector('.tab-btn[data-tab="' + initialTab + '"]');
        if (targetBtn) {
          setTimeout(function() { targetBtn.click(); }, 50);
        }
      }

      // --- Subject Autocomplete ---
      var selectedSubjects = [];
      var subjectList = window.SUBJECTS || [];

      function matchSubjects(query, list) {
        if (!query || query.length < 2) return [];
        var q = query.toLowerCase();
        return list
          .filter(function(s) { return s.name.toLowerCase().indexOf(q) !== -1; })
          .sort(function(a, b) {
            var aStarts = a.name.toLowerCase().indexOf(q) === 0 ? 0 : 1;
            var bStarts = b.name.toLowerCase().indexOf(q) === 0 ? 0 : 1;
            return aStarts - bStarts || a.name.length - b.name.length;
          })
          .slice(0, 15);
      }

      function highlightMatch(name, query) {
        var idx = name.toLowerCase().indexOf(query.toLowerCase());
        if (idx === -1) return escapeHTML(name);
        return escapeHTML(name.substring(0, idx)) + '<span class="highlight">' + escapeHTML(name.substring(idx, idx + query.length)) + '</span>' + escapeHTML(name.substring(idx + query.length));
      }

      function renderSubjectChips() {
        var container = document.getElementById('subjectChips');
        container.innerHTML = selectedSubjects.map(function(s, i) {
          return '<span class="subj-chip">' + escapeHTML(s) + '<button type="button" class="subj-chip-remove" onclick="removeSubject(' + i + ')" title="Remove">&times;</button></span>';
        }).join('');
      }

      function addSubject(name) {
        if (selectedSubjects.indexOf(name) === -1) {
          selectedSubjects.push(name);
          renderSubjectChips();
        }
        document.getElementById('subjectSearch').value = '';
        document.getElementById('subjectDropdown').style.display = 'none';
      }

      function removeSubject(index) {
        selectedSubjects.splice(index, 1);
        renderSubjectChips();
      }

      function renderDropdown(matches, query) {
        var dropdown = document.getElementById('subjectDropdown');
        if (matches.length === 0) {
          dropdown.innerHTML = '<div class="no-subjects-match">No matching subjects found</div>';
          dropdown.style.display = 'block';
          return;
        }
        dropdown.innerHTML = matches.map(function(s) {
          return '<div class="subject-option" data-name="' + escapeHTML(s.name) + '" onclick="addSubject(\'' + escapeHTML(s.name).replace(/'/g, "\\'") + '\')">' +
            highlightMatch(s.name, query) +
            (s.parent ? '<span class="subject-parent">' + escapeHTML(s.parent) + '</span>' : '') +
            '</div>';
        }).join('');
        dropdown.style.display = 'block';
      }

      // Subject search input handler
      var subjectSearchEl = document.getElementById('subjectSearch');
      var subjectDropdownEl = document.getElementById('subjectDropdown');
      var activeDropdownIndex = -1;

      subjectSearchEl.addEventListener('input', function() {
        var query = this.value;
        if (query.length < 2) {
          subjectDropdownEl.style.display = 'none';
          return;
        }
        var matches = matchSubjects(query, subjectList);
        renderDropdown(matches, query);
        activeDropdownIndex = -1;
      });

      subjectSearchEl.addEventListener('keydown', function(e) {
        var options = subjectDropdownEl.querySelectorAll('.subject-option');
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          activeDropdownIndex = Math.min(activeDropdownIndex + 1, options.length - 1);
          options.forEach(function(o, i) { o.classList.toggle('active', i === activeDropdownIndex); });
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          activeDropdownIndex = Math.max(activeDropdownIndex - 1, 0);
          options.forEach(function(o, i) { o.classList.toggle('active', i === activeDropdownIndex); });
        } else if (e.key === 'Enter') {
          e.preventDefault();
          if (activeDropdownIndex >= 0 && options[activeDropdownIndex]) {
            addSubject(options[activeDropdownIndex].getAttribute('data-name'));
          } else if (this.value.trim() && options.length > 0) {
            addSubject(options[0].getAttribute('data-name'));
          }
          activeDropdownIndex = -1;
        } else if (e.key === 'Escape') {
          subjectDropdownEl.style.display = 'none';
          activeDropdownIndex = -1;
        }
      });

      // Close dropdown on outside click
      document.addEventListener('click', function(e) {
        if (!subjectSearchEl.contains(e.target) && !subjectDropdownEl.contains(e.target)) {
          subjectDropdownEl.style.display = 'none';
        }
      });

      // --- Exam Autocomplete ---
      var selectedExams = [];
      var examList = window.EXAMS || [];

      function matchExams(query, list) {
        if (!query || query.length < 2) return [];
        var q = query.toLowerCase();
        return list
          .filter(function(e) { return e.name.toLowerCase().indexOf(q) !== -1; })
          .sort(function(a, b) {
            var aStarts = a.name.toLowerCase().indexOf(q) === 0 ? 0 : 1;
            var bStarts = b.name.toLowerCase().indexOf(q) === 0 ? 0 : 1;
            return aStarts - bStarts || a.name.length - b.name.length;
          })
          .slice(0, 15);
      }

      function renderExamChips() {
        var container = document.getElementById('examChips');
        container.innerHTML = selectedExams.map(function(name, i) {
          return '<span class="subj-chip">' + escapeHTML(name) + '<button type="button" class="subj-chip-remove" onclick="removeExam(' + i + ')" title="Remove">&times;</button></span>';
        }).join('');
      }

      function addExam(name) {
        if (selectedExams.indexOf(name) === -1) {
          selectedExams.push(name);
          renderExamChips();
        }
        document.getElementById('examSearch').value = '';
        document.getElementById('examDropdown').style.display = 'none';
      }

      function removeExam(index) {
        selectedExams.splice(index, 1);
        renderExamChips();
      }

      function renderExamDropdown(matches, query) {
        var dropdown = document.getElementById('examDropdown');
        if (matches.length === 0) {
          dropdown.innerHTML = '<div class="no-subjects-match">No matching exams found</div>';
          dropdown.style.display = 'block';
          return;
        }
        dropdown.innerHTML = matches.map(function(e) {
          return '<div class="subject-option" data-name="' + escapeHTML(e.name) + '" onclick="addExam(\'' + escapeHTML(e.name).replace(/'/g, "\\'") + '\')">' +
            highlightMatch(e.name, query) +
            (e.category ? '<span class="subject-parent">' + escapeHTML(e.category) + '</span>' : '') +
            '</div>';
        }).join('');
        dropdown.style.display = 'block';
      }

      var examSearchEl = document.getElementById('examSearch');
      var examDropdownEl = document.getElementById('examDropdown');
      var activeExamDropdownIndex = -1;

      examSearchEl.addEventListener('input', function() {
        var query = this.value;
        if (query.length < 2) {
          examDropdownEl.style.display = 'none';
          return;
        }
        var matches = matchExams(query, examList);
        renderExamDropdown(matches, query);
        activeExamDropdownIndex = -1;
      });

      examSearchEl.addEventListener('keydown', function(e) {
        var options = examDropdownEl.querySelectorAll('.subject-option');
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          activeExamDropdownIndex = Math.min(activeExamDropdownIndex + 1, options.length - 1);
          options.forEach(function(o, i) { o.classList.toggle('active', i === activeExamDropdownIndex); });
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          activeExamDropdownIndex = Math.max(activeExamDropdownIndex - 1, 0);
          options.forEach(function(o, i) { o.classList.toggle('active', i === activeExamDropdownIndex); });
        } else if (e.key === 'Enter') {
          e.preventDefault();
          if (activeExamDropdownIndex >= 0 && options[activeExamDropdownIndex]) {
            addExam(options[activeExamDropdownIndex].getAttribute('data-name'));
          } else if (this.value.trim() && options.length > 0) {
            addExam(options[0].getAttribute('data-name'));
          }
          activeExamDropdownIndex = -1;
        } else if (e.key === 'Escape') {
          examDropdownEl.style.display = 'none';
          activeExamDropdownIndex = -1;
        }
      });

      document.addEventListener('click', function(e) {
        if (!examSearchEl.contains(e.target) && !examDropdownEl.contains(e.target)) {
          examDropdownEl.style.display = 'none';
        }
      });

      // --- Alert & Toast System ---
      function showToast(message, type, duration) {
        type = type || 'success';
        duration = duration || 4500;
        var container = document.getElementById('toastContainer');
        if (!container) return;

        var toast = document.createElement('div');
        toast.className = 'floating-toast toast-' + type;
        var icon = type === 'success' ? '✅' : (type === 'error' ? '❌' : 'ℹ️');
        toast.innerHTML = '<span style="font-size:1.25rem;line-height:1;">' + icon + '</span><span style="flex:1;font-size:0.9rem;font-weight:500;line-height:1.4;">' + message + '</span><button type="button" style="background:transparent;border:none;color:currentColor;cursor:pointer;opacity:0.7;font-size:1.1rem;padding:0 0 0 0.5rem;line-height:1;" onclick="this.parentElement.remove()">&times;</button>';
        
        container.appendChild(toast);
        setTimeout(function() {
          toast.classList.add('toast-fade-out');
          setTimeout(function() { if (toast.parentElement) toast.remove(); }, 300);
        }, duration);
      }

      function showModalAlert(title, message, type) {
        type = type || 'success';
        var overlay = document.getElementById('alertModalOverlay');
        var iconEl = document.getElementById('alertModalIcon');
        var titleEl = document.getElementById('alertModalTitle');
        var msgEl = document.getElementById('alertModalMessage');
        
        if (!overlay) return;
        if (iconEl) iconEl.textContent = type === 'success' ? '✅' : (type === 'error' ? '⚠️' : 'ℹ️');
        if (titleEl) titleEl.textContent = title || (type === 'success' ? 'Success' : 'Notice');
        if (msgEl) msgEl.textContent = message || '';
        
        overlay.style.display = 'flex';
      }

      function closeAlertModal() {
        var overlay = document.getElementById('alertModalOverlay');
        if (overlay) overlay.style.display = 'none';
      }

      function showAlert(message, type) {
        type = type || 'success';
        showToast(message, type);
      }

      // Close modal on overlay click
      var alertModalOverlay = document.getElementById('alertModalOverlay');
      if (alertModalOverlay) {
        alertModalOverlay.addEventListener('click', function(e) {
          if (e.target === this) closeAlertModal();
        });
      }

      // --- Load Submissions ---
      async function loadSubmissions() {
        try {
          var res = await fetch('/api/submissions/list');
          if (res.status === 401) { sessionStorage.clear(); window.location.href = '/contributors'; return; }
          var data = await res.json();
          var submissions = data.submissions || [];
          updateStats(submissions);
          renderSubmissionsTable(submissions);
        } catch(err) {
          console.error('Failed to load submissions:', err);
        }
      }

      function updateStats(submissions) {
        var total = submissions.length;
        var pending = submissions.filter(function(s){return s.status==='pending'}).length;
        var published = submissions.filter(function(s){return s.status==='published'}).length;
        document.getElementById('statTotal').textContent = total;
        document.getElementById('statPending').textContent = pending;
        document.getElementById('statPublished').textContent = published;
      }

      function renderSubmissionsTable(submissions) {
        var tbody = document.getElementById('submissionsTableBody');
        if (submissions.length === 0) {
          tbody.innerHTML = '<tr><td colspan="5" class="empty-state">No submissions yet. Start by submitting your first article!</td></tr>';
          return;
        }
        tbody.innerHTML = submissions.map(function(s) {
          var date = new Date(s.created_at * 1000);
          var dateStr = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
          var isPublished = s.status === 'published';
          var subjectsDisplay = '';
          try {
            // Try subject column first (new format: JSON array)
            var subjParsed = JSON.parse(s.subject || '[]');
            if (Array.isArray(subjParsed) && subjParsed.length > 0) {
              subjectsDisplay = subjParsed.join(', ');
            } else {
              // Fallback: old tag column
              var tagParsed = JSON.parse(s.tag || '[]');
              subjectsDisplay = Array.isArray(tagParsed) ? tagParsed.join(', ') : (s.tag || '—');
            }
          } catch(e) { subjectsDisplay = s.subject || s.tag || '—'; }
          return '<tr>'+
            '<td style="font-weight:600;">' + escapeHTML(s.title) + '</td>'+
            '<td>' + escapeHTML(subjectsDisplay) + '</td>'+
            '<td>' + dateStr + '</td>'+
            '<td><span class="badge badge-' + s.status + '">' + s.status + '</span>' +
            (s.status === 'rejected' && s.admin_notes ? '<div style="font-size:0.75rem;color:#ef4444;margin-top:0.25rem;">' + escapeHTML(s.admin_notes) + '</div>' : '') +
            '</td>'+
            '<td style="white-space:nowrap;">' +
              '<button class="action-btn-sm btn-view" onclick="viewSubmission(' + s.id + ')" title="View">👁</button>' +
              '<button class="action-btn-sm btn-edit-sm" onclick="editSubmission(' + s.id + ')" title="Edit">✏️</button>' +
              (isPublished
                ? '<button class="action-btn-sm btn-del-disabled" disabled title="Cannot delete published articles">🗑</button>'
                : '<button class="action-btn-sm btn-del-sm" onclick="deleteSubmission(' + s.id + ')" title="Delete">🗑</button>'
              ) +
            '</td>'+
            '</tr>';
        }).join('');
      }

      function escapeHTML(str) {
        var div = document.createElement('div');
        div.textContent = str || '';
        return div.innerHTML;
      }

      // --- In-text Image Slots & Markdown Generator ---
      var MAX_INTEXT_IMAGES = 5;
      var intextSlots = []; // { id, file, name, description, dataUrl, uploadedUrl }

      function updateIntextMarkdownSnippet(slotIndex) {
        var slot = intextSlots.find(function(s) { return s.id === slotIndex; });
        var nameInput = document.getElementById('intextName' + slotIndex);
        var descInput = document.getElementById('intextDesc' + slotIndex);
        var altText = (nameInput && nameInput.value.trim()) || (descInput && descInput.value.trim()) || ('Figure ' + (slotIndex + 1));
        
        var url = (slot && slot.uploadedUrl) || (slot && slot.dataUrl) || '';
        var snippetContainer = document.getElementById('intextSnippetBox' + slotIndex);
        var codeEl = document.getElementById('intextMarkdownCode' + slotIndex);

        if (url && snippetContainer && codeEl) {
          var mdSnippet = '![' + altText + '](' + url + ')';
          codeEl.textContent = mdSnippet;
          snippetContainer.style.display = 'block';
        }
      }

      function copyIntextMarkdownTag(slotIndex) {
        var codeEl = document.getElementById('intextMarkdownCode' + slotIndex);
        if (!codeEl) return;
        var text = codeEl.textContent.trim();
        if (!text) return;

        navigator.clipboard.writeText(text).then(function() {
          showToast('📋 Markdown tag copied! Paste with Ctrl+V into your article content.', 'success');
        }).catch(function() {
          showAlert('Copied: ' + text, 'success');
        });
      }

      function insertIntextTagAtCursor(slotIndex) {
        var codeEl = document.getElementById('intextMarkdownCode' + slotIndex);
        if (!codeEl) return;
        var text = codeEl.textContent.trim();
        if (!text) return;

        var textarea = document.getElementById('artContent');
        if (!textarea) return;

        var startPos = textarea.selectionStart || 0;
        var endPos = textarea.selectionEnd || 0;
        var currentVal = textarea.value;

        var insertText = '\n\n' + text + '\n\n';
        textarea.value = currentVal.substring(0, startPos) + insertText + currentVal.substring(endPos);
        textarea.focus();
        textarea.selectionStart = textarea.selectionEnd = startPos + insertText.length;
        showToast('✅ Figure tag inserted into your article content!', 'success');
      }

      function createImageSlot(slotIndex) {
        var slot = document.createElement('div');
        slot.className = 'image-slot';
        slot.id = 'intextSlot' + slotIndex;
        slot.innerHTML =
          '<div class="image-slot-header">'+
            '<span class="image-slot-title">Figure / In-text Image ' + (slotIndex + 1) + '</span>'+
            '<button type="button" class="image-slot-remove" onclick="removeImageSlot(' + slotIndex + ')">Remove</button>'+
          '</div>'+
          '<div class="image-upload-row">'+
            '<div class="upload-zone compact" id="intextDropZone' + slotIndex + '" style="flex:1;min-width:150px;">'+
              '<span style="font-size:0.85rem;">Drop image or <span style="color:var(--accent);text-decoration:underline;">browse</span></span>'+
              '<div style="font-size:0.7rem;color:var(--muted);">Max 100KB (WebP)</div>'+
              '<input type="file" id="intextFileInput' + slotIndex + '" accept="image/jpeg,image/png,image/webp,image/avif" style="display:none;" />'+
              '<div class="image-preview-container" id="intextPreview' + slotIndex + '"><img src="" class="image-preview" id="intextPreviewImg' + slotIndex + '" alt="Preview" /><button type="button" class="clear-img-btn" id="intextClear' + slotIndex + '">&times;</button></div>'+
            '</div>'+
            '<div class="image-upload-fields">'+
              '<div class="form-group" style="margin-bottom:0.5rem;"><input type="text" id="intextName' + slotIndex + '" class="form-input" placeholder="Figure title / Alt text (e.g. Figure 1: ECG graph)" style="padding:0.5rem 0.75rem;font-size:0.85rem;" /></div>'+
              '<div class="form-group"><input type="text" id="intextDesc' + slotIndex + '" class="form-input" placeholder="Clinical description / caption" style="padding:0.5rem 0.75rem;font-size:0.85rem;" /></div>'+
            '</div>'+
          '</div>'+
          '<div id="intextSnippetBox' + slotIndex + '" class="intext-snippet-box" style="display:none;">'+
            '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.35rem;flex-wrap:wrap;gap:0.4rem;">'+
              '<span style="font-weight:700;color:var(--accent);font-size:0.82rem;">📋 Ready-to-Embed Markdown Tag:</span>'+
              '<div style="display:flex;gap:0.4rem;">'+
                '<button type="button" class="btn-copy-tag" onclick="copyIntextMarkdownTag(' + slotIndex + ')">📋 Copy Markdown Tag</button>'+
                '<button type="button" class="btn-insert-cursor" onclick="insertIntextTagAtCursor(' + slotIndex + ')">↵ Insert at Cursor</button>'+
              '</div>'+
            '</div>'+
            '<div class="intext-code-preview"><code id="intextMarkdownCode' + slotIndex + '"></code></div>'+
            '<div style="font-size:0.75rem;color:var(--muted);margin-top:0.3rem;">👉 Paste this markdown tag directly into your <strong>Article Content</strong> where you want the figure to appear.</div>'+
          '</div>';

        document.getElementById('intextImageSlots').appendChild(slot);
        setupSlotUploadListeners(slotIndex);

        // Input listeners to update markdown snippet live
        ['intextName', 'intextDesc'].forEach(function(prefix) {
          var input = document.getElementById(prefix + slotIndex);
          if (input) {
            input.addEventListener('input', function() { updateIntextMarkdownSnippet(slotIndex); });
          }
        });
      }

      function removeImageSlot(slotIndex) {
        var slotEl = document.getElementById('intextSlot' + slotIndex);
        if (slotEl) slotEl.remove();
        intextSlots = intextSlots.filter(function(s) { return s.id !== slotIndex; });
      }

      function setupSlotUploadListeners(slotIndex) {
        var dropZone = document.getElementById('intextDropZone' + slotIndex);
        var fileInput = document.getElementById('intextFileInput' + slotIndex);
        var previewContainer = document.getElementById('intextPreview' + slotIndex);
        var previewImg = document.getElementById('intextPreviewImg' + slotIndex);
        var clearBtn = document.getElementById('intextClear' + slotIndex);

        if (!dropZone) return;

        dropZone.addEventListener('click', function(e) {
          if (!previewContainer.contains(e.target) && e.target !== clearBtn) fileInput.click();
        });
        dropZone.addEventListener('dragover', function(e) { e.preventDefault(); dropZone.classList.add('dragover'); });
        dropZone.addEventListener('dragleave', function() { dropZone.classList.remove('dragover'); });
        dropZone.addEventListener('drop', function(e) {
          e.preventDefault();
          dropZone.classList.remove('dragover');
          if (e.dataTransfer.files.length) handleIntextFile(slotIndex, e.dataTransfer.files[0]);
        });
        fileInput.addEventListener('change', function() {
          if (fileInput.files.length) handleIntextFile(slotIndex, fileInput.files[0]);
        });
        clearBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          fileInput.value = '';
          previewImg.src = '';
          previewContainer.style.display = 'none';
          var snip = document.getElementById('intextSnippetBox' + slotIndex);
          if (snip) snip.style.display = 'none';
          intextSlots = intextSlots.filter(function(s) { return s.id !== slotIndex; });
        });
      }

      function handleIntextFile(slotIndex, file) {
        if (!file.type.startsWith('image/')) { showAlert('Only image files are allowed!', 'error'); return; }
        openImageCropper(file, { type: 'intext', maxDim: 1000 }, async function(dataUrl, sizeBytes) {
          document.getElementById('intextPreviewImg' + slotIndex).src = dataUrl;
          document.getElementById('intextPreview' + slotIndex).style.display = 'flex';
          var name = (document.getElementById('intextName' + slotIndex) && document.getElementById('intextName' + slotIndex).value.trim()) || ('Figure ' + (slotIndex + 1));
          var desc = (document.getElementById('intextDesc' + slotIndex) && document.getElementById('intextDesc' + slotIndex).value.trim()) || '';
          
          showToast('Uploading figure link to cloud storage...', 'info');
          var upRes = await uploadImageToR2(dataUrl, 'figure-' + (slotIndex + 1) + '-' + (user && user.username || 'contributor'), desc, 'inline');
          var permanentUrl = (upRes && upRes.success && upRes.url) ? upRes.url : dataUrl;

          intextSlots = intextSlots.filter(function(s) { return s.id !== slotIndex; });
          intextSlots.push({ id: slotIndex, file: file, name: name, description: desc, dataUrl: dataUrl, uploadedUrl: permanentUrl });

          updateIntextMarkdownSnippet(slotIndex);
          showModalAlert('Figure Uploaded & Ready', 'Your figure has been uploaded and optimized (' + (sizeBytes / 1024).toFixed(1) + ' KB)!\n\nClick "Copy Markdown Tag" or "Insert at Cursor" in the slot to place this figure directly into your article content.', 'success');
        });
      }

      // Add initial slot
      createImageSlot(0);

      document.getElementById('addImageSlotBtn').addEventListener('click', function() {
        var count = document.querySelectorAll('.image-slot').length;
        if (count >= MAX_INTEXT_IMAGES) {
          showAlert('Maximum ' + MAX_INTEXT_IMAGES + ' in-text images allowed.', 'error');
          return;
        }
        createImageSlot(count);
      });

      // --- Cover Image Upload ---
      var coverDropZone = document.getElementById('coverDropZone');
      var coverFileInput = document.getElementById('coverFileInput');
      var coverPreviewContainer = document.getElementById('coverPreviewContainer');
      var coverPreview = document.getElementById('coverImagePreview');
      var coverClearBtn = document.getElementById('coverClearBtn');
      var coverFileData = null; // { file, dataUrl }

      coverDropZone.addEventListener('click', function(e) {
        if (e.target !== coverClearBtn && !coverPreviewContainer.contains(e.target)) coverFileInput.click();
      });
      coverDropZone.addEventListener('dragover', function(e) { e.preventDefault(); coverDropZone.classList.add('dragover'); });
      coverDropZone.addEventListener('dragleave', function() { coverDropZone.classList.remove('dragover'); });
      coverDropZone.addEventListener('drop', function(e) {
        e.preventDefault();
        coverDropZone.classList.remove('dragover');
        if (e.dataTransfer.files.length) handleCoverFile(e.dataTransfer.files[0]);
      });
      coverFileInput.addEventListener('change', function() {
        if (coverFileInput.files.length) handleCoverFile(coverFileInput.files[0]);
      });
      var coverImageUrlInput = document.getElementById('coverImageUrl');

      coverImageUrlInput.addEventListener('input', function() {
        var url = this.value.trim();
        if (url) {
          coverPreview.src = url;
          coverPreviewContainer.style.display = 'flex';
          coverFileData = null;
          coverFileInput.value = '';
        } else if (!coverFileData) {
          coverPreview.src = '';
          coverPreviewContainer.style.display = 'none';
        }
      });

      coverClearBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        coverFileInput.value = '';
        coverPreview.src = '';
        coverPreviewContainer.style.display = 'none';
        coverFileData = null;
        if (coverImageUrlInput) coverImageUrlInput.value = '';
        document.getElementById('coverImageName').value = '';
        document.getElementById('coverImageDesc').value = '';
      });

      function handleCoverFile(file) {
        if (!file.type.startsWith('image/')) { showAlert('Only image files are allowed!', 'error'); return; }
        openImageCropper(file, { type: 'cover', maxDim: 1000 }, function(dataUrl, sizeBytes) {
          coverFileData = { file: file, dataUrl: dataUrl };
          coverPreview.src = dataUrl;
          coverPreviewContainer.style.display = 'flex';
          if (coverImageUrlInput) coverImageUrlInput.value = '';
          showAlert('Cover image cropped & optimized (' + (sizeBytes / 1024).toFixed(1) + ' KB)!', 'success');
        });
      }

      // --- Upload helper: sends a base64 file to R2 ---
      async function uploadImageToR2(dataUrl, name, description, folder) {
        try {
          var approxSize = Math.round((dataUrl.length - (dataUrl.indexOf(',') + 1)) * 3 / 4);
          if (approxSize > 100 * 1024) {
            return { success: false, error: 'Image size is ' + (approxSize / 1024).toFixed(1) + ' KB, exceeding the 100 KB limit. Please compress to WebP format.' };
          }

          var res = await fetch('/api/images/upload', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              file: dataUrl,
              name: name || 'image',
              description: description || '',
              folder: folder || 'uploads'
            })
          });
          var data = await res.json();
          if (res.ok && data.success) {
            return { success: true, url: data.url, key: data.key };
          } else {
            return { success: false, error: data.error || 'Upload failed' };
          }
        } catch(err) {
          return { success: false, error: 'Network error during image upload.' };
        }
      }

      // --- Article Form Submit ---
      var articleForm = document.getElementById('articleForm');
      var submitBtn = document.getElementById('submitBtn');

      articleForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        submitBtn.disabled = true;
        var isEdit = !!editingSubmissionId;
        submitBtn.textContent = isEdit ? 'Updating article...' : 'Uploading images...';

        // Validate subjects
        if (selectedSubjects.length === 0) {
          showModalAlert('Subject Category Required', 'Please select at least one relevant subject category for your article before submitting.', 'error');
          showToast('Please select at least one subject.', 'error');
          submitBtn.disabled = false;
          submitBtn.textContent = isEdit ? 'Update Article' : 'Submit Article for Review';
          return;
        }

        // Exams are already collected in selectedExams (optional)

        // Upload cover image to R2 or use entered / existing URL
        var coverUrl = '';
        var rawCoverUrl = coverImageUrlInput ? coverImageUrlInput.value.trim() : '';
        if (coverFileData && coverFileData.dataUrl) {
          var coverName = document.getElementById('coverImageName').value.trim() || 'cover-image';
          var coverDesc = document.getElementById('coverImageDesc').value.trim() || '';
          var coverResult = await uploadImageToR2(coverFileData.dataUrl, coverName, coverDesc, 'covers');
          if (coverResult.success) {
            coverUrl = coverResult.url;
          } else {
            showAlert('Cover image upload failed: ' + coverResult.error, 'error');
            submitBtn.disabled = false;
            submitBtn.textContent = 'Submit Article for Review';
            return;
          }
        } else if (rawCoverUrl) {
          coverUrl = rawCoverUrl;
        } else if (coverPreview.src && coverPreviewContainer.style.display !== 'none' && !coverPreview.src.startsWith('data:')) {
          coverUrl = coverPreview.src;
        }

        // Upload in-text images to R2
        var intextImages = []; // { url, name, description }
        for (var i = 0; i < intextSlots.length; i++) {
          var slot = intextSlots[i];
          if (slot.dataUrl) {
            var slotName = document.getElementById('intextName' + slot.id);
            var slotDesc = document.getElementById('intextDesc' + slot.id);
            var name = (slotName ? slotName.value.trim() : '') || 'image-' + (slot.id + 1);
            var desc = (slotDesc ? slotDesc.value.trim() : '') || '';
            submitBtn.textContent = 'Uploading image ' + (i + 1) + '/' + intextSlots.length + '...';
            var result = await uploadImageToR2(slot.dataUrl, name, desc, 'inline');
            if (result.success) {
              intextImages.push({ url: result.url, name: name, description: desc });
              // Show URL in the slot
              var urlDisplay = document.getElementById('intextUrlDisplay' + slot.id);
              var urlEl = document.getElementById('intextUrl' + slot.id);
              if (urlDisplay && urlEl) {
                urlEl.textContent = result.url;
                urlDisplay.style.display = 'block';
              }
            } else {
              showAlert('In-text image upload failed: ' + result.error, 'error');
              submitBtn.disabled = false;
              submitBtn.textContent = 'Submit Article for Review';
              return;
            }
          }
        }

        submitBtn.textContent = isEdit ? 'Updating article...' : 'Submitting article...';

        var payload = {
          title: document.getElementById('artTitle').value.trim(),
          author: document.getElementById('artAuthor').value.trim(),
          type: document.getElementById('artType').value,
          subjects: selectedSubjects,       // Array of subject names
          topic: document.getElementById('artTopic').value.trim(),
          description: document.getElementById('artDesc').value.trim(),
          exams: selectedExams,           // Array of exam names
          image: coverUrl,                 // R2 URL instead of base64
          intextImages: intextImages,      // Array of {url, name, description}
          body: document.getElementById('artContent').value.trim()
        };

        try {
          var url = isEdit ? '/api/submissions/' + editingSubmissionId : '/api/submissions/create';
          var method = isEdit ? 'PUT' : 'POST';

          var res = await fetch(url, {
            method: method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          var data = await res.json();

          if (res.ok && data.success) {
            articleForm.reset();
            // Reset cover image
            coverPreview.src = '';
            coverPreviewContainer.style.display = 'none';
            coverFileData = null;
            document.getElementById('coverImageName').value = '';
            document.getElementById('coverImageDesc').value = '';
            // Reset in-text slots
            document.getElementById('intextImageSlots').innerHTML = '';
            intextSlots = [];
            createImageSlot(0);
            // Re-set author
            document.getElementById('artAuthor').value = user.full_name || user.username || '';

            // Clear subject and exam chips
            selectedSubjects = [];
            renderSubjectChips();
            selectedExams = [];
            renderExamChips();

            // Hide edit warning
            var warnBanner = document.getElementById('editWarningBanner');
            if (warnBanner) warnBanner.style.display = 'none';

            // Reset edit state
            editingSubmissionId = null;
            submitBtn.textContent = 'Submit Article for Review';
            updateFormTitle('Submit Research Article');

            var modalTitle = isEdit ? 'Article Updated!' : 'Submission Successful!';
            var modalMsg = isEdit
              ? (data.statusChanged ? 'Your published article has been updated and sent back for re-approval.' : 'Your changes have been saved.')
              : 'Your article has been submitted for review. A confirmation email has been sent to your registered email address.';

            showModal('success', modalTitle, modalMsg);
            // Switch to submissions tab after modal is dismissed
            var origCloseModal = closeModal;
            closeModal = function() {
              document.getElementById('modalOverlay').style.display = 'none';
              document.querySelector('[data-tab="submissions"]').click();
              closeModal = origCloseModal;
            };
          } else {
            showModal('error', 'Submission Failed', data.error || 'An unexpected error occurred. Please try again.');
          }
        } catch(err) {
          showAlert('Network error. Please try again.', 'error');
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit Article for Review';
        }
      });

      // --- Live Webpage Article Preview ---
      function openArticlePreview() {
        var title = document.getElementById('artTitle').value.trim();
        var desc = document.getElementById('artDesc').value.trim();
        var content = document.getElementById('artContent').value.trim();
        var author = document.getElementById('artAuthor').value.trim() || (user && user.full_name) || (user && user.username) || 'Contributing Author';
        var audience = document.getElementById('artAudience') ? document.getElementById('artAudience').value : 'all';

        if (!title) {
          showModalAlert('Article Title Required', 'Please enter an Article Title in the form before generating the live webpage preview.', 'error');
          showToast('Please enter an Article Title to preview.', 'error');
          document.getElementById('artTitle').focus();
          return;
        }
        if (!content) {
          showModalAlert('Article Content Required', 'Please write some publication content (Markdown) in the form before generating the live preview.', 'error');
          showToast('Please write some Article Content to preview.', 'error');
          document.getElementById('artContent').focus();
          return;
        }

        // Title
        document.getElementById('prevTitle').textContent = title;

        // Executive Summary Callout
        var descBox = document.getElementById('prevDescriptionBox');
        if (desc) {
          descBox.textContent = desc;
          descBox.style.display = 'block';
        } else {
          descBox.style.display = 'none';
        }

        // Breadcrumbs & Subjects
        var breadcrumbSubj = document.getElementById('prevBreadcrumbSubjects');
        if (selectedSubjects && selectedSubjects.length > 0) {
          breadcrumbSubj.textContent = selectedSubjects.join(', ');
        } else {
          breadcrumbSubj.textContent = 'General Medicine';
        }

        // Audience Pill
        var audienceNames = {
          'all': '🩺 All Medical Professionals',
          'medical-students': '🎓 Medical Students & USMLE Prep',
          'residents': '🏥 Residents & Fellows',
          'physicians': '👨‍⚕️ Board-Certified Physicians',
          'nursing': '🩺 Nursing & Allied Health',
          'researchers': '🔬 Clinical & Translational Researchers'
        };
        var audBadge = document.getElementById('prevAudienceBadge');
        if (audBadge) audBadge.textContent = audienceNames[audience] || '🩺 All Medical Professionals';

        // Read time & Word count
        var words = content.split(/\s+/).filter(Boolean).length;
        var readMins = Math.max(1, Math.ceil(words / 200));
        var customReadTime = document.getElementById('artReadTime') ? document.getElementById('artReadTime').value.trim() : '';
        document.getElementById('prevReadTimeVal').textContent = (customReadTime || readMins) + ' min read (' + words + ' words)';

        // Author byline & avatar
        document.getElementById('prevAuthorName').textContent = author;
        var authorAvatar = document.getElementById('prevAuthorAvatar');
        var userAvatarUrl = (currentAvatarUrl || (user && user.avatar_url) || '');
        if (userAvatarUrl) {
          authorAvatar.innerHTML = '<img src="' + escapeHTML(userAvatarUrl) + '" alt="Author" style="width:100%;height:100%;object-fit:cover;" onerror="this.parentElement.textContent=\'' + author.charAt(0).toUpperCase() + '\'" />';
        } else {
          authorAvatar.textContent = author.charAt(0).toUpperCase();
        }

        // Cover Image Banner
        var coverUrl = (coverPreview && coverPreview.src && coverPreviewContainer && coverPreviewContainer.style.display !== 'none' && !coverPreview.src.startsWith('data:'))
          ? coverPreview.src
          : (coverImageUrlInput && coverImageUrlInput.value.trim() ? coverImageUrlInput.value.trim() : (coverFileData ? coverFileData.dataUrl : ''));
        
        var coverContainer = document.getElementById('prevCoverContainer');
        var coverImg = document.getElementById('prevCoverImg');
        var coverCaption = document.getElementById('prevCoverCaption');
        var coverDesc = document.getElementById('coverImageDesc') ? document.getElementById('coverImageDesc').value.trim() : '';

        if (coverUrl) {
          coverImg.src = coverUrl;
          coverCaption.textContent = coverDesc || '';
          coverContainer.style.display = 'block';
        } else {
          coverContainer.style.display = 'none';
        }

        // Exam Badges
        var examsRow = document.getElementById('prevExamsRow');
        var examChips = document.getElementById('prevExamChips');
        if (selectedExams && selectedExams.length > 0) {
          examChips.innerHTML = selectedExams.map(function(e) {
            return '<span class="badge badge-published" style="background:rgba(99,102,241,0.15);color:#818cf8;border:1px solid rgba(99,102,241,0.3);font-size:0.78rem;">🎯 ' + escapeHTML(e) + '</span>';
          }).join(' ');
          examsRow.style.display = 'block';
        } else {
          examsRow.style.display = 'none';
        }

        // Parse Markdown Content
        var parsedHtml = '';
        if (typeof window.marked !== 'undefined' && typeof window.marked.parse === 'function') {
          parsedHtml = window.marked.parse(content, { gfm: true, breaks: false });
        } else {
          parsedHtml = escapeHTML(content).replace(/\n/g, '<br>');
        }
        document.getElementById('prevArticleBody').innerHTML = parsedHtml;

        // Show Modal
        var prevModal = document.getElementById('articlePreviewModalOverlay');
        if (prevModal) prevModal.style.display = 'flex';
      }

      function closeArticlePreviewModal() {
        var prevModal = document.getElementById('articlePreviewModalOverlay');
        if (prevModal) prevModal.style.display = 'none';
      }

      function submitArticleFromPreview() {
        closeArticlePreviewModal();
        var submitBtn = document.getElementById('submitBtn');
        if (submitBtn) {
          submitBtn.scrollIntoView({ behavior: 'smooth', block: 'center' });
          submitBtn.click();
        }
      }

      // Close preview modal on backdrop click
      var articlePreviewModalOverlay = document.getElementById('articlePreviewModalOverlay');
      if (articlePreviewModalOverlay) {
        articlePreviewModalOverlay.addEventListener('click', function(e) {
          if (e.target === this) closeArticlePreviewModal();
        });
      }

      var previewArticleBtn = document.getElementById('previewArticleBtn');
      if (previewArticleBtn) {
        previewArticleBtn.addEventListener('click', openArticlePreview);
      }

      // --- View, Edit, Delete ---
      var editingSubmissionId = null;

      function updateFormTitle(text) {
        document.querySelector('#submitPanel .panel-title').textContent = text;
      }

      // View submission in modal
      async function viewSubmission(id) {
        try {
          var res = await fetch('/api/submissions/' + id);
          if (res.status === 401) { sessionStorage.clear(); window.location.href = '/contributors'; return; }
          var data = await res.json();
          if (!data.success) { showAlert(data.error, 'error'); return; }
          var s = data.submission;
          var date = new Date(s.created_at * 1000).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
          var subjectsDisplay = '';
          try {
            var subjParsed = JSON.parse(s.subject || '[]');
            if (Array.isArray(subjParsed) && subjParsed.length > 0) {
              subjectsDisplay = subjParsed.join(', ');
            } else {
              var tagParsed = JSON.parse(s.tag || '[]');
              subjectsDisplay = Array.isArray(tagParsed) ? tagParsed.join(', ') : (s.tag || '—');
            }
          } catch(e) { subjectsDisplay = s.subject || s.tag || '—'; }
          var modal = document.getElementById('viewModalContent');
          modal.innerHTML =
            '<div class="view-modal-header">' +
              '<button class="view-modal-close" onclick="closeViewModal()">&times;</button>' +
              '<h2>' + escapeHTML(s.title) + '</h2>' +
              '<div class="view-modal-meta">' +
                '<span><strong>Author:</strong> ' + escapeHTML(s.author) + '</span>' +
                '<span><strong>Type:</strong> ' + escapeHTML(s.type || 'general') + '</span>' +
                '<span><strong>Subjects:</strong> ' + escapeHTML(subjectsDisplay) + '</span>' +
                '<span><strong>Status:</strong> <span class="badge badge-' + s.status + '">' + s.status + '</span></span>' +
                '<span><strong>Date:</strong> ' + date + '</span>' +
              '</div>' +
              (s.image ? '<div style="margin-bottom:1rem;"><img src="' + escapeHTML(s.image) + '" style="max-width:100%;max-height:300px;border-radius:8px;object-fit:cover;" alt="Cover"></div>' : '') +
              (s.description ? '<p style="color:var(--muted);font-style:italic;margin-bottom:1rem;">' + escapeHTML(s.description) + '</p>' : '') +
              '<div class="view-modal-body article-body">' + (typeof marked !== 'undefined' ? marked.parse(s.body || '', { gfm: true, breaks: false }) : escapeHTML(s.body).replace(/\n/g, '<br>')) + '</div>' +
              (s.admin_notes ? '<div style="margin-top:1rem;padding:0.75rem;background:rgba(251,191,36,0.1);border:1px solid rgba(251,191,36,0.3);border-radius:8px;font-size:0.85rem;"><strong>Admin Notes:</strong> ' + escapeHTML(s.admin_notes) + '</div>' : '') +
            '</div>';
          document.getElementById('viewModalOverlay').style.display = 'flex';
        } catch(e) {
          showAlert('Failed to load submission.', 'error');
        }
      }

      function closeViewModal() {
        document.getElementById('viewModalOverlay').style.display = 'none';
      }
      document.getElementById('viewModalOverlay').addEventListener('click', function(e) {
        if (e.target === this) closeViewModal();
      });

      // Edit submission - load into form
      async function editSubmission(id) {
        try {
          var res = await fetch('/api/submissions/' + id);
          if (res.status === 401) { sessionStorage.clear(); window.location.href = '/contributors'; return; }
          var data = await res.json();
          if (!data.success) { showAlert(data.error, 'error'); return; }
          var s = data.submission;

          editingSubmissionId = id;
          document.getElementById('artTitle').value = s.title || '';
          document.getElementById('artAuthor').value = s.author || '';
          document.getElementById('artType').value = s.type || 'general';
          document.getElementById('artTopic').value = s.topic || '';
          document.getElementById('artDesc').value = s.description || '';
          document.getElementById('artContent').value = s.body || '';
          // Exams - load from stored JSON array (or legacy comma string)
          selectedExams = [];
          try {
            var exData = JSON.parse(s.exams || '[]');
            if (Array.isArray(exData)) {
              selectedExams = exData;
            } else if (s.exams) {
              selectedExams = [s.exams];
            }
          } catch(e) {
            if (s.exams && typeof s.exams === 'string') {
              selectedExams = s.exams.split(',').map(function(x){return x.trim();}).filter(Boolean);
            }
          }
          renderExamChips();
          // Subjects - load from stored JSON (tries subject column first, then falls back to tag column)
          selectedSubjects = [];
          try {
            var subjData = JSON.parse(s.subject || '[]');
            if (Array.isArray(subjData) && subjData.length > 0) {
              selectedSubjects = subjData;
            } else {
              // Fallback: old tag column
              var tagData = JSON.parse(s.tag || '[]');
              selectedSubjects = Array.isArray(tagData) ? tagData : [];
            }
          } catch(e) {
            // Old format: single string
            if (s.subject && typeof s.subject === 'string' && s.subject.trim()) {
              selectedSubjects = [s.subject.trim()];
            } else if (s.tag && typeof s.tag === 'string') {
              try {
                var t = JSON.parse(s.tag);
                selectedSubjects = Array.isArray(t) ? t : [];
              } catch(e2) {
                selectedSubjects = s.tag ? s.tag.split(',').map(function(x){return x.trim();}).filter(Boolean) : [];
              }
            }
          }
          renderSubjectChips();

          // Cover image
          coverFileData = null;
          coverPreview.src = s.image || '';
          coverPreviewContainer.style.display = s.image ? 'flex' : 'none';
          if (coverImageUrlInput) coverImageUrlInput.value = s.image || '';
          document.getElementById('coverImageName').value = '';
          document.getElementById('coverImageDesc').value = '';

          // Reset in-text image slots
          document.getElementById('intextImageSlots').innerHTML = '';
          intextSlots = [];
          createImageSlot(0);

          submitBtn.textContent = 'Update Article';
          var warnBanner = document.getElementById('editWarningBanner');
          if (!warnBanner) {
            warnBanner = document.createElement('div');
            warnBanner.id = 'editWarningBanner';
            warnBanner.className = 'edit-warning';
            warnBanner.textContent = '⚠️ Editing a published article will send it back for re-approval.';
            document.getElementById('submitPanel').querySelector('.panel-desc').after(warnBanner);
          }
          warnBanner.style.display = s.status === 'published' ? 'block' : 'none';
          updateFormTitle('Edit Article');

          // Switch to submit tab
          document.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.remove('active'); });
          document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active'); });
          document.querySelector('[data-tab="submit"]').classList.add('active');
          document.getElementById('submitPanel').classList.add('active');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } catch(e) {
          showAlert('Failed to load submission for editing.', 'error');
        }
      }

      // Delete submission
      async function deleteSubmission(id) {
        if (!confirm('Are you sure you want to delete this submission? This action cannot be undone.')) return;
        try {
          var res = await fetch('/api/submissions/' + id, { method: 'DELETE' });
          if (res.status === 401) { sessionStorage.clear(); window.location.href = '/contributors'; return; }
          var data = await res.json();
          if (data.success) {
            showAlert('Submission deleted.', 'success');
            loadSubmissions();
          } else {
            showAlert(data.error || 'Delete failed.', 'error');
          }
        } catch(e) {
          showAlert('Network error.', 'error');
        }
      }

      // --- Peer Review Logic for Reviewers ---
      var currentAssignments = [];

      async function loadAssignedReviews() {
        var tbody = document.getElementById('reviewsTableBody');
        tbody.innerHTML = '<tr><td colspan="6" class="empty-state">Loading assigned reviews...</td></tr>';
        try {
          var res = await fetch('/api/reviewers/assignments');
          if (res.status === 401) { sessionStorage.clear(); window.location.href = '/contributors'; return; }
          var data = await res.json();
          currentAssignments = data.assignments || [];

          if (currentAssignments.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" class="empty-state">No manuscript review assignments currently pending for your account.</td></tr>';
            return;
          }

          tbody.innerHTML = currentAssignments.map(function(a) {
            var assignedDate = new Date(a.assigned_at * 1000).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
            var isCompleted = a.assignment_status === 'completed';
            var statusBadge = isCompleted ? '<span class="badge badge-approved">Completed</span>' : '<span class="badge badge-pending">Review Pending</span>';
            var actionBtn = isCompleted
              ? '<button class="action-btn-sm btn-view" onclick="openReviewModal(' + a.assignment_id + ')" title="View Evaluation">👁 View Evaluation</button>'
              : '<button class="action-btn-sm" style="background:var(--accent);color:#fff;border:none;border-radius:6px;padding:0.35rem 0.75rem;font-weight:600;cursor:pointer;" onclick="openReviewModal(' + a.assignment_id + ')">🩺 Conduct Review</button>';

            return '<tr>' +
              '<td style="font-weight:600;">' + escapeHTML(a.title) + '</td>' +
              '<td>' + escapeHTML(a.author || 'Author') + '</td>' +
              '<td>' + escapeHTML(a.type || 'general') + '</td>' +
              '<td>' + assignedDate + '</td>' +
              '<td>' + statusBadge + '</td>' +
              '<td>' + actionBtn + '</td>' +
            '</tr>';
          }).join('');
        } catch (e) {
          tbody.innerHTML = '<tr><td colspan="6" class="empty-state" style="color:#ef4444;">Error loading assigned reviews: ' + escapeHTML(e.message) + '</td></tr>';
        }
      }

      function openReviewModal(assignmentId) {
        var a = currentAssignments.find(function(item) { return item.assignment_id === assignmentId; });
        if (!a) { alert('Assignment data not found.'); return; }

        document.getElementById('evalAssignmentId').value = a.assignment_id;
        document.getElementById('evalArticleTitle').textContent = a.title;
        document.getElementById('evalArticleMeta').textContent = 'Author: ' + (a.author || 'Author') + ' | Category: ' + (a.type || 'general') + ' | Topic: ' + (a.topic || 'General');
        
        var coverContainer = document.getElementById('evalArticleCover');
        if (a.image) {
          coverContainer.innerHTML = '<img src="' + escapeHTML(a.image) + '" style="width:100%;max-height:220px;object-fit:cover;border-radius:8px;" alt="Cover">';
          coverContainer.style.display = 'block';
        } else {
          coverContainer.innerHTML = '';
          coverContainer.style.display = 'none';
        }

        function renderMarkdownToHtml(md) {
          if (!md) return '<p style="color:var(--muted);font-style:italic;">No content provided.</p>';
          var raw = md.replace(/\r\n/g, '\n').trim();
          var lines = raw.split('\n');
          var html = [];
          var inList = false;

          for (var i = 0; i < lines.length; i++) {
            var line = lines[i];

            // List item
            if (line.match(/^[\*\-]\s+(.*)$/)) {
              var itemText = line.replace(/^[\*\-]\s+/, '');
              if (!inList) {
                html.push('<ul style="margin:0.75rem 0 1rem 1.5rem;padding-left:1rem;line-height:1.7;">');
                inList = true;
              }
              html.push('<li style="margin-bottom:0.35rem;">' + parseInlineMd(itemText) + '</li>');
              continue;
            } else if (inList) {
              html.push('</ul>');
              inList = false;
            }

            // Headings
            if (line.startsWith('### ')) {
              html.push('<h4 style="color:var(--text);margin:1.5rem 0 0.5rem 0;font-size:1.15rem;font-family:\'Outfit\',sans-serif;">' + parseInlineMd(line.substring(4)) + '</h4>');
            } else if (line.startsWith('## ')) {
              html.push('<h3 style="color:var(--text);margin:1.75rem 0 0.6rem 0;font-size:1.35rem;font-family:\'Outfit\',sans-serif;border-bottom:1px solid var(--border);padding-bottom:6px;">' + parseInlineMd(line.substring(3)) + '</h3>');
            } else if (line.startsWith('# ')) {
              html.push('<h2 style="color:var(--text);margin:2rem 0 0.75rem 0;font-size:1.6rem;font-family:\'Outfit\',sans-serif;">' + parseInlineMd(line.substring(2)) + '</h2>');
            } else if (line.startsWith('> ')) {
              html.push('<blockquote style="border-left:4px solid var(--accent);margin:1.25rem 0;padding:0.75rem 1.25rem;background:rgba(99,102,241,0.06);color:var(--text);border-radius:4px;font-style:italic;">' + parseInlineMd(line.substring(2)) + '</blockquote>');
            } else if (line.match(/^---+$|^___+$/)) {
              html.push('<hr style="border:none;border-top:1px solid var(--border);margin:1.5rem 0;">');
            } else if (line.trim().length > 0) {
              html.push('<p style="margin-bottom:1rem;line-height:1.8;color:var(--text);">' + parseInlineMd(line) + '</p>');
            }
          }
          if (inList) html.push('</ul>');
          return html.join('\n');
        }

        function parseInlineMd(str) {
          if (!str) return '';
          var s = escapeHTML(str);
          // Bold + Italic
          s = s.replace(/\*\*\*(.*?)\*\*\*/g, '<strong><em>$1</em></strong>');
          // Bold
          s = s.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
          // Italic
          s = s.replace(/\*(.*?)\*/g, '<em>$1</em>');
          s = s.replace(/_(.*?)_/g, '<em>$1</em>');
          // Inline Code
          s = s.replace(/`(.*?)`/g, '<code style="background:rgba(99,102,241,0.1);color:var(--accent);padding:0.15rem 0.4rem;border-radius:4px;font-size:0.85em;">$1</code>');
          return s;
        }

        document.getElementById('evalArticleDescription').textContent = a.description ? ('Abstract / Summary: ' + a.description) : 'No abstract provided.';
        document.getElementById('evalArticleBody').innerHTML = renderMarkdownToHtml(a.body || '');

        // Pre-fill existing evaluation if already reviewed
        document.getElementById('evalRecommendation').value = a.recommendation || 'accept';
        document.getElementById('evalAccuracy').value = String(a.clinical_accuracy_score || 5);
        document.getElementById('evalStructure').value = String(a.structure_score || 5);
        document.getElementById('evalEvidence').value = String(a.evidence_score || 5);
        document.getElementById('evalAuthorComments').value = a.author_comments || '';
        document.getElementById('evalEditorNotes').value = a.editor_notes || '';

        var isCompleted = a.assignment_status === 'completed';
        document.getElementById('evalSubmitBtn').textContent = isCompleted ? 'Update Evaluation' : 'Submit Review';

        document.getElementById('evalStatusAlert').style.display = 'none';
        document.getElementById('reviewModalOverlay').style.display = 'flex';
      }

      function closeReviewModal() {
        document.getElementById('reviewModalOverlay').style.display = 'none';
      }

      async function submitPeerReview() {
        var assignmentId = document.getElementById('evalAssignmentId').value;
        var recommendation = document.getElementById('evalRecommendation').value;
        var clinicalAccuracy = document.getElementById('evalAccuracy').value;
        var structure = document.getElementById('evalStructure').value;
        var evidence = document.getElementById('evalEvidence').value;
        var authorComments = document.getElementById('evalAuthorComments').value.trim();
        var editorNotes = document.getElementById('evalEditorNotes').value.trim();

        if (!authorComments) {
          alert('Please provide detailed feedback remarks for the author.');
          return;
        }

        var btn = document.getElementById('evalSubmitBtn');
        btn.disabled = true;
        var origText = btn.textContent;
        btn.textContent = 'Submitting & sending email...';

        var alertEl = document.getElementById('evalStatusAlert');
        alertEl.style.display = 'none';

        try {
          var res = await fetch('/api/reviewers/assignments', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              assignmentId: parseInt(assignmentId),
              recommendation: recommendation,
              clinicalAccuracy: clinicalAccuracy,
              structure: structure,
              evidence: evidence,
              authorComments: authorComments,
              editorNotes: editorNotes
            })
          });
          var data = await res.json();
          if (res.ok && data.success) {
            alertEl.className = 'alert alert-success';
            alertEl.textContent = data.message || 'Review submitted successfully!';
            alertEl.style.display = 'block';
            setTimeout(function() {
              closeReviewModal();
              loadAssignedReviews();
            }, 1200);
          } else {
            alertEl.className = 'alert alert-error';
            alertEl.textContent = data.error || 'Submission failed.';
            alertEl.style.display = 'block';
          }
        } catch (err) {
          alertEl.className = 'alert alert-error';
          alertEl.textContent = 'Network error: ' + err.message;
          alertEl.style.display = 'block';
        } finally {
          btn.disabled = false;
          btn.textContent = origText;
        }
      }

      // =========================================================================
      // In-Browser Interactive HTML5 Canvas Image Cropper & WebP Compressor
      // =========================================================================
      var cropperState = {
        img: null,
        type: 'avatar', // 'avatar' | 'cover' | 'intext'
        aspectRatio: 1, // 1 for avatar (1:1), 16/9 for cover, null for intext
        maxDim: 400,
        format: 'image/webp',
        quality: 0.80,
        zoom: 1,
        panX: 0,
        panY: 0,
        isDragging: false,
        dragStartX: 0,
        dragStartY: 0,
        dragStartPanX: 0,
        dragStartPanY: 0,
        callback: null,
        outputDataUrl: '',
        outputSizeBytes: 0
      };

      var cropCanvas = document.getElementById('cropPreviewCanvas');
      var cropCtx = cropCanvas ? cropCanvas.getContext('2d') : null;
      var cropZoomSlider = document.getElementById('cropZoomSlider');
      var cropQualitySlider = document.getElementById('cropQualitySlider');
      var cropQualityVal = document.getElementById('cropQualityVal');
      var cropFormatSelect = document.getElementById('cropFormatSelect');
      var cropSizeBadge = document.getElementById('cropSizeBadge');
      var cropSizeText = document.getElementById('cropSizeText');
      var cropApplyBtn = document.getElementById('cropApplyBtn');
      var cropAutoCompressBtn = document.getElementById('cropAutoCompressBtn');
      var cropResetViewBtn = document.getElementById('cropResetViewBtn');
      var cropperModalOverlay = document.getElementById('cropperModalOverlay');

      function closeCropperModal() {
        if (cropperModalOverlay) cropperModalOverlay.style.display = 'none';
        cropperState.img = null;
        cropperState.callback = null;
      }

      function openImageCropper(file, options, onApply) {
        if (!file) return;
        if (!file.type.startsWith('image/')) {
          showAlert('Please select a valid image file (JPEG, PNG, WebP, AVIF).', 'error');
          return;
        }

        var reader = new FileReader();
        reader.onload = function(e) {
          var img = new Image();
          img.onload = function() {
            cropperState.img = img;
            cropperState.type = options.type || 'avatar';
            cropperState.aspectRatio = options.type === 'avatar' ? 1 : (options.type === 'cover' ? 16 / 9 : 4 / 3);
            cropperState.maxDim = options.maxDim || (options.type === 'avatar' ? 400 : 1000);
            cropperState.callback = onApply;
            cropperState.format = 'image/webp';
            cropperState.quality = 0.80;
            cropperState.panX = 0;
            cropperState.panY = 0;
            cropperState.zoom = 1;

            if (cropFormatSelect) cropFormatSelect.value = 'image/webp';
            if (cropQualitySlider) cropQualitySlider.value = 0.80;
            if (cropQualityVal) cropQualityVal.textContent = '80%';
            if (cropZoomSlider) {
              cropZoomSlider.value = 1;
              cropZoomSlider.min = 0.2;
              cropZoomSlider.max = 3;
            }

            if (cropperModalOverlay) cropperModalOverlay.style.display = 'flex';
            renderCropper();
          };
          img.src = e.target.result;
        };
        reader.readAsDataURL(file);
      }

      function getCropWindowRect(cw, ch, aspect) {
        var margin = 20;
        var maxW = cw - margin * 2;
        var maxH = ch - margin * 2;
        var w, h;
        if (maxW / maxH > aspect) {
          h = maxH;
          w = h * aspect;
        } else {
          w = maxW;
          h = w / aspect;
        }
        var x = (cw - w) / 2;
        var y = (ch - h) / 2;
        return { x: x, y: y, w: w, h: h };
      }

      function renderCropper() {
        if (!cropCanvas || !cropCtx || !cropperState.img) return;
        var cw = cropCanvas.width;
        var ch = cropCanvas.height;
        var img = cropperState.img;

        cropCtx.clearRect(0, 0, cw, ch);

        var cropRect = getCropWindowRect(cw, ch, cropperState.aspectRatio);

        // Draw image transformed
        cropCtx.save();
        var baseScale = Math.max(cropRect.w / img.width, cropRect.h / img.height);
        var currentScale = baseScale * cropperState.zoom;
        var drawW = img.width * currentScale;
        var drawH = img.height * currentScale;
        var drawX = cropRect.x + (cropRect.w - drawW) / 2 + cropperState.panX;
        var drawY = cropRect.y + (cropRect.h - drawH) / 2 + cropperState.panY;

        cropCtx.drawImage(img, drawX, drawY, drawW, drawH);
        cropCtx.restore();

        // Draw darkened mask outside crop window
        cropCtx.save();
        cropCtx.fillStyle = 'rgba(0, 0, 0, 0.65)';
        cropCtx.beginPath();
        cropCtx.rect(0, 0, cw, ch);

        if (cropperState.type === 'avatar') {
          var cx = cropRect.x + cropRect.w / 2;
          var cy = cropRect.y + cropRect.h / 2;
          var radius = Math.min(cropRect.w, cropRect.h) / 2;
          cropCtx.arc(cx, cy, radius, 0, Math.PI * 2, true);
        } else {
          cropCtx.rect(cropRect.x + cropRect.w, cropRect.y, -cropRect.w, cropRect.h);
        }
        cropCtx.fill('evenodd');
        cropCtx.restore();

        // Draw crop border guide
        cropCtx.save();
        cropCtx.strokeStyle = '#0d9488';
        cropCtx.lineWidth = 2;
        if (cropperState.type === 'avatar') {
          var cx = cropRect.x + cropRect.w / 2;
          var cy = cropRect.y + cropRect.h / 2;
          var radius = Math.min(cropRect.w, cropRect.h) / 2;
          cropCtx.beginPath();
          cropCtx.arc(cx, cy, radius, 0, Math.PI * 2);
          cropCtx.stroke();
        } else {
          cropCtx.strokeRect(cropRect.x, cropRect.y, cropRect.w, cropRect.h);
        }
        cropCtx.restore();

        updateCalculatedOutput();
      }

      function generateCroppedData(qualityOverride, maxDimOverride) {
        if (!cropperState.img) return null;
        var img = cropperState.img;
        var cw = cropCanvas.width;
        var ch = cropCanvas.height;
        var cropRect = getCropWindowRect(cw, ch, cropperState.aspectRatio);

        var baseScale = Math.max(cropRect.w / img.width, cropRect.h / img.height);
        var currentScale = baseScale * cropperState.zoom;
        var drawW = img.width * currentScale;
        var drawH = img.height * currentScale;
        var drawX = cropRect.x + (cropRect.w - drawW) / 2 + cropperState.panX;
        var drawY = cropRect.y + (cropRect.h - drawH) / 2 + cropperState.panY;

        var sx = (cropRect.x - drawX) / currentScale;
        var sy = (cropRect.y - drawY) / currentScale;
        var sw = cropRect.w / currentScale;
        var sh = cropRect.h / currentScale;

        var maxDim = maxDimOverride || cropperState.maxDim || 400;
        var targetW, targetH;
        if (cropperState.aspectRatio >= 1) {
          targetW = maxDim;
          targetH = Math.round(maxDim / cropperState.aspectRatio);
        } else {
          targetH = maxDim;
          targetW = Math.round(maxDim * cropperState.aspectRatio);
        }

        var offCanvas = document.createElement('canvas');
        offCanvas.width = targetW;
        offCanvas.height = targetH;
        var offCtx = offCanvas.getContext('2d');
        offCtx.imageSmoothingEnabled = true;
        offCtx.imageSmoothingQuality = 'high';

        offCtx.drawImage(img, sx, sy, sw, sh, 0, 0, targetW, targetH);

        var format = cropperState.format || 'image/webp';
        var quality = typeof qualityOverride === 'number' ? qualityOverride : cropperState.quality;
        var dataUrl = offCanvas.toDataURL(format, quality);
        var sizeBytes = Math.round((dataUrl.length - (dataUrl.indexOf(',') + 1)) * 3 / 4);

        return { dataUrl: dataUrl, sizeBytes: sizeBytes, targetW: targetW, targetH: targetH };
      }

      function updateCalculatedOutput() {
        var res = generateCroppedData();
        if (!res) return;
        cropperState.outputDataUrl = res.dataUrl;
        cropperState.outputSizeBytes = res.sizeBytes;

        var sizeKb = (res.sizeBytes / 1024).toFixed(1);
        if (cropSizeText) cropSizeText.textContent = sizeKb + ' KB / 100 KB max';

        var isOk = res.sizeBytes <= 100 * 1024;
        if (cropSizeBadge) {
          cropSizeBadge.className = isOk ? 'size-badge-ok' : 'size-badge-warn';
          cropSizeBadge.innerHTML = isOk
            ? '<span>✅</span> Output Size: <strong style="margin-left:0.2rem;">' + sizeKb + ' KB (Ready to upload)</strong>'
            : '<span>⚠️</span> Output Size: <strong style="margin-left:0.2rem;">' + sizeKb + ' KB (Exceeds 100 KB)</strong>';
        }
        if (cropApplyBtn) {
          cropApplyBtn.disabled = !isOk;
          cropApplyBtn.textContent = isOk ? 'Crop & Apply (' + sizeKb + ' KB)' : '⚠️ File > 100KB (Reduce quality)';
        }
      }

      function autoCompressUnder100KB() {
        if (!cropperState.img) return;
        var qualities = [0.85, 0.80, 0.75, 0.70, 0.65, 0.60, 0.55, 0.50, 0.45, 0.40];
        var maxDims = [cropperState.maxDim, Math.round(cropperState.maxDim * 0.85), Math.round(cropperState.maxDim * 0.70)];

        for (var d = 0; d < maxDims.length; d++) {
          for (var q = 0; q < qualities.length; q++) {
            var res = generateCroppedData(qualities[q], maxDims[d]);
            if (res && res.sizeBytes <= 100 * 1024) {
              cropperState.quality = qualities[q];
              if (cropQualitySlider) cropQualitySlider.value = qualities[q];
              if (cropQualityVal) cropQualityVal.textContent = Math.round(qualities[q] * 100) + '%';
              renderCropper();
              showAlert('Auto-optimized to ' + (res.sizeBytes / 1024).toFixed(1) + ' KB (Quality: ' + Math.round(qualities[q] * 100) + '%)', 'success');
              return;
            }
          }
        }
        showAlert('Could not compress image below 100KB automatically. Please try zoom adjustments or a smaller original image.', 'error');
      }

      // Cropper mouse / touch drag listeners
      if (cropCanvas) {
        function onDragStart(clientX, clientY) {
          cropperState.isDragging = true;
          cropperState.dragStartX = clientX;
          cropperState.dragStartY = clientY;
          cropperState.dragStartPanX = cropperState.panX;
          cropperState.dragStartPanY = cropperState.panY;
          cropCanvas.style.cursor = 'grabbing';
        }
        function onDragMove(clientX, clientY) {
          if (!cropperState.isDragging) return;
          var dx = clientX - cropperState.dragStartX;
          var dy = clientY - cropperState.dragStartY;
          cropperState.panX = cropperState.dragStartPanX + dx;
          cropperState.panY = cropperState.dragStartPanY + dy;
          renderCropper();
        }
        function onDragEnd() {
          cropperState.isDragging = false;
          cropCanvas.style.cursor = 'grab';
        }

        cropCanvas.addEventListener('mousedown', function(e) { onDragStart(e.clientX, e.clientY); });
        window.addEventListener('mousemove', function(e) { onDragMove(e.clientX, e.clientY); });
        window.addEventListener('mouseup', onDragEnd);

        cropCanvas.addEventListener('touchstart', function(e) {
          if (e.touches.length === 1) onDragStart(e.touches[0].clientX, e.touches[0].clientY);
        }, { passive: true });
        window.addEventListener('touchmove', function(e) {
          if (e.touches.length === 1) onDragMove(e.touches[0].clientX, e.touches[0].clientY);
        }, { passive: true });
        window.addEventListener('touchend', onDragEnd);
      }

      // Zoom slider
      if (cropZoomSlider) {
        cropZoomSlider.addEventListener('input', function() {
          cropperState.zoom = parseFloat(this.value);
          renderCropper();
        });
      }

      // Format select
      if (cropFormatSelect) {
        cropFormatSelect.addEventListener('change', function() {
          cropperState.format = this.value;
          renderCropper();
        });
      }

      // Quality slider
      if (cropQualitySlider) {
        cropQualitySlider.addEventListener('input', function() {
          cropperState.quality = parseFloat(this.value);
          if (cropQualityVal) cropQualityVal.textContent = Math.round(cropperState.quality * 100) + '%';
          renderCropper();
        });
      }

      // Reset view button
      if (cropResetViewBtn) {
        cropResetViewBtn.addEventListener('click', function() {
          cropperState.zoom = 1;
          cropperState.panX = 0;
          cropperState.panY = 0;
          if (cropZoomSlider) cropZoomSlider.value = 1;
          renderCropper();
        });
      }

      // Auto-compress button
      if (cropAutoCompressBtn) {
        cropAutoCompressBtn.addEventListener('click', autoCompressUnder100KB);
      }

      // Apply crop button
      if (cropApplyBtn) {
        cropApplyBtn.addEventListener('click', function() {
          if (cropperState.outputSizeBytes > 100 * 1024) {
            showAlert('Output image must be under 100 KB. Click "Auto-Fit under 100KB".', 'error');
            return;
          }
          var callback = cropperState.callback;
          var dataUrl = cropperState.outputDataUrl;
          var sizeBytes = cropperState.outputSizeBytes;
          closeCropperModal();
          if (typeof callback === 'function') {
            callback(dataUrl, sizeBytes);
          }
        });
      }

      // --- Settings & Profile Logic ---
      var chipData = { affiliation: [], specialty: [], experience: [] };
      var currentAvatarUrl = '';

      function updateSettingsAvatarPreview(url, name) {
        var imgEl = document.getElementById('settingsAvatarImg');
        var initialEl = document.getElementById('settingsAvatarInitial');
        var removeBtn = document.getElementById('removeAvatarBtn');
        var urlInput = document.getElementById('settingsAvatarUrl');

        var initial = (name || (document.getElementById('settingsFullName') && document.getElementById('settingsFullName').value) || 'C').charAt(0).toUpperCase();
        if (initialEl) initialEl.textContent = initial;

        if (url && url.trim()) {
          if (imgEl) {
            imgEl.src = url.trim();
            imgEl.style.display = 'block';
            imgEl.onerror = function() {
              imgEl.style.display = 'none';
              if (initialEl) initialEl.style.display = 'flex';
            };
          }
          if (initialEl) initialEl.style.display = 'none';
          if (removeBtn) removeBtn.style.display = 'inline-block';
          if (urlInput && urlInput.value !== url.trim()) urlInput.value = url.trim();
        } else {
          if (imgEl) {
            imgEl.src = '';
            imgEl.style.display = 'none';
          }
          if (initialEl) initialEl.style.display = 'flex';
          if (removeBtn) removeBtn.style.display = 'none';
          if (urlInput) urlInput.value = '';
        }
      }

      // Avatar File Upload Handler
      var avatarFileInput = document.getElementById('avatarFileInput');
      if (avatarFileInput) {
        avatarFileInput.addEventListener('change', function(e) {
          var file = e.target.files && e.target.files[0];
          if (!file) return;
          if (!file.type.startsWith('image/')) {
            if (typeof showAlert === 'function') showAlert('Only image files are allowed!', 'error');
            return;
          }

          openImageCropper(file, { type: 'avatar', maxDim: 400 }, async function(dataUrl, sizeBytes) {
            var progressEl = document.getElementById('avatarUploadProgress');
            if (progressEl) progressEl.style.display = 'flex';

            var username = (user && user.username) || 'contributor';
            var res = await uploadImageToR2(dataUrl, 'avatar-' + username, 'Profile photo for ' + username, 'avatars');
            if (progressEl) progressEl.style.display = 'none';
            if (res.success && res.url) {
              currentAvatarUrl = res.url;
              updateSettingsAvatarPreview(currentAvatarUrl, document.getElementById('settingsFullName').value);
              if (typeof showAlert === 'function') showAlert('Photo cropped & uploaded (' + (sizeBytes / 1024).toFixed(1) + ' KB)! Click "Save Profile Changes" to save.', 'success');
            } else {
              if (typeof showAlert === 'function') showAlert(res.error || 'Avatar upload failed.', 'error');
            }
          });
        });
      }

      // Apply direct URL button handler
      var applyAvatarUrlBtn = document.getElementById('applyAvatarUrlBtn');
      if (applyAvatarUrlBtn) {
        applyAvatarUrlBtn.addEventListener('click', function() {
          var urlVal = document.getElementById('settingsAvatarUrl').value.trim();
          currentAvatarUrl = urlVal;
          updateSettingsAvatarPreview(urlVal, document.getElementById('settingsFullName').value);
        });
      }

      // Remove avatar button handler
      var removeAvatarBtn = document.getElementById('removeAvatarBtn');
      if (removeAvatarBtn) {
        removeAvatarBtn.addEventListener('click', function() {
          currentAvatarUrl = '';
          updateSettingsAvatarPreview('', document.getElementById('settingsFullName').value);
          var urlInput = document.getElementById('settingsAvatarUrl');
          if (urlInput) urlInput.value = '';
        });
      }

      function renderChips(field) {
        var container = document.getElementById(field + 'Chips');
        if (!container) return;
        container.innerHTML = chipData[field].map(function(val, i) {
          return '<span class="chip">' + escapeHTML(val) + '<button type="button" class="chip-remove" onclick="removeChip(\'' + field + '\',' + i + ')" title="Remove">&times;</button></span>';
        }).join('');
      }

      function addChip(field) {
        var input = document.getElementById(field + 'Input');
        if (!input) return;
        var val = input.value.trim();
        if (!val) return;
        if (chipData[field].indexOf(val) !== -1) { input.value = ''; return; }
        chipData[field].push(val);
        input.value = '';
        input.focus();
        renderChips(field);
      }

      function removeChip(field, index) {
        chipData[field].splice(index, 1);
        renderChips(field);
      }

      // Allow Enter key to add chips
      ['affiliationInput', 'specialtyInput', 'experienceInput'].forEach(function(id) {
        var el = document.getElementById(id);
        if (el) {
          el.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
              e.preventDefault();
              addChip(id.replace('Input', ''));
            }
          });
        }
      });

      // Load Profile & MFA in Settings tab
      async function loadProfileSettings() {
        try {
          var resp = await fetch('/api/profile/get');
          var data = await resp.json();
          if (data.profile) {
            var p = data.profile;
            var fnEl = document.getElementById('settingsFullName');
            var emEl = document.getElementById('settingsEmail');
            var bioEl = document.getElementById('settingsBio');

            if (fnEl) fnEl.value = p.full_name || '';
            if (emEl) emEl.value = p.email || '';
            if (bioEl) bioEl.value = p.bio || '';

            // Avatar
            currentAvatarUrl = p.avatar_url || '';
            updateSettingsAvatarPreview(currentAvatarUrl, p.full_name || p.username);
            updateSidebarAvatar(currentAvatarUrl, p.full_name || p.username);

            // Load chips
            chipData.affiliation = Array.isArray(p.affiliation) ? p.affiliation : (p.affiliation ? [p.affiliation] : []);
            chipData.specialty = Array.isArray(p.specialty) ? p.specialty : (p.specialty ? [p.specialty] : []);
            chipData.experience = Array.isArray(p.experience) ? p.experience : (p.experience ? [p.experience] : []);

            renderChips('affiliation');
            renderChips('specialty');
            renderChips('experience');

            // MFA status
            updateMfaUIState(!!p.mfa_enabled);
          }
        } catch(err) {
          console.warn('Could not load profile settings:', err);
        }
      }

      // Profile Save Form
      var profileForm = document.getElementById('profileForm');
      if (profileForm) {
        profileForm.addEventListener('submit', async function(e) {
          e.preventDefault();
          var saveBtn = document.getElementById('saveProfileBtn');
          saveBtn.disabled = true;
          saveBtn.textContent = 'Saving...';

          var avatarVal = (currentAvatarUrl || (document.getElementById('settingsAvatarUrl') && document.getElementById('settingsAvatarUrl').value) || '').trim();

          try {
            var resp = await fetch('/api/profile/update', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                full_name: document.getElementById('settingsFullName').value.trim(),
                email: document.getElementById('settingsEmail').value.trim(),
                affiliation: chipData.affiliation,
                specialty: chipData.specialty,
                experience: chipData.experience,
                bio: document.getElementById('settingsBio').value.trim(),
                avatar_url: avatarVal
              })
            });
            var data = await resp.json();
            if (data.success) {
              showModalAlert('Profile Updated', 'Your profile details and credentials have been updated successfully!', 'success');
              showToast('Profile updated successfully!', 'success');
              try {
                var currentU = JSON.parse(sessionStorage.getItem('user') || '{}');
                currentU.full_name = document.getElementById('settingsFullName').value.trim();
                currentU.avatar_url = avatarVal;
                sessionStorage.setItem('user', JSON.stringify(currentU));
                document.getElementById('sideName').textContent = currentU.full_name;
                document.getElementById('artAuthor').value = currentU.full_name;
                updateSidebarAvatar(avatarVal, currentU.full_name);
              } catch(err) {}
            } else {
              showModalAlert('Update Failed', data.error || 'Could not update profile.', 'error');
              showToast(data.error || 'Could not update profile.', 'error');
            }
          } catch(err) {
            showModalAlert('Network Error', 'A network error occurred while updating profile: ' + err.message, 'error');
            showToast('Network error: ' + err.message, 'error');
          } finally {
            saveBtn.disabled = false;
            saveBtn.textContent = 'Save Profile Changes';
          }
        });
      }

      // Password Change Form
      var passwordForm = document.getElementById('passwordForm');
      if (passwordForm) {
        passwordForm.addEventListener('submit', async function(e) {
          e.preventDefault();
          var updateBtn = document.getElementById('updatePasswordBtn');
          updateBtn.disabled = true;
          updateBtn.textContent = 'Updating...';

          try {
            var resp = await fetch('/api/auth/change-password', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                currentPassword: document.getElementById('currentPassword').value,
                newPassword: document.getElementById('newPassword').value
              })
            });
            var data = await resp.json();
            if (data.success) {
              passwordForm.reset();
              showModalAlert('Password Changed', 'Your password has been changed successfully!', 'success');
              showToast('Password changed successfully!', 'success');
              try {
                var currentU = JSON.parse(sessionStorage.getItem('user') || '{}');
                delete currentU.force_password_change;
                sessionStorage.setItem('user', JSON.stringify(currentU));
              } catch(err) {}
            } else {
              showModalAlert('Password Change Failed', data.error || 'Failed to update password.', 'error');
              showToast(data.error || 'Failed to update password.', 'error');
            }
          } catch(err) {
            showModalAlert('Network Error', err.message, 'error');
            showToast('Network error: ' + err.message, 'error');
          } finally {
            updateBtn.disabled = false;
            updateBtn.textContent = 'Update Password';
          }
        });
      }

      // --- MFA Setup, Verify, Disable & Copy Helpers ---
      function updateMfaUIState(isActive) {
        var mfaActiveState = document.getElementById('mfaActiveState');
        var mfaInactiveState = document.getElementById('mfaInactiveState');
        var mfaActiveBadge = document.getElementById('mfaActiveBadge');
        var mfaSetup = document.getElementById('mfaSetup');
        if (mfaSetup) mfaSetup.style.display = 'none';

        if (isActive) {
          if (mfaActiveState) mfaActiveState.style.display = 'block';
          if (mfaInactiveState) mfaInactiveState.style.display = 'none';
          if (mfaActiveBadge) mfaActiveBadge.style.display = 'inline-flex';
        } else {
          if (mfaActiveState) mfaActiveState.style.display = 'none';
          if (mfaInactiveState) mfaInactiveState.style.display = 'block';
          if (mfaActiveBadge) mfaActiveBadge.style.display = 'none';
        }
      }

      function cancelMfaSetup() {
        var mfaSetup = document.getElementById('mfaSetup');
        if (mfaSetup) mfaSetup.style.display = 'none';
      }

      function copyMfaSecret(targetElementId, buttonElementId) {
        var secretText = document.getElementById(targetElementId) ? document.getElementById(targetElementId).textContent.trim() : '';
        if (!secretText) return;

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(secretText).then(function() {
            var btn = document.getElementById(buttonElementId);
            if (btn) {
              var oldHtml = btn.innerHTML;
              btn.innerHTML = '<span style="color:#10b981;">✓ Copied!</span>';
              setTimeout(function() { btn.innerHTML = oldHtml; }, 2500);
            }
            showToast('Secret key copied to clipboard!', 'success');
          }).catch(function() {
            showToast('Failed to copy. Please select and copy manually.', 'error');
          });
        }
      }

      async function setupTOTP() {
        var setupBox = document.getElementById('mfaSetup');
        var qrCodeContainer = document.getElementById('mfaQrCode');
        var secretEl = document.getElementById('mfaSecret');
        var codeInput = document.getElementById('totpCode');

        if (codeInput) codeInput.value = '';
        if (qrCodeContainer) qrCodeContainer.innerHTML = '<span style="color:#64748b;font-size:0.85rem;">Generating QR Code...</span>';
        if (setupBox) setupBox.style.display = 'block';

        try {
          var resp = await fetch('/api/auth/setup-totp', { method: 'POST' });
          var data = await resp.json();
          if (data.success) {
            if (secretEl) secretEl.textContent = data.secret;
            if (qrCodeContainer) {
              if (data.qrCodeSvg) {
                qrCodeContainer.innerHTML = data.qrCodeSvg;
                var svg = qrCodeContainer.querySelector('svg');
                if (svg) {
                  svg.setAttribute('width', '100%');
                  svg.setAttribute('height', '100%');
                  svg.style.display = 'block';
                }
              } else if (data.otpauthUrl) {
                var qrUrl = 'https://api.qrserver.com/v1/create-qr-code/?size=180x180&margin=4&data=' + encodeURIComponent(data.otpauthUrl);
                qrCodeContainer.innerHTML = '<img src="' + qrUrl + '" alt="2FA QR Code" width="180" height="180" style="display:block;border-radius:4px;" />';
              }
            }
            if (codeInput) codeInput.focus();
          } else {
            showModalAlert('Setup Error', data.error || 'Failed to initialize 2FA setup.', 'error');
            showToast(data.error || 'Failed to initialize 2FA.', 'error');
          }
        } catch(err) {
          showModalAlert('Network Error', 'Failed to connect to server: ' + err.message, 'error');
          showToast('Network error: ' + err.message, 'error');
        }
      }

      async function verifyTOTP() {
        var codeInput = document.getElementById('totpCode');
        var code = codeInput ? codeInput.value.trim() : '';
        var verifyBtn = document.getElementById('verifyMfaBtn');

        if (!code || code.length !== 6) {
          showModalAlert('Invalid Code', 'Please enter the 6-digit verification code from your authenticator app.', 'error');
          showToast('Please enter the 6-digit verification code.', 'error');
          if (codeInput) codeInput.focus();
          return;
        }

        if (verifyBtn) {
          verifyBtn.disabled = true;
          verifyBtn.textContent = 'Verifying...';
        }

        try {
          var resp = await fetch('/api/auth/verify-totp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ code: code })
          });
          var data = await resp.json();
          if (data.success) {
            showModalAlert('2FA Activated', 'Two-Factor Authentication is now active on your author account! Future logins will require an authenticator code.', 'success');
            showToast('Two-Factor Authentication successfully activated!', 'success');
            updateMfaUIState(true);
          } else {
            showModalAlert('Verification Failed', data.error || 'Invalid verification code. Please make sure your authenticator app time is synced.', 'error');
            showToast(data.error || 'Invalid verification code.', 'error');
          }
        } catch(err) {
          showModalAlert('Network Error', err.message, 'error');
          showToast('Network error: ' + err.message, 'error');
        } finally {
          if (verifyBtn) {
            verifyBtn.disabled = false;
            verifyBtn.textContent = 'Verify & Enable';
          }
        }
      }

      async function disableTOTP() {
        if (!confirm('Are you sure you want to disable Two-Factor Authentication? Your account will only be protected by your password.')) {
          return;
        }

        try {
          var resp = await fetch('/api/auth/disable-totp', { method: 'POST' });
          var data = await resp.json();
          if (data.success) {
            showToast('Two-Factor Authentication disabled.', 'info');
            showModalAlert('2FA Disabled', 'Two-Factor Authentication has been removed from your account.', 'info');
            updateMfaUIState(false);
          } else {
            showToast(data.error || 'Failed to disable 2FA.', 'error');
          }
        } catch(err) {
          showToast('Network error: ' + err.message, 'error');
        }
      }

      // --- Init ---
      if (user && user.role === 'reviewer') {
        loadAssignedReviews();
      } else {
        loadSubmissions();
      }
    </script>
  </slot>
</BaseLayout>
