              <input class="form-input" type="text" id="totpCode" placeholder="000000" maxlength="6" pattern="[0-9]*" inputmode="numeric" autocomplete="one-time-code" style="text-align:center;font-size:1.5rem;letter-spacing:8px;font-weight:800;padding:0.75rem;border-radius:10px;margin-bottom:1rem;font-family:monospace;" />
