              <p style="color:var(--muted);font-size:0.88rem;max-width:550px;margin:0 auto;line-height:1.5;">Open Google Authenticator, Microsoft Authenticator, Apple Passwords, Authy, or 1Password, and point your camera at the scan barcode below:</p>
            </div>

            <!-- QR Code Scan Barcode Card -->
            <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;margin-bottom:1.5rem;">
              <div class="qr-scan-box" style="width:200px;height:200px;min-width:200px;min-height:200px;">
                <div id="mfaQrCode" style="width:172px;height:172px;display:flex;align-items:center;justify-content:center;">
                  <span style="color:#64748b;font-size:0.85rem;">Generating QR Code...</span>
                </div>
                <div class="qr-scan-line"></div>
              </div>
              <div style="display:flex;align-items:center;gap:0.4rem;color:var(--muted);font-size:0.8rem;margin-top:0.75rem;">
                <span>📷 Scan with Authenticator Camera Bar</span>
