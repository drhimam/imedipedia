                <div class="upload-sublabel">JPEG, PNG, WEBP, AVIF (Max 1MB)</div>
                <input type="file" id="coverFileInput" accept="image/jpeg,image/png,image/webp,image/avif" style="display: none;" />
                <div class="image-preview-container" id="coverPreviewContainer"><img src="" class="image-preview" id="coverImagePreview" alt="Cover preview" /><button type="button" class="clear-img-btn" id="coverClearBtn">&times;</button></div>
              </div>
              <div class="image-upload-fields">
                <div class="form-group" style="margin-bottom:0.5rem;"><input type="text" id="coverImageUrl" class="form-input" placeholder="Or paste Image URL (e.g. https://... or /images/...)" style="padding:0.6rem 0.75rem;font-size:0.85rem;" /></div>
                <div class="form-group" style="margin-bottom:0.5rem;"><input type="text" id="coverImageName" class="form-input" placeholder="Image name (alt text)" style="padding:0.6rem 0.75rem;font-size:0.85rem;" /></div>
