            <!-- Manual Key Fallback -->
            <div style="background:var(--card-bg);border:1px solid var(--border);border-radius:12px;padding:1.25rem;max-width:520px;margin:0 auto 1.5rem auto;">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem;">
                <span style="font-size:0.78rem;font-weight:700;text-transform:uppercase;color:var(--muted);letter-spacing:0.5px;">Or Enter Secret Key Manually</span>
                <button type="button" id="copySecretBtn" onclick="copyMfaSecret('mfaSecret', 'copySecretBtn')" style="background:transparent;border:none;color:var(--accent);font-size:0.82rem;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:0.3rem;">
                  <span>📋 Copy Key</span>
                </button>
              </div>
              <div id="mfaSecret" style="font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:1.1rem;letter-spacing:2px;text-align:center;word-break:break-all;color:var(--accent);font-weight:800;background:rgba(0,0,0,0.15);padding:0.75rem;border-radius:8px;user-select:all;"></div>
            </div>

            <!-- Verification Code Step -->
