---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contributor Dashboard - iMedipedia"
  currentPage="contributors"
>
  <slot name="head">
    <style>
      .dashboard-container { max-width: 1200px; width: 100%; margin: 2rem auto; padding: 0 1.5rem; box-sizing: border-box; display: grid; grid-template-columns: 280px 1fr; gap: 2.5rem; flex-grow: 1; }
      .sidebar { display: flex; flex-direction: column; gap: 1.5rem; }
      .user-profile-summary { background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; padding: 1.5rem; text-align: center; }
      .avatar { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent); margin-bottom: 1rem; }
      .profile-name { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 1.1rem; margin: 0 0 0.25rem 0; }
      .profile-role { font-size: 0.75rem; color: var(--accent); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
      .tab-menu { background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem; }
      .tab-btn { background: transparent; border: none; color: var(--text); text-align: left; padding: 0.75rem 1rem; border-radius: 8px; cursor: pointer; font-size: 0.95rem; font-weight: 600; display: flex; align-items: center; gap: 0.75rem; transition: all 0.2s ease; }
      .tab-btn:hover { background: rgba(99, 102, 241, 0.08); color: var(--accent); }
      .tab-btn.active { background: var(--accent); color: #ffffff; }
      .main-content { background: var(--card-bg); border: 1px solid var(--border); border-radius: 20px; padding: 2.5rem; box-shadow: 0 4px 30px rgba(0, 0, 0, 0.03); min-height: 500px; }
      .tab-panel { display: none; }
      .tab-panel.active { display: block; animation: fadeIn2 0.3s ease-out; }
      @keyframes fadeIn2 { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
      .panel-title { font-family: 'Outfit', sans-serif; font-size: 2rem; font-weight: 800; margin-top: 0; margin-bottom: 0.5rem; letter-spacing: -0.5px; }
      .panel-desc { color: var(--muted); font-size: 0.95rem; margin-bottom: 2rem; }
      .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 2.5rem; }
      .stat-card { background: rgba(0, 0, 0, 0.15); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; text-align: center; }
      :global([data-theme="light"]) .stat-card { background: rgba(255, 255, 255, 0.5); }
      .stat-val { font-family: 'Outfit', sans-serif; font-size: 2.5rem; font-weight: 800; color: var(--accent); line-height: 1; margin-bottom: 0.5rem; }
      .stat-label { font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--muted); letter-spacing: 0.5px; }
      .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
      .form-group { margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem; }
      .form-group.full-width { grid-column: 1 / -1; }
      .form-label { font-size: 0.85rem; font-weight: 600; text-transform: uppercase; color: var(--muted); letter-spacing: 0.5px; }
      .form-input { padding: 0.8rem 1rem; border-radius: 8px; border: 1px solid var(--border); background: rgba(0, 0, 0, 0.15); color: var(--text); font-size: 0.95rem; transition: border-color 0.2s, background-color 0.2s; box-sizing: border-box; width: 100%; }
      :global([data-theme="light"]) .form-input { background: rgba(255, 255, 255, 0.8); }
      .form-input:focus { outline: none; border-color: var(--accent); background: rgba(0, 0, 0, 0.25); }
      :global([data-theme="light"]) .form-input:focus { background: #ffffff; }
      .upload-zone { border: 2px dashed var(--border); border-radius: 12px; padding: 2.5rem; text-align: center; background: rgba(0, 0, 0, 0.1); cursor: pointer; transition: all 0.2s ease; position: relative; }
      .upload-zone.dragover { border-color: var(--accent); background: var(--accent-glow); }
      .upload-icon { font-size: 2rem; margin-bottom: 0.75rem; color: var(--muted); display: block; }
      .upload-label { font-weight: 600; font-size: 0.95rem; margin-bottom: 0.25rem; }
      .upload-sublabel { font-size: 0.8rem; color: var(--muted); }
      .image-preview-container { display: none; flex-direction: column; align-items: center; position: relative; margin-top: 1rem; }
      .image-preview { max-width: 100%; max-height: 200px; border-radius: 8px; border: 1px solid var(--border); object-fit: cover; }
      .clear-img-btn { position: absolute; top: 0.5rem; right: 0.5rem; background: rgba(3, 7, 18, 0.8); border: none; color: white; border-radius: 50%; width: 30px; height: 30px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1rem; font-weight: bold; }
      .progress-container { display: none; width: 100%; background-color: var(--border); border-radius: 4px; margin-top: 1rem; height: 6px; overflow: hidden; }
      .progress-bar { width: 0%; height: 100%; background-color: var(--accent); transition: width 0.1s ease; }
      .btn { background: var(--accent); color: #ffffff; border: none; padding: 0.85rem 1.75rem; font-size: 0.95rem; font-weight: 700; border-radius: 8px; cursor: pointer; transition: all 0.2s ease; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; }
      .btn:hover { transform: translateY(-2px); box-shadow: 0 4px 12px var(--accent-glow); }
      .btn-secondary { background: transparent; border: 1px solid var(--border); color: var(--text); }
      .btn-secondary:hover { background: rgba(99, 102, 241, 0.08); }
      .table-container { overflow-x: auto; border-radius: 12px; border: 1px solid var(--border); }
      .submissions-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.95rem; }
      .submissions-table th { background: rgba(0, 0, 0, 0.2); padding: 1rem 1.25rem; font-weight: 700; color: var(--muted); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.5px; border-bottom: 1px solid var(--border); }
      :global([data-theme="light"]) .submissions-table th { background: rgba(0, 0, 0, 0.02); }
      .submissions-table td { padding: 1.25rem; border-bottom: 1px solid var(--border); }
      .submissions-table tr:last-child td { border-bottom: none; }
      .status-badge { display: inline-flex; align-items: center; padding: 0.25rem 0.65rem; border-radius: 12px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; }
      .status-approved { background: var(--success-glow); color: var(--success); }
      .status-review { background: var(--warning-glow); color: var(--warning); }
      .alert { display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.25rem; border-radius: 8px; margin-bottom: 1.5rem; font-size: 0.95rem; font-weight: 500; border: 1px solid; animation: scaleIn3 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
      .alert-success { background: var(--success-glow); color: var(--success); border-color: rgba(16, 185, 129, 0.2); }
      @keyframes scaleIn3 { from { transform: scale(0); opacity: 0; } to { transform: scale(1); opacity: 1; } }
      @media (max-width: 900px) { .dashboard-container { grid-template-columns: 1fr; gap: 1.5rem; } }
      @media (max-width: 768px) { .form-grid { grid-template-columns: 1fr; gap: 1rem; } }
      @media (max-width: 600px) { .main-content { padding: 1.5rem; } .stats-grid { grid-template-columns: 1fr; gap: 1rem; } }
    </style>
  </slot>

  <div class="dashboard-container">
    <aside class="sidebar">
      <div class="user-profile-summary">
        <img id="sideAvatar" src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&q=80&w=300" alt="Dr. Eleanor Vance" class="avatar" />
        <h3 id="sideName" class="profile-name">Dr. Eleanor Vance</h3>
        <span class="profile-role">Registered Editor</span>
      </div>
      <div class="tab-menu">
        <button class="tab-btn active" data-tab="overview">📊 Overview</button>
        <button class="tab-btn" data-tab="submit">✍️ Submit Article</button>
        <button class="tab-btn" data-tab="submissions">🗂️ My Submissions</button>
        <button class="tab-btn" data-tab="profile">👤 My Profile</button>
      </div>
    </aside>

    <main class="main-content">
      <div id="alertBox" style="display: none;"></div>

      <div id="overviewPanel" class="tab-panel active">
        <h2 class="panel-title">Dashboard Overview</h2>
        <p class="panel-desc">Welcome back to your clinical publishing hub. Monitor drafts, review comments, and submit new research abstracts.</p>
        <div class="stats-grid">
          <div class="stat-card"><div class="stat-val" id="statTotal">2</div><div class="stat-label">Total Submissions</div></div>
          <div class="stat-card"><div class="stat-val" id="statApproved">2</div><div class="stat-label">Approved & Live</div></div>
          <div class="stat-card"><div class="stat-val" id="statReview">0</div><div class="stat-label">In Peer Review</div></div>
        </div>
        <div style="background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem;">
          <h3 style="font-family: 'Outfit', sans-serif; margin-top: 0; margin-bottom: 0.5rem;">Editorial Announcements</h3>
          <p style="margin: 0; color: var(--muted); font-size: 0.95rem; line-height: 1.5;">We are currently welcoming papers for the upcoming September Special Issue on RNA therapeutics. Ensure all submissions include validated clinical trial identifiers.</p>
        </div>
      </div>

      <div id="submitPanel" class="tab-panel">
        <h2 class="panel-title">Submit Research Article</h2>
        <p class="panel-desc">Fill in the clinical details and outline. Upload an associated medical graphic or illustration.</p>
        <form id="articleForm" class="form-grid">
          <div class="form-group full-width"><label for="artTitle" class="form-label">Article Title</label><input type="text" id="artTitle" class="form-input" placeholder="e.g., Efficacy of RNA Therapeutics on Glioblastoma Reoccurrence" required /></div>
          <div class="form-group"><label for="artTag" class="form-label">Specialty Tag</label><input type="text" id="artTag" class="form-input" placeholder="e.g., Oncology, Neurology, Genomics" required /></div>
          <div class="form-group"><label for="artDesc" class="form-label">Short Description / Abstract Summary</label><input type="text" id="artDesc" class="form-input" placeholder="e.g., A phase I study on vaccine vectors..." required /></div>
          <div class="form-group full-width">
            <label class="form-label">Article Cover Image</label>
            <div id="dropZone" class="upload-zone">
              <span class="upload-icon">📁</span>
              <div class="upload-label">Drag & drop cover image, or <span style="color: var(--accent); text-decoration: underline;">browse files</span></div>
              <div class="upload-sublabel">Supports JPEG, PNG, WEBP (Max 5MB)</div>
              <input type="file" id="fileInput" accept="image/*" style="display: none;" />
              <div class="progress-container" id="progressContainer"><div class="progress-bar" id="progressBar"></div></div>
              <div class="image-preview-container" id="previewContainer"><img src="" class="image-preview" id="imagePreview" alt="Upload preview" /><button type="button" class="clear-img-btn" id="clearImgBtn">&times;</button></div>
            </div>
          </div>
          <div class="form-group full-width"><label for="artContent" class="form-label">Article Content (Markdown Supported)</label><textarea id="artContent" class="form-input" style="min-height: 220px; resize: vertical; font-family: inherit;" placeholder="Write your full publication content, clinical methods, and results here..." required></textarea></div>
          <div class="form-group full-width" style="margin-top: 1rem;"><button type="submit" class="btn">Submit Article for Review</button></div>
        </form>
      </div>

      <div id="submissionsPanel" class="tab-panel">
        <h2 class="panel-title">My Submitted Articles</h2>
        <p class="panel-desc">Review and manage status tracking of your clinical article drafts.</p>
        <div class="table-container">
          <table class="submissions-table">
            <thead><tr><th>Article Title</th><th>Specialty</th><th>Submitted Date</th><th>Status</th></tr></thead>
            <tbody id="submissionsTableBody">
              <tr><td style="font-weight: 600;">CRISPR-Cas9 Gene Therapy Cure for Sickle Cell Disease</td><td>Genomics</td><td>Aug 9, 2026</td><td><span class="status-badge status-approved">Approved</span></td></tr>
              <tr><td style="font-weight: 600;">Breakthrough Immunotherapy for Glioblastoma</td><td>Oncology</td><td>Aug 9, 2026</td><td><span class="status-badge status-approved">Approved</span></td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div id="profilePanel" class="tab-panel">
        <h2 class="panel-title">Edit Contributor Profile</h2>
        <p class="panel-desc">Manage your bio, credentials, specialty, and profile picture displayed in the gallery.</p>
        <form id="profileForm" class="form-grid">
          <div class="form-group"><label for="profName" class="form-label">Full Name & Title</label><input type="text" id="profName" class="form-input" value="Dr. Eleanor Vance" required /></div>
          <div class="form-group"><label for="profAffiliation" class="form-label">Affiliation</label><input type="text" id="profAffiliation" class="form-input" value="iMedipedia Institute of Clinical Genetics" required /></div>
          <div class="form-group"><label for="profSpecialty" class="form-label">Specialty Field</label><input type="text" id="profSpecialty" class="form-input" value="Genomics & Oncology" required /></div>
          <div class="form-group"><label for="profAvatar" class="form-label">Avatar Profile URL</label><input type="url" id="profAvatar" class="form-input" value="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&q=80&w=300" required /></div>
          <div class="form-group full-width"><label for="profBio" class="form-label">Professional Biography</label><textarea id="profBio" class="form-input" style="min-height: 100px; resize: vertical; font-family: inherit;" required>Dr. Eleanor Vance is a leading researcher in clinical genetics and cancer immunotherapies. She leads the genomic sequencing division at the iMedipedia Institute, focusing on CRISPR therapeutics and personalized vaccines.</textarea></div>
          <div class="form-group full-width" style="margin-top: 1rem;"><button type="submit" class="btn">Submit Profile Updates</button></div>
        </form>
      </div>
    </main>
  </div>

  <slot name="scripts">
    <script is:inline>
      // Tabs switching
      var tabBtns = document.querySelectorAll('.tab-btn');
      var tabPanels = document.querySelectorAll('.tab-panel');
      tabBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          tabBtns.forEach(function(b) { b.classList.remove('active'); });
          tabPanels.forEach(function(p) { p.classList.remove('active'); });
          btn.classList.add('active');
          document.getElementById(btn.getAttribute('data-tab') + 'Panel').classList.add('active');
        });
      });

      // Alert helper
      var alertBox = document.getElementById('alertBox');
      function showAlert(message, type) {
        type = type || 'success';
        alertBox.innerHTML = '<div class="alert alert-' + type + '">&#10003; ' + message + '</div>';
        alertBox.style.display = 'block';
        window.scrollTo({ top: 0, behavior: 'smooth' });
        setTimeout(function() { alertBox.style.display = 'none'; }, 5000);
      }

      // Upload Zone
      var dropZone = document.getElementById('dropZone');
      var fileInput = document.getElementById('fileInput');
      var progressContainer = document.getElementById('progressContainer');
      var progressBar = document.getElementById('progressBar');
      var previewContainer = document.getElementById('previewContainer');
      var imagePreview = document.getElementById('imagePreview');
      var clearImgBtn = document.getElementById('clearImgBtn');

      dropZone.addEventListener('click', function(e) { if (e.target !== clearImgBtn && !previewContainer.contains(e.target)) fileInput.click(); });
      dropZone.addEventListener('dragover', function(e) { e.preventDefault(); dropZone.classList.add('dragover'); });
      dropZone.addEventListener('dragleave', function() { dropZone.classList.remove('dragover'); });
      dropZone.addEventListener('drop', function(e) { e.preventDefault(); dropZone.classList.remove('dragover'); if (e.dataTransfer.files.length) handleFile(e.dataTransfer.files[0]); });
      fileInput.addEventListener('change', function() { if (fileInput.files.length) handleFile(fileInput.files[0]); });

      function handleFile(file) {
        if (!file.type.startsWith('image/')) { alert('Only image files are allowed!'); return; }
        progressContainer.style.display = 'block';
        progressBar.style.width = '0%';
        var width = 0;
        var interval = setInterval(function() {
          if (width >= 100) {
            clearInterval(interval);
            progressContainer.style.display = 'none';
            var reader = new FileReader();
            reader.onload = function(e) { imagePreview.src = e.target.result; previewContainer.style.display = 'flex'; };
            reader.readAsDataURL(file);
          } else { width += 20; progressBar.style.width = width + '%'; }
        }, 100);
      }
      clearImgBtn.addEventListener('click', function(e) { e.stopPropagation(); fileInput.value = ''; imagePreview.src = ''; previewContainer.style.display = 'none'; });

      // Stats
      var submissionsCount = 2;
      var reviewCount = 0;

      // Article Form
      var articleForm = document.getElementById('articleForm');
      var submissionsTableBody = document.getElementById('submissionsTableBody');
      var statTotal = document.getElementById('statTotal');
      var statReview = document.getElementById('statReview');

      articleForm.addEventListener('submit', function(e) {
        e.preventDefault();
        var title = document.getElementById('artTitle').value;
        var tag = document.getElementById('artTag').value;
        var row = document.createElement('tr');
        row.innerHTML = '<td style="font-weight: 600;">' + title + '</td><td>' + tag + '</td><td>' + new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) + '</td><td><span class="status-badge status-review">In Review</span></td>';
        submissionsTableBody.prepend(row);
        submissionsCount++; reviewCount++;
        statTotal.textContent = submissionsCount;
        statReview.textContent = reviewCount;
        articleForm.reset();
        previewContainer.style.display = 'none';
        imagePreview.src = '';
        showAlert('Article submitted successfully for peer review!');
        setTimeout(function() { document.querySelector('[data-tab="submissions"]').click(); }, 1000);
      });

      // Profile Form
      var profileForm = document.getElementById('profileForm');
      var sideAvatar = document.getElementById('sideAvatar');
      var sideName = document.getElementById('sideName');
      profileForm.addEventListener('submit', function(e) {
        e.preventDefault();
        sideAvatar.src = document.getElementById('profAvatar').value;
        sideName.textContent = document.getElementById('profName').value;
        showAlert('Profile information updated successfully!');
      });
    </script>
  </slot>
</BaseLayout>
