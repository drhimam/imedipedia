---
// Contributor Account Settings — password change, MFA setup
import BaseLayout from '../../layouts/BaseLayout.astro';
const SITE_TITLE = "Account Settings";
---

<BaseLayout title={SITE_TITLE}>
  <main style="max-width:640px;margin:3rem auto;padding:0 1.5rem;">
    <div style="text-align:center;margin-bottom:2.5rem;">
      <h1 style="font-family:'Outfit',sans-serif;font-size:2rem;font-weight:800;">Account Settings</h1>
      <p style="color:var(--muted);">Manage your password and security</p>
    </div>

    <div id="alertBox" class="alert" style="display:none;margin-bottom:1rem;"></div>

    <!-- Profile Section -->
    <section style="border:1px solid var(--border);border-radius:16px;padding:2rem;margin-bottom:1.5rem;">
      <h2 style="font-family:'Outfit',sans-serif;font-size:1.3rem;font-weight:700;margin-bottom:1.25rem;">Profile</h2>
      <form id="profileForm" style="display:flex;flex-direction:column;gap:1rem;">
        <div class="form-group">
          <label class="form-label" for="settingsFullName">Full Name</label>
          <input class="form-input" type="text" id="settingsFullName" placeholder="Your full name">
        </div>
        <div class="form-group">
          <label class="form-label" for="settingsEmail">Email</label>
          <input class="form-input" type="email" id="settingsEmail" placeholder="your@email.com">
        </div>
        <div class="form-group" id="affiliationGroup">
          <label class="form-label">Affiliation</label>
          <div class="chip-container" id="affiliationChips"></div>
          <div class="chip-input-row">
            <input class="form-input chip-input" type="text" id="affiliationInput" placeholder="Add hospital, institution, or organization">
            <button type="button" class="chip-add-btn" onclick="addChip('affiliation')">＋ Add</button>
          </div>
        </div>
        <div class="form-group" id="specialtyGroup">
          <label class="form-label">Specialty</label>
          <div class="chip-container" id="specialtyChips"></div>
          <div class="chip-input-row">
            <input class="form-input chip-input" type="text" id="specialtyInput" placeholder="Add medical specialty">
            <button type="button" class="chip-add-btn" onclick="addChip('specialty')">＋ Add</button>
          </div>
        </div>
        <div class="form-group" id="experienceGroup">
          <label class="form-label">Experience</label>
          <div class="chip-container" id="experienceChips"></div>
          <div class="chip-input-row">
            <input class="form-input chip-input" type="text" id="experienceInput" placeholder="Add work experience or position">
            <button type="button" class="chip-add-btn" onclick="addChip('experience')">＋ Add</button>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label" for="settingsBio">Bio</label>
          <textarea class="form-input" id="settingsBio" placeholder="Short bio..." rows="3" style="font-family:inherit;width:100%;box-sizing:border-box;"></textarea>
        </div>
        <button type="submit" class="btn">Save Profile</button>
      </form>
    </section>

    <!-- Password Change -->
    <section style="border:1px solid var(--border);border-radius:16px;padding:2rem;margin-bottom:1.5rem;">
      <h2 style="font-family:'Outfit',sans-serif;font-size:1.3rem;font-weight:700;margin-bottom:1.25rem;">Change Password</h2>
      <form id="passwordForm" style="display:flex;flex-direction:column;gap:1rem;">
        <div class="form-group">
          <label class="form-label" for="currentPassword">Current Password</label>
          <input class="form-input" type="password" id="currentPassword" required autocomplete="current-password">
        </div>
        <div class="form-group">
          <label class="form-label" for="newPassword">New Password (min 8 characters)</label>
          <input class="form-input" type="password" id="newPassword" required minlength="8" autocomplete="new-password">
        </div>
        <button type="submit" class="btn">Update Password</button>
      </form>
    </section>

    <!-- MFA Setup -->
    <section style="border:1px solid var(--border);border-radius:16px;padding:2rem;">
      <h2 style="font-family:'Outfit',sans-serif;font-size:1.3rem;font-weight:700;margin-bottom:1.25rem;">Two-Factor Authentication (MFA)</h2>
      <p id="mfaStatus" style="color:var(--muted);margin-bottom:1rem;">Checking MFA status...</p>
      <div id="mfaSetup" style="display:none;">
        <p style="color:var(--muted);margin-bottom:1rem;">Use an authenticator app (Google Authenticator, Authy, etc.) to scan the setup key or enter it manually.</p>
        <div id="mfaSecret" style="background:rgba(0,0,0,0.1);padding:1rem;border-radius:8px;font-family:monospace;font-size:1.1rem;text-align:center;margin-bottom:1rem;word-break:break-all;"></div>
        <div class="form-group" style="margin-bottom:1rem;">
          <label class="form-label" for="totpCode">Verification Code</label>
          <input class="form-input" type="text" id="totpCode" placeholder="6-digit code" maxlength="6" autocomplete="one-time-code">
        </div>
        <button class="btn" onclick="verifyTOTP()">Verify & Enable MFA</button>
      </div>
      <button id="setupMfaBtn" class="btn btn-secondary" onclick="setupTOTP()" style="display:none;">Set Up MFA</button>
    </section>

    <p style="text-align:center;margin-top:1.5rem;font-size:0.85rem;">
      <a href="/contributors/dashboard" style="color:var(--accent);text-decoration:none;">← Back to Dashboard</a>
    </p>
  </main>
</BaseLayout>

<style>
  .form-group { display: flex; flex-direction: column; gap: 0.5rem; }
  .form-label { font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); }
  .form-input { padding: 0.75rem 1rem; border-radius: 8px; border: 1px solid var(--border); background: rgba(0,0,0,0.1); color: var(--text); font-size: 0.95rem; }
  :global([data-theme="light"]) .form-input { background: rgba(255,255,255,0.8); }
  .form-input:focus { outline: none; border-color: var(--accent); }
  /* Chip styles for multi-value fields */
  .chip-container { display: flex; flex-wrap: wrap; gap: 0.5rem; min-height: 0; }
  .chip { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.6rem; background: var(--accent); color: #fff; border-radius: 20px; font-size: 0.85rem; font-weight: 500; animation: chipIn 0.2s ease-out; }
  @keyframes chipIn { from { transform: scale(0.8); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  .chip-remove { background: transparent; border: none; color: rgba(255,255,255,0.8); cursor: pointer; font-size: 1rem; line-height: 1; padding: 0; width: 18px; height: 18px; border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: all 0.15s; }
  .chip-remove:hover { color: #fff; background: rgba(255,255,255,0.2); }
  .chip-input-row { display: flex; gap: 0.5rem; margin-top: 0.25rem; }
  .chip-input { flex: 1; min-width: 0; }
  .chip-add-btn { padding: 0.6rem 0.8rem; border-radius: 8px; border: 1px dashed var(--border); background: transparent; color: var(--accent); cursor: pointer; font-size: 0.85rem; font-weight: 600; white-space: nowrap; transition: all 0.15s; font-family: inherit; }
  .chip-add-btn:hover { background: var(--accent); color: #fff; border-color: var(--accent); }
  .btn { background: var(--accent); color: #fff; border: none; padding: 0.75rem 1.25rem; font-size: 0.95rem; font-weight: 700; border-radius: 8px; cursor: pointer; }
  .btn:hover { opacity: 0.9; }
  .btn-secondary { background: transparent; border: 1px solid var(--accent); color: var(--accent); }
  .btn-secondary:hover { background: var(--accent); color: white; }
  .alert { padding: 0.75rem 1rem; border-radius: 8px; font-size: 0.9rem; }
  .alert-error { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #ef4444; }
  .alert-success { background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3); color: #10b981; }
</style>

<script is:inline>
  // --- Chip management for multi-value fields ---
  const chipData = { affiliation: [], specialty: [], experience: [] };

  function renderChips(field) {
    const container = document.getElementById(field + 'Chips');
    container.innerHTML = chipData[field].map((val, i) =>
      `<span class="chip">${escHTML(val)}<button type="button" class="chip-remove" onclick="removeChip('${field}',${i})" title="Remove">&times;</button></span>`
    ).join('');
  }

  function addChip(field) {
    const input = document.getElementById(field + 'Input');
    const val = input.value.trim();
    if (!val) return;
    if (chipData[field].includes(val)) { input.value = ''; return; } // no duplicates
    chipData[field].push(val);
    input.value = '';
    input.focus();
    renderChips(field);
  }

  function removeChip(field, index) {
    chipData[field].splice(index, 1);
    renderChips(field);
  }

  // Allow Enter key to add chips
  ['affiliationInput','specialtyInput','experienceInput'].forEach(function(id) {
    var el = document.getElementById(id);
    if (el) {
      el.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') { e.preventDefault(); addChip(id.replace('Input','')); }
      });
    }
  });

  function escHTML(str) {
    var d = document.createElement('div');
    d.textContent = str || '';
    return d.innerHTML;
  }

  // Check MFA and profile status on load
  async function checkProfile() {
    try {
      const resp = await fetch('/api/profile/get');
      const data = await resp.json();
      if (data.profile) {
        // Pre-fill profile form
        document.getElementById('settingsFullName').value = data.profile.full_name || '';
        document.getElementById('settingsEmail').value = data.profile.email || '';
        document.getElementById('settingsBio').value = data.profile.bio || '';
        // Load chips
        chipData.affiliation = Array.isArray(data.profile.affiliation) ? data.profile.affiliation : [];
        chipData.specialty = Array.isArray(data.profile.specialty) ? data.profile.specialty : [];
        chipData.experience = Array.isArray(data.profile.experience) ? data.profile.experience : [];
        renderChips('affiliation');
        renderChips('specialty');
        renderChips('experience');
        // MFA status
        if (data.profile.mfa_enabled) {
          document.getElementById('mfaStatus').textContent = '✅ MFA is enabled on your account.';
          document.getElementById('setupMfaBtn').style.display = 'none';
          document.getElementById('mfaSetup').style.display = 'none';
        } else {
          document.getElementById('mfaStatus').textContent = 'MFA is not set up. Add an extra layer of security.';
          document.getElementById('setupMfaBtn').style.display = 'inline-block';
        }
      } else {
        window.location.href = '/contributors';
      }
    } catch {
      window.location.href = '/contributors';
    }
  }
  checkProfile();

  // Profile save
  document.getElementById('profileForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const alertBox = document.getElementById('alertBox');
    try {
      const resp = await fetch('/api/profile/update', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({
          full_name: document.getElementById('settingsFullName').value,
          email: document.getElementById('settingsEmail').value,
          affiliation: chipData.affiliation,
          specialty: chipData.specialty,
          experience: chipData.experience,
          bio: document.getElementById('settingsBio').value,
        })
      });
      const data = await resp.json();
      alertBox.textContent = data.message || data.error;
      alertBox.className = data.success ? 'alert alert-success' : 'alert alert-error';
      alertBox.style.display = 'block';
      if (data.success) {
        // Update sessionStorage with new profile data
        try {
          var userData = JSON.parse(sessionStorage.getItem('user') || '{}');
          userData.full_name = document.getElementById('settingsFullName').value;
          sessionStorage.setItem('user', JSON.stringify(userData));
        } catch(e) {}
      }
    } catch (err) {
      alertBox.textContent = 'Network error.';
      alertBox.className = 'alert alert-error';
      alertBox.style.display = 'block';
    }
  });

  // Password change
  document.getElementById('passwordForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const currentPassword = document.getElementById('currentPassword').value;
    const newPassword = document.getElementById('newPassword').value;
    const alertBox = document.getElementById('alertBox');

    try {
      const resp = await fetch('/api/auth/change-password', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ currentPassword, newPassword })
      });
      const data = await resp.json();
      alertBox.textContent = data.message || data.error;
      alertBox.className = data.success ? 'alert alert-success' : 'alert alert-error';
      alertBox.style.display = 'block';
      if (data.success) document.getElementById('passwordForm').reset();
    } catch (err) {
      alertBox.textContent = 'Network error.';
      alertBox.className = 'alert alert-error';
      alertBox.style.display = 'block';
    }
  });

  // MFA Setup
  async function setupTOTP() {
    try {
      const resp = await fetch('/api/auth/setup-totp', { method: 'POST' });
      const data = await resp.json();
      if (data.success) {
        document.getElementById('mfaSecret').textContent = data.secret;
        document.getElementById('mfaSetup').style.display = 'block';
        document.getElementById('setupMfaBtn').style.display = 'none';
      }
    } catch { }
  }

  // MFA Verify
  async function verifyTOTP() {
    const code = document.getElementById('totpCode').value;
    const alertBox = document.getElementById('alertBox');
    try {
      const resp = await fetch('/api/auth/verify-totp', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ code })
      });
      const data = await resp.json();
      if (data.success) {
        alertBox.textContent = 'MFA enabled successfully!';
        alertBox.className = 'alert alert-success';
        alertBox.style.display = 'block';
        document.getElementById('mfaSetup').style.display = 'none';
        document.getElementById('mfaStatus').textContent = '✅ MFA is enabled on your account.';
      } else {
        alertBox.textContent = data.error || 'Invalid code.';
        alertBox.className = 'alert alert-error';
        alertBox.style.display = 'block';
      }
    } catch { }
  }
</script>
