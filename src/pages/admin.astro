    var container = document.getElementById('adminEditExamChips');
    container.innerHTML = adminEditSelectedExams.map(function(name, i) {
      return '<span class="chip">' + esc(name) + '<button type="button" class="chip-remove" onclick="removeAdminEditExam(' + i + ')" title="Remove">&times;</button></span>';
    }).join('');
  }

  function addAdminEditExam(name) {
    if (adminEditSelectedExams.indexOf(name) === -1) {
      adminEditSelectedExams.push(name);
      renderAdminEditExamChips();
