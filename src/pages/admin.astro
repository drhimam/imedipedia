    if (index >= 0) {
      adminSubjects[index] = { name: name, parent: parent || undefined };
    } else {
      adminSubjects.push({ name: name, parent: parent || undefined });
    }

    // Sort by parent then name
    adminSubjects.sort(function(a, b) {
      var pa = (a.parent || '').toLowerCase();
      var pb = (b.parent || '').toLowerCase();
      if (pa !== pb) return pa < pb ? -1 : 1;
      return a.name.toLowerCase() < b.name.toLowerCase() ? -1 : 1;
    });

    cancelSubjectEdit();
    renderSubjectsTable();
    refreshParentList();
