  async function loadUsers() {
    const container = document.getElementById('usersTable');
    
    if (!document.getElementById('userControls')) {
      const controls = document.createElement('div');
      controls.id = 'userControls';
      controls.className = 'table-controls';
      controls.innerHTML = `
        <input type="text" id="userSearch" class="table-search" placeholder="Search users..." value="${esc(currentUserSearch)}" onkeyup="if(event.key==='Enter') handleUserSearch()">
        <button class="btn btn-sm" onclick="openEmailModal('all')">✉️ Email All Contributors</button>
      `;
      container.parentElement.insertBefore(controls, container);
    }

    container.innerHTML = '<p style="color:var(--muted);">Loading...</p>';
    try {
      const params = new URLSearchParams();
      if (currentUserSearch) params.set('q', currentUserSearch);
      params.set('page', currentUserPage);
      params.set('limit', 10);

      const resp = await fetch('/api/admin/users?' + params.toString());
      const data = await resp.json();
      
      if (!data.users?.length) {
        container.innerHTML = '<p style="color:var(--muted);">No users found.</p>';
        return;
      }
      
      const p = data.pagination || { totalPages: 1, page: 1 };
      
      let html = `<table class="data-table"><thead><tr>
        <th>Username</th><th>Full Name</th><th>Email</th><th>Role</th><th>MFA</th><th>Actions</th>
      </tr></thead><tbody>`;
      
      data.users.forEach(u => {
        let uDataStr = encodeURIComponent(JSON.stringify(u));
        html += `
        <tr>
          <td><strong>${esc(u.username)}</strong></td>
          <td>${esc(u.full_name || '')}</td>
          <td>${esc(u.email || '')}</td>
          <td><span class="badge badge-pending">${esc(u.role)}</span></td>
          <td>${u.mfa_enabled ? '✅' : '❌'}</td>
          <td>
            <div class="dropdown">
              <button onclick="toggleDropdown('user-drop-${u.id}')" class="dropdown-btn">⋮</button>
              <div id="user-drop-${u.id}" class="dropdown-content">
                <button onclick="openEmailModal('${esc(u.email)}')">✉️ Send Email</button>
                <button onclick="downloadUserAsText('${uDataStr}')">📄 Download Text</button>
                <button onclick="downloadUserAsPdf('${uDataStr}')">📑 Download PDF</button>
                <button onclick="deleteUser('${u.id}', '${esc(u.username)}')">🗑 Delete</button>
              </div>
            </div>
          </td>
        </tr>`;
      });
      html += `</tbody></table>`;
      
      html += `<div class="pagination-ctrl">
        <button class="page-btn" onclick="changeUserPage(-1)" ${p.page <= 1 ? 'disabled' : ''}>&larr; Prev</button>
        <span class="page-info">Page ${p.page} of ${p.totalPages}</span>
        <button class="page-btn" onclick="changeUserPage(1)" ${p.page >= p.totalPages ? 'disabled' : ''}>Next &rarr;</button>
      </div>`;
      
      container.innerHTML = html;
    } catch (e) {
      container.innerHTML = `<p class="alert alert-error">Error: ${esc(e.message)}</p>`;
    }
  }

