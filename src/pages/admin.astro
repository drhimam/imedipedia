            <button type="button" class="topbar-btn" onclick="viewNewsletter(${iss.id}, 'view')" style="padding:0.6rem 1.25rem;">Cancel</button>
            <button type="button" class="btn" id="nlEditSaveBtn" onclick="saveNewsletterEdit(${iss.id})">Save Changes</button>
          </div>
        </form>`;
    } else {
      modal.innerHTML = `
        <div class="view-modal-header" style="display:flex;justify-content:space-between;align-items:center;">
          <div style="display:flex;align-items:center;gap:0.75rem;">
            <button class="view-modal-close" onclick="closeAdminViewModal()" title="Close">&times;</button>
