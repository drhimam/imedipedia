  async function saveGeneratedSubmission() {
    const title = document.getElementById('genTitle').value.trim();
    const body = document.getElementById('genBody').value.trim();
    if (!title || !body) { alert('Please generate (or write) both a title and article body first.'); return; }
    const btn = document.getElementById('genSaveBtn');
    btn.disabled = true;
    const original = btn.textContent;
    btn.textContent = 'Saving…';
    try {
      const resp = await fetch('/api/submissions/create', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title,
          topic: document.getElementById('genTopic').value.trim(),
          type: document.getElementById('genType').value,
          subjects: genSelectedSubjects,
          exams: genSelectedExams,
          description: document.getElementById('genDescription').value.trim(),
          body
        })
      });
      const data = await resp.json();
      if (data.success) {
        showGenStatus(data.message || 'Saved as a pending submission.', true);
        setTimeout(function() { closeGenerateModal(); switchTab('submissions'); }, 900);
      } else {
        showGenStatus(data.error || 'Save failed.', false);
