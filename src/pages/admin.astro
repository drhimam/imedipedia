  window.saveNewsletterEdit = async function(id) {
    const title = document.getElementById('nlEditTitle').value.trim();
    const subject = document.getElementById('nlEditSubject').value.trim();
    const body_md = document.getElementById('nlEditBody').value.trim();

    if (!id || !title || !subject || !body_md) {
      alert('Title, Subject, and Markdown Body are required.');
      return;
    }

    const btn = document.getElementById('nlEditSaveBtn');
    const statusEl = document.getElementById('nlEditStatus');
    btn.disabled = true;
    btn.textContent = 'Saving...';
    statusEl.style.display = 'none';

    try {
      const resp = await fetch('/api/admin/newsletter/update', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, title, subject, body_md })
      });
      const data = await resp.json();
      statusEl.style.display = 'block';
      if (data.success) {
        statusEl.className = 'alert alert-success';
        statusEl.textContent = data.message || 'Saved successfully.';
        window._loadedNewsletters[id] = { ...window._loadedNewsletters[id], title, subject, body_md };
        setTimeout(() => { viewNewsletter(id, 'view'); loadNewsletters(); }, 800);
      } else {
        statusEl.className = 'alert alert-error';
        statusEl.textContent = data.error || 'Failed to save.';
      }
    } catch(e) {
      statusEl.style.display = 'block';
      statusEl.className = 'alert alert-error';
      statusEl.textContent = 'Error: ' + e.message;
    } finally {
      btn.disabled = false;
      btn.textContent = 'Save Changes';
    }
  };

  window.downloadNewsletterMd = function(id) {
    const iss = window._loadedNewsletters[id];
    if (!iss) return;
    const blob = new Blob([iss.body_md], { type: 'text/markdown;charset=utf-8;' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = `weekly-digest-issue-${iss.issue_number}.md`;
    link.click();
    URL.revokeObjectURL(link.href);
  };

  window.downloadNewsletterPdf = function(id) {
    const iss = window._loadedNewsletters[id];
    if (!iss) return;
    const printWin = window.open('', '_blank');
    if (!printWin) {
      alert('Please allow popups to download/print PDF.');
      return;
    }
    const htmlContent = `
      <!DOCTYPE html>
      <html>
      <head>
        <title>Weekly Digest #${iss.issue_number} - iMedipedia</title>
        <style>
          body { font-family: 'Segoe UI', Arial, sans-serif; padding: 40px; color: #1e293b; line-height: 1.6; }
          h1 { color: #4f46e5; border-bottom: 2px solid #e2e8f0; padding-bottom: 10px; }
          h2 { color: #6366f1; margin-top: 20px; }
          h3 { color: #334155; }
          .meta { font-size: 0.85rem; color: #64748b; margin-bottom: 30px; }
          hr { border: none; border-top: 1px solid #cbd5e1; margin: 20px 0; }
          @media print { body { padding: 0; } }
        </style>
      </head>
      <body>
        <h1>${esc(iss.title)}</h1>
        <div class="meta">
          <strong>Subject:</strong> ${esc(iss.subject)} | <strong>Issue:</strong> #${iss.issue_number} | <strong>Date:</strong> ${new Date(iss.created_at * 1000).toLocaleDateString()}
        </div>
        <div>
          ${iss.body_md
            .replace(/^### (.*$)/gim, '<h3>$1</h3>')
            .replace(/^## (.*$)/gim, '<h2>$1</h2>')
            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
            .replace(/^---$/gim, '<hr>')
            .replace(/\n\n/g, '</p><p>')
            .replace(/\n/g, '<br>')}
        </div>
      </body>
      </html>
    `;
    printWin.document.write(htmlContent);
    printWin.document.close();
    printWin.focus();
    setTimeout(() => { printWin.print(); }, 500);
  };

  window.deleteNewsletter = async function(id) {
    if (!confirm('Are you sure you want to delete this weekly digest issue?')) return;
    try {
      const resp = await fetch('/api/admin/newsletter/delete', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id })
      });
      const data = await resp.json();
      alert(data.message || data.error);
      loadNewsletters();
    } catch(e) {
      alert('Error: ' + e.message);
    }
  };

