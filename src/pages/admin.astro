  async function saveAdminEdit() {
    const id = document.getElementById('adminEditId').value;
    const statusEl = document.getElementById('adminEditStatus');

    const payload = {
      title: document.getElementById('adminEditTitle').value.trim(),
      author: document.getElementById('adminEditAuthor').value.trim(),
      type: document.getElementById('adminEditType').value,
      subject: document.getElementById('adminEditSubject').value.trim(),
      topic: document.getElementById('adminEditTopic').value.trim(),
      subjects: adminEditSelectedSubjects,
      exams: adminEditSelectedExams,
      image: document.getElementById('adminEditImageUrl').value.trim(),
      description: document.getElementById('adminEditDescription').value.trim(),
      body: document.getElementById('adminEditBody').value.trim(),
    };

    try {
      const resp = await fetch('/api/submissions/' + id, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await resp.json();

      if (data.success) {
        statusEl.textContent = data.message || 'Saved successfully.';
        statusEl.className = 'alert alert-success';
        statusEl.style.display = 'block';
        setTimeout(function() {
          closeAdminEditModal();
          loadSubmissions();
        }, 800);
      } else {
        statusEl.textContent = data.error || 'Save failed.';
        statusEl.className = 'alert alert-error';
        statusEl.style.display = 'block';
      }
    } catch(e) {
      statusEl.textContent = 'Network error: ' + e.message;
      statusEl.className = 'alert alert-error';
      statusEl.style.display = 'block';
    }
  }

