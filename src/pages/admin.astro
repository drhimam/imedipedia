  function renderReviewStatusTable() {
    const container = document.getElementById('reviewStatusTable');
    if (!container) return;

    const filtered = _allReviewAssignments.filter(a => {
      if (!currentReviewStatusSearch) return true;
      const q = currentReviewStatusSearch.toLowerCase();
      return (a.submission_title || '').toLowerCase().includes(q) ||
             (a.submission_author || '').toLowerCase().includes(q) ||
             (a.submission_topic || '').toLowerCase().includes(q) ||
             (a.reviewer_name || '').toLowerCase().includes(q) ||
             (a.reviewer_email || '').toLowerCase().includes(q) ||
             (a.recommendation || '').toLowerCase().includes(q) ||
             (a.assignment_status || '').toLowerCase().includes(q);
    });

    const limit = 10;
    const totalPages = Math.max(1, Math.ceil(filtered.length / limit));
    if (currentReviewStatusPage > totalPages) currentReviewStatusPage = totalPages;
    const startIndex = (currentReviewStatusPage - 1) * limit;
    const pageItems = filtered.slice(startIndex, startIndex + limit);

    let html = `
      <div class="table-controls">
        <input type="text" id="reviewStatusSearch" class="table-search" placeholder="Search evaluations (title, author, reviewer, recommendation)..." value="${esc(currentReviewStatusSearch)}" onkeyup="if(event.key==='Enter') handleReviewStatusSearch()">
        <div style="font-size:0.85rem;color:var(--muted);">Showing ${pageItems.length} of ${filtered.length} assignments</div>
      </div>
    `;

    if (!pageItems.length) {
      html += '<p style="color:var(--muted);padding:1.5rem 0;text-align:center;">No matching manuscript review assignments found.</p>';
      container.innerHTML = html;
      return;
    }

    const recColors = {
      accept: '#10b981',
      minor_revisions: '#f59e0b',
      major_revisions: '#ea580c',
      reject: '#ef4444'
    };
    const recLabels = {
      accept: '✅ Accept',
      minor_revisions: '✏️ Minor Rev',
      major_revisions: '🔄 Major Rev',
      reject: '❌ Reject'
    };

    html += `<table class="data-table"><thead><tr>
      <th>Manuscript</th><th>Author</th><th>Assigned Reviewer</th><th>Assigned</th><th>Status</th><th>Recommendation</th><th>Scores</th><th>Actions</th>
    </tr></thead><tbody>`;

    pageItems.forEach(a => {
      const isDone = a.assignment_status === 'completed' || !!a.recommendation;
      const recBadge = isDone && a.recommendation
        ? `<span class="badge" style="background:${recColors[a.recommendation] ? recColors[a.recommendation] + '22' : 'rgba(99,102,241,0.15)'};color:${recColors[a.recommendation] || 'var(--accent)'};font-weight:700;">${recLabels[a.recommendation] || a.recommendation}</span>`
        : '<span style="color:var(--muted);font-size:0.85rem;">—</span>';

      const scoresDisplay = isDone && (a.clinical_accuracy_score || a.structure_score || a.evidence_score)
        ? `<span style="font-family:monospace;font-size:0.88rem;font-weight:600;">${a.clinical_accuracy_score || '—'} / ${a.structure_score || '—'} / ${a.evidence_score || '—'}</span>`
        : '<span style="color:var(--muted);font-size:0.85rem;">—</span>';

      html += `
      <tr>
        <td>
          <strong class="truncate" style="max-width:200px;display:block;" title="${esc(a.submission_title || 'Manuscript')}">${esc(a.submission_title || 'Manuscript')}</strong>
          <span style="font-size:0.75rem;color:var(--muted);">${esc(a.submission_type || 'general')} ${a.submission_topic ? '• ' + esc(a.submission_topic) : ''}</span>
        </td>
        <td><span class="truncate" style="max-width:130px;display:block;" title="${esc(a.submission_author || '—')}">${esc(a.submission_author || '—')}</span></td>
        <td>
          <strong class="truncate" style="max-width:150px;display:block;" title="${esc(a.reviewer_name || a.reviewer_username || 'Reviewer')}">${esc(a.reviewer_name || a.reviewer_username || 'Reviewer')}</strong>
          <span style="font-size:0.75rem;color:var(--muted);">${esc(a.reviewer_email || '')}</span>
        </td>
        <td style="font-size:0.85rem;white-space:nowrap;">${a.assigned_at ? new Date(a.assigned_at * 1000).toLocaleDateString() : '—'}</td>
        <td>
          <span class="badge" style="background:${isDone ? 'rgba(16,185,129,0.15)' : 'rgba(245,158,11,0.15)'};color:${isDone ? '#10b981' : '#f59e0b'};">
            ${isDone ? '✅ Completed' : '⏳ In Review'}
          </span>
        </td>
        <td>${recBadge}</td>
        <td>${scoresDisplay}</td>
        <td>
          <div class="dropdown">
            <button onclick="toggleDropdown('rev-status-drop-${a.id}')" class="dropdown-btn">⋮</button>
            <div id="rev-status-drop-${a.id}" class="dropdown-content">
              <button onclick="viewPeerReviews(${a.submission_id}, '${esc(a.submission_title || '').replace(/'/g, "\\'")}')">👁 View Scorecard</button>
