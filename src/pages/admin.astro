  // ========== AI HELPERS ==========
  async function aiGenerate(prompt, buttonEl) {
    if (!prompt || !prompt.trim()) { alert('Nothing to send to AI — add some content first.'); return null; }
    const doFetch = async () => {
      const resp = await fetch('/api/ai/generate', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ prompt })
      });
      const data = await resp.json();
      if (!resp.ok || data.error) throw new Error(data.error || ('Request failed (' + resp.status + ')'));
      return data.result || '';
    };
    if (buttonEl) {
      buttonEl.disabled = true;
      const original = buttonEl.textContent;
      buttonEl.textContent = '⏳ Working...';
      try { return await doFetch(); }
      catch (e) { alert('AI error: ' + e.message); return null; }
      finally { buttonEl.disabled = false; buttonEl.textContent = original; }
    }
    try { return await doFetch(); }
    catch (e) { alert('AI error: ' + e.message); return null; }
  }

  function aiRewriteInstructions(action) {
    return {
      plain: 'Rewrite the following medical article in plain, accessible English for a general audience while preserving clinical accuracy and keeping markdown formatting:',
      improve: 'Improve the following medical article: fix grammar, tighten wording, improve clarity and flow, and keep it professionally written. Preserve markdown formatting and clinical accuracy:',
      expand: 'Expand the following medical article with more depth, additional relevant clinical detail, and section headers where useful, while preserving markdown formatting and clinical accuracy:'
    }[action] || 'Improve the following medical article while preserving clinical accuracy and markdown formatting:';
  }

