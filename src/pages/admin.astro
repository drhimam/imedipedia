---
// Admin Dashboard — Applications, Submissions, Articles, Images, Subjects
// SSR-only: verifies admin session on every request
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import subjects from '../data/subjects.json';
import exams from '../data/exams.json';
const SITE_TITLE = "Admin Dashboard";

// Server-side auth check
if (Astro.request) {
  const cookieHeader = Astro.request.headers.get("cookie") || "";
  const match = cookieHeader.match(/session_id=([^;]+)/);
  const sessionId = match ? match[1] : null;

  if (!sessionId) {
    return Astro.redirect("/admin/login");
  }

  try {
    const db = Astro.locals?.runtime?.env?.D1_DB || Astro.locals?.runtime?.env?.DB;
    if (db) {
      const now = Math.floor(Date.now() / 1000);
      const session = await db.prepare("SELECT * FROM sessions WHERE id = ? AND expires_at > ?")
        .bind(sessionId, now).first();

      if (!session) {
        return Astro.redirect("/admin/login");
      }

      const user = await db.prepare("SELECT * FROM users WHERE id = ?").bind(session.user_id).first();
      if (!user || (user.role !== 'admin' && user.role !== 'co-admin')) {
        return Astro.redirect("/admin/login");
      }
    }
  } catch (err) {
    console.error("Admin auth error:", err.message);
    return Astro.redirect("/admin/login");
  }
}
---

<BaseLayout title={SITE_TITLE}>
  <!-- Admin Top Bar -->
  <header class="admin-topbar" id="adminTopbar">
    <div class="topbar-left">
      <span class="topbar-logo">⚕️ iMedipedia</span>
      <span class="topbar-badge">Admin</span>
    </div>
    <div class="topbar-right">
      <span class="topbar-user" id="topbarUserName">Loading...</span>
      <a class="topbar-btn" href="/admin/studio" title="Open the full-page AI Studio" style="text-decoration:none;">
        <span class="tb-btn-icon">✨</span><span class="tb-btn-label">Studio</span>
      </a>
      <a class="topbar-btn" href="/admin/kb" title="Manage evidence sources for grounded generation" style="text-decoration:none;">
        <span class="tb-btn-icon">📚</span><span class="tb-btn-label">KB</span>
      </a>
      <button class="topbar-btn" onclick="openGenerateModal()" title="Generate article with AI">
        <span class="tb-btn-icon">✨</span><span class="tb-btn-label">Generate</span>
      </button>
      <button class="topbar-btn topbar-settings-btn" onclick="openSettings()" title="Settings">
        <span class="tb-btn-icon">⚙️</span><span class="tb-btn-label">Settings</span>
      </button>
      <span class="topbar-divider"></span>
      <button class="topbar-btn topbar-logout-btn" onclick="doLogout()" title="Logout">
        <span class="tb-btn-icon">↪️</span><span class="tb-btn-label">Logout</span>
      </button>
    </div>
  </header>

  <!-- Settings Drawer Overlay -->
  <div class="drawer-overlay" id="settingsOverlay" onclick="closeSettings()"></div>
  <div class="settings-drawer" id="settingsDrawer">
    <div class="drawer-header">
      <h2>⚙️ Settings</h2>
      <button class="drawer-close" onclick="closeSettings()">✕</button>
    </div>
    <div class="drawer-body">
      <!-- Profile Section -->
      <section class="drawer-section">
        <h3 class="drawer-section-title">Profile</h3>
        <div class="form-group">
          <label class="form-label">Full Name</label>
          <input class="form-input" type="text" id="settingsFullName" placeholder="Your name">
        </div>
        <div class="form-group">
          <label class="form-label">Email</label>
          <input class="form-input" type="email" id="settingsEmail" placeholder="your@email.com">
        </div>
        <div class="form-group">
          <label class="form-label">Affiliation</label>
          <div class="chip-container" id="adminAffiliationChips"></div>
          <div class="chip-input-row">
            <input class="form-input chip-input" type="text" id="adminAffiliationInput" placeholder="Add hospital, institution, or organization">
            <button type="button" class="chip-add-btn" onclick="addAdminChip('affiliation')">＋ Add</button>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Specialty</label>
          <div class="chip-container" id="adminSpecialtyChips"></div>
          <div class="chip-input-row">
            <input class="form-input chip-input" type="text" id="adminSpecialtyInput" placeholder="Add medical specialty">
            <button type="button" class="chip-add-btn" onclick="addAdminChip('specialty')">＋ Add</button>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Experience</label>
          <div class="chip-container" id="adminExperienceChips"></div>
          <div class="chip-input-row">
            <input class="form-input chip-input" type="text" id="adminExperienceInput" placeholder="Add work experience or position">
            <button type="button" class="chip-add-btn" onclick="addAdminChip('experience')">＋ Add</button>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Bio</label>
          <textarea class="form-input form-textarea" id="settingsBio" placeholder="Short bio..." rows="3"></textarea>
        </div>
        <button class="btn btn-sm" onclick="saveProfile()">Save Profile</button>
        <div id="profileMsg" class="alert" style="display:none;margin-top:0.75rem;"></div>
      </section>

      <!-- Password Change -->
      <section class="drawer-section">
        <h3 class="drawer-section-title">Change Password</h3>
        <div class="form-group">
          <label class="form-label">Current Password</label>
          <input class="form-input" type="password" id="settingsCurPwd" placeholder="Current password">
        </div>
        <div class="form-group">
          <label class="form-label">New Password (min 8 chars)</label>
          <input class="form-input" type="password" id="settingsNewPwd" placeholder="New password">
        </div>
        <button class="btn btn-sm" onclick="changePassword()">Update Password</button>
        <div id="pwdMsg" class="alert" style="display:none;margin-top:0.75rem;"></div>
      </section>

      <!-- MFA -->
      <section class="drawer-section">
        <h3 class="drawer-section-title">Two-Factor Authentication</h3>
        <p id="mfaStatusText" style="color:var(--muted);font-size:0.9rem;margin:0 0 0.5rem;">Checking...</p>
        <div id="mfaDisabled" style="display:none;">
          <button class="btn btn-sm btn-secondary" onclick="setupMFA()">Set Up MFA</button>
        </div>
        <div id="mfaSetupArea" style="display:none;">
          <p style="color:var(--muted);font-size:0.85rem;margin:0 0 0.5rem;">Enter this key in your authenticator app:</p>
          <div id="mfaSecretDisplay" style="background:rgba(0,0,0,0.1);padding:0.75rem;border-radius:8px;font-family:monospace;font-size:1rem;text-align:center;word-break:break-all;margin-bottom:0.75rem;"></div>
          <div class="form-group">
            <label class="form-label">Verification Code</label>
            <div style="display:flex;gap:0.5rem;">
              <input class="form-input" type="text" id="mfaCode" placeholder="6-digit code" maxlength="6" style="flex:1;">
              <button class="btn btn-sm" onclick="verifyMFA()">Verify</button>
            </div>
          </div>
        </div>
        <div id="mfaMsg" class="alert" style="display:none;margin-top:0.75rem;"></div>
      </section>

      <!-- Theme -->
      <section class="drawer-section">
        <h3 class="drawer-section-title">Appearance</h3>
        <div class="theme-options" id="themeOptions">
          <button class="theme-opt" data-theme="dark" onclick="setTheme('dark')">🌙 Dark</button>
          <button class="theme-opt" data-theme="light" onclick="setTheme('light')">☀️ Light</button>
          <button class="theme-opt" data-theme="system" onclick="setTheme('system')">💻 System</button>
        </div>
      </section>
    </div>
  </div>

  <main class="main-content" style="max-width:1200px;margin:2rem auto;padding:0 1.5rem;">
    <header class="portal-header" style="text-align:center;margin-bottom:2rem;">
      <h1 style="font-family:'Outfit',sans-serif;font-size:2.5rem;font-weight:800;margin-bottom:0.5rem;">Admin Dashboard</h1>
      <p style="color:var(--muted);font-size:1.1rem;">Manage applications, submissions, articles, and images</p>
    </header>

    <!-- Tab Navigation -->
    <nav class="tab-nav" style="display:flex;gap:0.25rem;border-bottom:1px solid var(--border);margin-bottom:2rem;overflow-x:auto;">
      <button class="tab-nav-btn active" data-main-tab="applications">Applications</button>
      <button class="tab-nav-btn" data-main-tab="submissions">Submissions</button>
      <button class="tab-nav-btn" data-main-tab="articles">Articles</button>
      <button class="tab-nav-btn" data-main-tab="images">Images</button>
      <button class="tab-nav-btn" data-main-tab="users">Users</button>
      <button class="tab-nav-btn" data-main-tab="subjects">Subjects</button>
      <button class="tab-nav-btn" data-main-tab="exams">Exams</button>
    </nav>

    <!-- Applications Tab -->
    <div class="tab-panel active" id="tab-applications">
      <div id="applicationsStatus" class="alert alert-info" style="margin-bottom:1rem;display:none;"></div>
      <div id="applicationsTable" style="overflow-x:auto;"></div>
    </div>

    <!-- Submissions Tab -->
    <div class="tab-panel" id="tab-submissions">
      <div id="submissionsStatus" class="alert alert-info" style="margin-bottom:1rem;display:none;"></div>
      <div id="submissionsTable" style="overflow-x:auto;"></div>
    </div>

    <!-- Articles Tab -->
    <div class="tab-panel" id="tab-articles">
      <div id="articlesStatus" class="alert alert-info" style="margin-bottom:1rem;display:none;"></div>
      <div id="articlesTable" style="overflow-x:auto;"></div>
    </div>

    <!-- Images Tab -->
    <div class="tab-panel" id="tab-images">
      <div id="imagesStatus" class="alert alert-info" style="margin-bottom:1rem;display:none;"></div>
      <div style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:1.5rem;">
        <button class="filter-chip active" data-folder="all" onclick="filterImages('all')">All</button>
        <button class="filter-chip" data-folder="covers" onclick="filterImages('covers')">Covers</button>
        <button class="filter-chip" data-folder="inline" onclick="filterImages('inline')">Inline</button>
        <button class="filter-chip" data-folder="uploads" onclick="filterImages('uploads')">Uploads</button>
      </div>
      <details style="margin-bottom:1.5rem;border:1px solid var(--border);border-radius:8px;padding:1rem;">
        <summary style="cursor:pointer;font-weight:600;">Admin Image Upload</summary>
        <div style="margin-top:1rem;display:flex;flex-wrap:wrap;gap:0.5rem;align-items:flex-end;">
          <div><label style="font-size:0.8rem;display:block;margin-bottom:0.25rem;">Name</label><input type="text" id="adminImageName" placeholder="Image name" style="padding:0.5rem;border-radius:6px;border:1px solid var(--border);background:var(--bg);color:var(--text);min-width:150px;"></div>
          <div><label style="font-size:0.8rem;display:block;margin-bottom:0.25rem;">Folder</label><select id="adminImageFolder" style="padding:0.5rem;border-radius:6px;border:1px solid var(--border);background:var(--bg);color:var(--text);"><option value="uploads">Uploads</option><option value="covers">Covers</option><option value="inline">Inline</option></select></div>
          <div><label style="font-size:0.8rem;display:block;margin-bottom:0.25rem;">File (max 1MB)</label><input type="file" id="adminImageFile" accept="image/*" style="padding:0.5rem;"></div>
          <button class="btn" onclick="uploadAdminImage()" style="padding:0.5rem 1rem;font-size:0.9rem;">Upload</button>
        </div>
      </details>
      <div id="imagesTable" style="overflow-x:auto;"></div>
    </div>

    <!-- Users Tab -->
    <div class="tab-panel" id="tab-users">
      <div id="usersStatus" class="alert alert-info" style="margin-bottom:1rem;display:none;"></div>
      <div id="usersTable" style="overflow-x:auto;"></div>
    </div>

    <!-- Subjects Tab -->
    <div class="tab-panel" id="tab-subjects">
      <div id="subjectsStatus" class="alert" style="margin-bottom:1rem;display:none;"></div>
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;flex-wrap:wrap;gap:0.5rem;">
        <h3 style="font-family:'Outfit',sans-serif;margin:0;font-size:1.2rem;">Managed Subject Taxonomy</h3>
        <div style="display:flex;gap:0.5rem;">
          <button class="btn btn-sm" onclick="addNewSubject()">＋ Add Subject</button>
          <button class="btn btn-sm btn-secondary" onclick="saveSubjectsToGitHub()">💾 Save to GitHub</button>
        </div>
      </div>
      <p style="color:var(--muted);font-size:0.9rem;margin-bottom:1.5rem;">Manage the controlled subject list. Contributors select from these subjects when submitting articles. Changes deploy when you save to GitHub (~2 min).</p>
      <!-- Add/Edit inline form -->
      <div id="subjEditRow" style="display:none;border:1px solid var(--accent);border-radius:8px;padding:1rem;margin-bottom:1rem;background:rgba(99,102,241,0.05);">
        <div style="display:flex;gap:0.75rem;align-items:flex-end;flex-wrap:wrap;">
          <div class="form-group" style="flex:1;min-width:200px;">
            <label class="form-label">Subject Name</label>
            <input class="form-input" type="text" id="subjEditName" placeholder="e.g., Respiratory Physiology" maxlength="200">
          </div>
          <div class="form-group" style="flex:1;min-width:150px;">
            <label class="form-label">Parent / Group</label>
            <input class="form-input" type="text" id="subjEditParent" placeholder="e.g., Physiology" maxlength="200" list="parentList">
            <datalist id="parentList"></datalist>
          </div>
          <div style="display:flex;gap:0.5rem;padding-bottom:0.25rem;">
            <button class="btn btn-sm" id="subjSaveBtn" onclick="saveSubjectEdit()">Save</button>
            <button class="btn btn-sm btn-secondary" onclick="cancelSubjectEdit()">Cancel</button>
          </div>
        </div>
        <input type="hidden" id="subjEditIndex" value="-1">
      </div>
      <div id="subjectsTable" style="overflow-x:auto;"></div>
    </div>

    <!-- Exams Tab -->
    <div class="tab-panel" id="tab-exams">
      <div id="examsStatus" class="alert" style="margin-bottom:1rem;display:none;"></div>
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;flex-wrap:wrap;gap:0.5rem;">
        <h3 style="font-family:'Outfit',sans-serif;margin:0;font-size:1.2rem;">Managed Exam List</h3>
        <div style="display:flex;gap:0.5rem;">
          <button class="btn btn-sm" onclick="addNewExam()">＋ Add Exam</button>
          <button class="btn btn-sm btn-secondary" onclick="saveExamsToGitHub()">💾 Save to GitHub</button>
        </div>
      </div>
      <p style="color:var(--muted);font-size:0.9rem;margin-bottom:1.5rem;">Manage the controlled exam list (separate from subjects). Contributors select relevant exams when submitting articles. Changes deploy when you save to GitHub (~2 min).</p>
      <!-- Add/Edit inline form -->
      <div id="examEditRow" style="display:none;border:1px solid var(--accent);border-radius:8px;padding:1rem;margin-bottom:1rem;background:rgba(99,102,241,0.05);">
        <div style="display:flex;gap:0.75rem;align-items:flex-end;flex-wrap:wrap;">
          <div class="form-group" style="flex:1;min-width:200px;">
            <label class="form-label">Exam Name</label>
            <input class="form-input" type="text" id="examEditName" placeholder="e.g., USMLE Step 1" maxlength="200">
          </div>
          <div class="form-group" style="flex:1;min-width:150px;">
            <label class="form-label">Category / Region</label>
            <input class="form-input" type="text" id="examEditCategory" placeholder="e.g., United States" maxlength="200" list="categoryList">
            <datalist id="categoryList"></datalist>
          </div>
          <div style="display:flex;gap:0.5rem;padding-bottom:0.25rem;">
            <button class="btn btn-sm" id="examSaveBtn" onclick="saveExamEdit()">Save</button>
            <button class="btn btn-sm btn-secondary" onclick="cancelExamEdit()">Cancel</button>
          </div>
        </div>
        <input type="hidden" id="examEditIndex" value="-1">
      </div>
      <div id="examsTable" style="overflow-x:auto;"></div>
    </div>
  </main>

  <!-- Admin View Submission Modal -->
  <div class="view-modal-overlay" id="adminViewModalOverlay" style="display:none;">
    <div class="view-modal" id="adminViewModalContent"></div>
  </div>

  <!-- Admin Edit Submission Modal -->
  <div class="view-modal-overlay" id="adminEditModalOverlay" style="display:none;">
    <div class="view-modal" style="max-width:750px;">
      <div class="view-modal-header">
        <button class="view-modal-close" onclick="closeAdminEditModal()">&times;</button>
        <h2>✏️ Edit Submission</h2>
      </div>
      <div id="adminEditStatus" class="alert" style="display:none;margin-bottom:1rem;"></div>
      <form id="adminEditForm" class="edit-modal-form" onsubmit="return false;">
        <input type="hidden" id="adminEditId">
        <div class="form-group">
          <label class="form-label">Title *</label>
          <input class="form-input" type="text" id="adminEditTitle" required maxlength="500">
        </div>
        <div class="form-group">
          <label class="form-label">Author</label>
          <input class="form-input" type="text" id="adminEditAuthor">
        </div>
        <div style="display:flex;gap:0.75rem;">
          <div class="form-group" style="flex:1;">
            <label class="form-label">Type</label>
            <select class="form-input" id="adminEditType">
              <option value="general">Clinical Digest</option>
              <option value="update">Clinical Guidelines</option>
              <option value="case">Case Reports</option>
              <option value="education">Board Review</option>
            </select>
          </div>
          <div class="form-group" style="flex:1;">
            <label class="form-label">Subject</label>
            <input class="form-input" type="text" id="adminEditSubject" maxlength="200">
          </div>
          <div class="form-group" style="flex:1;">
            <label class="form-label">Topic</label>
            <input class="form-input" type="text" id="adminEditTopic" maxlength="200">
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Subjects</label>
          <div style="position:relative;">
            <input class="form-input" type="text" id="adminEditSubjectSearch" placeholder="Search subjects..." autocomplete="off">
            <div id="adminEditSubjectDropdown" class="subject-dropdown" style="display:none;position:absolute;top:100%;left:0;right:0;background:var(--card-bg);border:1px solid var(--border);border-radius:8px;max-height:200px;overflow-y:auto;z-index:10;box-shadow:0 8px 24px rgba(0,0,0,0.2);"></div>
          </div>
          <div id="adminEditSubjectChips" style="display:flex;flex-wrap:wrap;gap:0.4rem;margin-top:0.5rem;"></div>
        </div>
        <div class="form-group">
          <label class="form-label">Exams</label>
          <div style="position:relative;">
            <input class="form-input" type="text" id="adminEditExamSearch" placeholder="Search exams..." autocomplete="off">
            <div id="adminEditExamDropdown" class="subject-dropdown" style="display:none;position:absolute;top:100%;left:0;right:0;background:var(--card-bg);border:1px solid var(--border);border-radius:8px;max-height:200px;overflow-y:auto;z-index:10;box-shadow:0 8px 24px rgba(0,0,0,0.2);"></div>
          </div>
          <div id="adminEditExamChips" style="display:flex;flex-wrap:wrap;gap:0.4rem;margin-top:0.5rem;"></div>
        </div>
        <div class="form-group">
          <label class="form-label" style="display:flex;justify-content:space-between;align-items:center;">
            <span>Description</span>
            <button type="button" class="ai-btn" id="aiSummarizeBtn" onclick="aiSummarizeEdit()" title="Generate a 2-3 sentence summary from the article body">✨ Summarize</button>
          </label>
          <input class="form-input" type="text" id="adminEditDescription" maxlength="1000">
        </div>
        <div class="form-group">
          <label class="form-label" style="display:flex;justify-content:space-between;align-items:center;">
            <span>Article Content (Markdown) *</span>
            <span style="display:flex;gap:0.35rem;">
              <button type="button" class="ai-btn" id="aiRewriteBtn" onclick="aiRewriteBody('plain')">✨ Plain English</button>
              <button type="button" class="ai-btn" id="aiImproveBtn" onclick="aiRewriteBody('improve')">✨ Improve</button>
              <button type="button" class="ai-btn" id="aiExpandBtn" onclick="aiRewriteBody('expand')">✨ Expand</button>
            </span>
          </label>
          <textarea class="form-input" id="adminEditBody" required></textarea>
        </div>
        <div class="edit-modal-actions">
          <button type="button" class="topbar-btn" onclick="closeAdminEditModal()" style="padding:0.6rem 1.25rem;">Cancel</button>
          <button type="button" class="btn" onclick="saveAdminEdit()">Save Changes</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Generate Article Modal -->
  <div class="view-modal-overlay" id="generateModalOverlay" style="display:none;">
    <div class="view-modal" style="max-width:750px;">
      <div class="view-modal-header">
        <button class="view-modal-close" onclick="closeGenerateModal()">&times;</button>
        <h2>✨ Generate Article with AI</h2>
      </div>
      <div id="generateStatus" class="alert" style="display:none;margin-bottom:1rem;"></div>
      <form id="generateForm" class="edit-modal-form" onsubmit="return false;">
        <div class="form-group">
          <label class="form-label">Title *</label>
          <input class="form-input" type="text" id="genTitle" required maxlength="500" placeholder="e.g., Advances in CAR-T Cell Therapy">
        </div>
        <div class="form-group">
          <label class="form-label">Topic</label>
          <input class="form-input" type="text" id="genTopic" maxlength="200" placeholder="e.g., Immunotherapy">
        </div>
        <div class="form-group">
          <label class="form-label">Type</label>
          <select class="form-input" id="genType">
            <option value="general">Clinical Digest</option>
            <option value="update">Clinical Guidelines</option>
            <option value="case">Case Reports</option>
            <option value="education">Board Review</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Subjects</label>
          <div style="position:relative;">
            <input class="form-input" type="text" id="genSubjectSearch" placeholder="Search subjects..." autocomplete="off">
            <div id="genSubjectDropdown" class="subject-dropdown" style="display:none;position:absolute;top:100%;left:0;right:0;background:var(--card-bg);border:1px solid var(--border);border-radius:8px;max-height:200px;overflow-y:auto;z-index:10;box-shadow:0 8px 24px rgba(0,0,0,0.2);"></div>
          </div>
          <div id="genSubjectChips" style="display:flex;flex-wrap:wrap;gap:0.4rem;margin-top:0.5rem;"></div>
        </div>
        <div class="form-group">
          <label class="form-label">Exams</label>
          <div style="position:relative;">
            <input class="form-input" type="text" id="genExamSearch" placeholder="Search exams..." autocomplete="off">
            <div id="genExamDropdown" class="subject-dropdown" style="display:none;position:absolute;top:100%;left:0;right:0;background:var(--card-bg);border:1px solid var(--border);border-radius:8px;max-height:200px;overflow-y:auto;z-index:10;box-shadow:0 8px 24px rgba(0,0,0,0.2);"></div>
          </div>
          <div id="genExamChips" style="display:flex;flex-wrap:wrap;gap:0.4rem;margin-top:0.5rem;"></div>
        </div>
        <div class="form-group">
          <label class="form-label" style="display:flex;justify-content:space-between;align-items:center;">
            <span>Description</span>
            <button type="button" class="ai-btn" id="aiSummarizeGenBtn" onclick="aiSummarizeGen()">✨ Summarize</button>
          </label>
          <input class="form-input" type="text" id="genDescription" maxlength="1000">
        </div>
        <div class="form-group">
