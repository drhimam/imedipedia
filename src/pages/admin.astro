  function setupGenAutocomplete(searchId, dropdownId, matchFn, addFn) {
    const searchEl = document.getElementById(searchId);
    const dropdownEl = document.getElementById(dropdownId);
    if (!searchEl || !dropdownEl) return;
    let activeIdx = -1;
    searchEl.addEventListener('input', function() {
      const query = this.value;
      if (query.length < 2) { dropdownEl.style.display = 'none'; return; }
      const matches = matchFn(query);
      if (matches.length === 0) {
        dropdownEl.innerHTML = '<div style="padding:0.65rem 1rem;color:var(--muted);font-size:0.85rem;">No matches</div>';
      } else {
        dropdownEl.innerHTML = matches.map(function(item) {
          const sub = item.parent || item.category || '';
          return '<div class="subject-option" data-name="' + esc(item.name) + '" style="padding:0.5rem 0.75rem;cursor:pointer;font-size:0.85rem;border-bottom:1px solid rgba(255,255,255,0.03);"' +
            'onmousedown="event.preventDefault();' + addFn + '(\'' + esc(item.name).replace(/'/g, "\\'") + '\')">' +
            esc(item.name) + (sub ? ' <span style="font-size:0.7rem;color:var(--muted);">(' + esc(sub) + ')</span>' : '') +
            '</div>';
        }).join('');
      }
      dropdownEl.style.display = 'block';
      activeIdx = -1;
    });
    searchEl.addEventListener('keydown', function(e) {
      const options = dropdownEl.querySelectorAll('.subject-option');
      if (e.key === 'ArrowDown') { e.preventDefault(); activeIdx = Math.min(activeIdx + 1, options.length - 1); options.forEach(function(o, i) { o.style.background = i === activeIdx ? 'rgba(99,102,241,0.12)' : ''; }); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); activeIdx = Math.max(activeIdx - 1, 0); options.forEach(function(o, i) { o.style.background = i === activeIdx ? 'rgba(99,102,241,0.12)' : ''; }); }
      else if (e.key === 'Enter') {
        e.preventDefault();
        if (activeIdx >= 0 && options[activeIdx]) { window[addFn](options[activeIdx].getAttribute('data-name')); }
        else if (options.length > 0) { window[addFn](options[0].getAttribute('data-name')); }
        activeIdx = -1;
      }
    });
    document.addEventListener('click', function(e) {
      if (!searchEl.contains(e.target) && !dropdownEl.contains(e.target)) dropdownEl.style.display = 'none';
    });
  }
  setupGenAutocomplete('genSubjectSearch', 'genSubjectDropdown', adminMatchSubjects, 'addGenSubject');
  setupGenAutocomplete('genExamSearch', 'genExamDropdown', adminMatchExams, 'addGenExam');

