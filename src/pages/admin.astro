  function setupGenAutocomplete(searchId, dropdownId, matchFn, addFn) {
    const searchEl = document.getElementById(searchId);
    const dropdownEl = document.getElementById(dropdownId);
    if (!searchEl || !dropdownEl) return;
    let activeIdx = -1;
    searchEl.addEventListener('input', function() {
      const query = this.value;
      if (query.length < 2) { dropdownEl.style.display = 'none'; return; }
      const matches = matchFn(query);
      if (matches.length === 0) {
        dropdownEl.innerHTML = '<div style="padding:0.65rem 1rem;color:var(--muted);font-size:0.85rem;">No matches</div>';
      } else {
        dropdownEl.innerHTML = matches.map(function(item) {
          const sub = item.parent || item.category || '';
          return '<div class="subject-option" data-name="' + esc(item.name) + '" style="padding:0.5rem 0.75rem;cursor:pointer;font-size:0.85rem;border-bottom:1px solid rgba(255,255,255,0.03);"' +
            'onmousedown="event.preventDefault();' + addFn + '(\'' + esc(item.name).replace(/'/g, "\\'") + '\')">' +
            esc(item.name) + (sub ? ' <span style="font-size:0.7rem;color:var(--muted);">(' + esc(sub) + ')</span>' : '') +
            '</div>';
        }).join('');
      }
      dropdownEl.style.display = 'block';
      activeIdx = -1;
    });
    searchEl.addEventListener('keydown', function(e) {
      const options = dropdownEl.querySelectorAll('.subject-option');
      if (e.key === 'ArrowDown') { e.preventDefault(); activeIdx = Math.min(activeIdx + 1, options.length - 1); options.forEach(function(o, i) { o.style.background = i === activeIdx ? 'rgba(99,102,241,0.12)' : ''; }); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); activeIdx = Math.max(activeIdx - 1, 0); options.forEach(function(o, i) { o.style.background = i === activeIdx ? 'rgba(99,102,241,0.12)' : ''; }); }
      else if (e.key === 'Enter') {
        e.preventDefault();
        if (activeIdx >= 0 && options[activeIdx]) { window[addFn](options[activeIdx].getAttribute('data-name')); }
        else if (options.length > 0) { window[addFn](options[0].getAttribute('data-name')); }
        activeIdx = -1;
      }
    });
    document.addEventListener('click', function(e) {
      if (!searchEl.contains(e.target) && !dropdownEl.contains(e.target)) dropdownEl.style.display = 'none';
    });
  }
  setupGenAutocomplete('genSubjectSearch', 'genSubjectDropdown', adminMatchSubjects, 'addGenSubject');
  setupGenAutocomplete('genExamSearch', 'genExamDropdown', adminMatchExams, 'addGenExam');

  async function aiSummarizeGen() {
    const body = document.getElementById('genBody').value.trim();
    if (!body) { alert('Generate or write article content first.'); return; }
    const result = await aiGenerate('Summarize the following medical article into 2-3 concise sentences suitable as a description (plain text, no markdown):\n\n' + body, document.getElementById('aiSummarizeGenBtn'));
    if (result) document.getElementById('genDescription').value = result.trim();
  }

  async function generateArticleBody() {
    const title = document.getElementById('genTitle').value.trim();
    if (!title) { alert('Please enter a title.'); return; }
    const topic = document.getElementById('genTopic').value.trim();
    const type = document.getElementById('genType').value;
    const subjectsList = genSelectedSubjects.join(', ') || 'General Medicine';
    const examsList = genSelectedExams.join(', ') || 'None';
    const prompt = 'Write a comprehensive, well-structured medical article in Markdown titled "' + title + '".' +
      (topic ? ' Topic focus: ' + topic + '.' : '') +
      ' Article type: ' + type + '.' +
      ' Relevant subjects: ' + subjectsList + '.' +
      ' Relevant exams: ' + examsList + '.' +
      ' Use clear ## section headings, an introductory paragraph, and clinically accurate, up-to-date content. Write in a professional medical-science tone with plain-language explanations where helpful.';
    showGenStatus('Generating article…', true);
    const result = await aiGenerate(prompt, document.getElementById('genGenerateBtn'));
    if (result) {
      document.getElementById('genBody').value = result.trim();
      hideGenStatus();
    } else {
      showGenStatus('Generation failed.', false);
    }
  }

  async function saveGeneratedSubmission() {
    const title = document.getElementById('genTitle').value.trim();
    const body = document.getElementById('genBody').value.trim();
    if (!title || !body) { alert('Please generate (or write) both a title and article body first.'); return; }
    const btn = document.getElementById('genSaveBtn');
    btn.disabled = true;
    const original = btn.textContent;
    btn.textContent = 'Saving…';
    try {
      const resp = await fetch('/api/submissions/create', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title,
          topic: document.getElementById('genTopic').value.trim(),
          type: document.getElementById('genType').value,
          subjects: genSelectedSubjects,
          exams: genSelectedExams,
          description: document.getElementById('genDescription').value.trim(),
          body
        })
      });
      const data = await resp.json();
      if (data.success) {
        showGenStatus(data.message || 'Saved as a pending submission.', true);
        setTimeout(function() { closeGenerateModal(); switchTab('submissions'); }, 900);
      } else {
        showGenStatus(data.error || 'Save failed.', false);
      }
    } catch (e) {
      showGenStatus('Save error: ' + e.message, false);
    } finally {
      btn.disabled = false;
      btn.textContent = original;
    }
  }

  function switchTab(tab) {
    document.querySelectorAll('.tab-nav-btn').forEach(b => b.classList.toggle('active', b.dataset.mainTab === tab));
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.toggle('active', p.id === 'tab-' + tab));
    if (tab === 'applications') loadApplications();
    else if (tab === 'submissions') loadSubmissions();
    else if (tab === 'articles') loadArticles();
    else if (tab === 'images') loadImages();
    else if (tab === 'subjects') loadSubjects();
    else if (tab === 'exams') loadExams();
  }

  // ========== EDIT PUBLISHED ARTICLE ==========
  function updateArticleEditImagePreview(url) {
    const container = document.getElementById('articleEditImagePreviewContainer');
    const img = document.getElementById('articleEditImagePreview');
    const val = (url || '').trim();
    if (val) {
      img.src = val;
      container.style.display = 'flex';
    } else {
      img.src = '';
      container.style.display = 'none';
    }
  }

  async function editPublishedArticle(path, name) {
    if (!path) { alert('Missing file path.'); return; }
    const statusEl = document.getElementById('articleEditStatus');
    statusEl.style.display = 'none';
    document.getElementById('articleEditPath').value = path;
    document.getElementById('articleEditTitle').value = '';
    document.getElementById('articleEditDescription').value = '';
    document.getElementById('articleEditImageUrl').value = '';
    updateArticleEditImagePreview('');
    document.getElementById('articleEditBody').value = '';
    document.getElementById('articleEditModalOverlay').style.display = 'flex';
    try {
      const resp = await fetch('/api/admin/article-content?path=' + encodeURIComponent(path));
      const data = await resp.json();
      if (!resp.ok || data.error) throw new Error(data.error || ('Failed (' + resp.status + ')'));
      document.getElementById('articleEditTitle').value = data.title || '';
      document.getElementById('articleEditDescription').value = data.description || '';
      document.getElementById('articleEditImageUrl').value = data.image || '';
      updateArticleEditImagePreview(data.image || '');
      document.getElementById('articleEditBody').value = data.body || '';
      statusEl.textContent = 'Loaded: ' + (name || path);
      statusEl.className = 'alert alert-info';
      statusEl.style.display = 'block';
    } catch (e) {
      statusEl.textContent = 'Error loading article: ' + e.message;
      statusEl.className = 'alert alert-error';
      statusEl.style.display = 'block';
    }
  }

  function closeArticleEditModal() {
    document.getElementById('articleEditModalOverlay').style.display = 'none';
    document.getElementById('articleEditImageUrl').value = '';
    updateArticleEditImagePreview('');
  }

  async function aiRewriteArticle(action) {
    const body = document.getElementById('articleEditBody').value.trim();
    if (!body) { alert('Write some article content first.'); return; }
    const btnMap = { plain: 'aiRewriteArtPlainBtn', improve: 'aiRewriteArtImproveBtn', expand: 'aiRewriteArtExpandBtn' };
    const result = await aiGenerate(aiRewriteInstructions(action) + '\n\n' + body, document.getElementById(btnMap[action]));
    if (result) document.getElementById('articleEditBody').value = result.trim();
  }

  async function saveArticleEdit() {
    const path = document.getElementById('articleEditPath').value;
    const title = document.getElementById('articleEditTitle').value.trim();
    const body = document.getElementById('articleEditBody').value.trim();
    if (!path || !title || !body) { alert('Title and body are required.'); return; }
    const statusEl = document.getElementById('articleEditStatus');
    statusEl.textContent = 'Saving…';
    statusEl.className = 'alert alert-info';
    statusEl.style.display = 'block';
    try {
      const resp = await fetch('/api/admin/update-article', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          filePath: path,
          title,
          description: document.getElementById('articleEditDescription').value.trim(),
          image: document.getElementById('articleEditImageUrl').value.trim(),
          body
        })
      });
      const data = await resp.json();
      if (data.success) {
        statusEl.textContent = data.message || 'Article updated.';
        statusEl.className = 'alert alert-success';
        setTimeout(function() { closeArticleEditModal(); loadArticles(); }, 800);
      } else {
        statusEl.textContent = data.error || 'Update failed.';
        statusEl.className = 'alert alert-error';
      }
    } catch (e) {
      statusEl.textContent = 'Update error: ' + e.message;
      statusEl.className = 'alert alert-error';
    }
  }

  // --- Users ---
  let currentUserPage = 1;
  let currentUserSearch = '';

  window.handleUserSearch = function() {
    currentUserSearch = document.getElementById('userSearch').value;
    currentUserPage = 1;
    loadUsers();
  };
  window.changeUserPage = function(delta) {
    currentUserPage += delta;
    loadUsers();
  };

  window._loadedUsers = {};

  async function loadUsers() {
    window._loadedUsers = {};
    const container = document.getElementById('usersTable');
    
    if (!document.getElementById('userControls')) {
      const controls = document.createElement('div');
      controls.id = 'userControls';
      controls.className = 'table-controls';
      controls.innerHTML = `
        <input type="text" id="userSearch" class="table-search" placeholder="Search users..." value="${esc(currentUserSearch)}" onkeyup="if(event.key==='Enter') handleUserSearch()">
        <button class="btn btn-sm" onclick="openEmailModal('all')">✉️ Email All Contributors</button>
      `;
      container.parentElement.insertBefore(controls, container);
    }

    container.innerHTML = '<p style="color:var(--muted);">Loading...</p>';
    try {
      const params = new URLSearchParams();
      if (currentUserSearch) params.set('q', currentUserSearch);
      params.set('page', currentUserPage);
      params.set('limit', 10);

      const resp = await fetch('/api/admin/users?' + params.toString());
      const data = await resp.json();
      
      if (!data.users?.length) {
        container.innerHTML = '<p style="color:var(--muted);">No users found.</p>';
        return;
      }
      
      const p = data.pagination || { totalPages: 1, page: 1 };
      
      let html = `<table class="data-table"><thead><tr>
        <th>Username</th><th>Full Name</th><th>Email</th><th>Role</th><th>MFA</th><th>Actions</th>
      </tr></thead><tbody>`;
      
      data.users.forEach(u => {
        window._loadedUsers[u.id] = u;
        html += `
        <tr>
          <td><strong>${esc(u.username)}</strong></td>
          <td>${esc(u.full_name || '')}</td>
          <td>${esc(u.email || '')}</td>
          <td><span class="badge badge-pending">${esc(u.role)}</span></td>
          <td>${u.mfa_enabled ? '✅' : '❌'}</td>
          <td>
            <div class="dropdown">
              <button onclick="toggleDropdown('user-drop-${u.id}')" class="dropdown-btn">⋮</button>
              <div id="user-drop-${u.id}" class="dropdown-content">
                <button onclick="viewUser('${u.id}', 'view')">👁 View / Edit</button>
                <button onclick="openEmailModal('${esc(u.email)}')">✉️ Send Email</button>
                <button onclick="downloadUserAsText('${u.id}')">📄 Download Text</button>
                <button onclick="downloadUserAsPdf('${u.id}')">📑 Download PDF</button>
                <button onclick="deleteUser('${u.id}', '${esc(u.username)}')">🗑 Delete</button>
              </div>
            </div>
          </td>
        </tr>`;
      });
      html += `</tbody></table>`;
      
      html += `<div class="pagination-ctrl">
        <button class="page-btn" onclick="changeUserPage(-1)" ${p.page <= 1 ? 'disabled' : ''}>&larr; Prev</button>
        <span class="page-info">Page ${p.page} of ${p.totalPages}</span>
        <button class="page-btn" onclick="changeUserPage(1)" ${p.page >= p.totalPages ? 'disabled' : ''}>Next &rarr;</button>
      </div>`;
      
      container.innerHTML = html;
    } catch (e) {
      container.innerHTML = `<p class="alert alert-error">Error: ${esc(e.message)}</p>`;
    }
  }

