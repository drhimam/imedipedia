  // Helper: Numbered Pagination Controls ([ < Prev ] [ 1 ] [ 2 ] [ 3 ] [ Next > ])
  function renderNumberedPagination(currentPage, totalPages, changeFnName) {
    if (totalPages <= 1) return '';
    let html = `<div class="pagination-ctrl" style="display:flex;gap:0.35rem;align-items:center;justify-content:flex-end;margin-top:1.25rem;flex-wrap:wrap;">`;
    html += `<button class="page-btn" onclick="${changeFnName}(${currentPage - 1})" ${currentPage <= 1 ? 'disabled' : ''}>&larr; Prev</button>`;

    let startPage = Math.max(1, currentPage - 2);
    let endPage = Math.min(totalPages, startPage + 4);
    if (endPage - startPage < 4) {
      startPage = Math.max(1, endPage - 4);
    }

    if (startPage > 1) {
      html += `<button class="page-btn" onclick="${changeFnName}(1)">1</button>`;
      if (startPage > 2) html += `<span style="padding:0 0.25rem;color:var(--muted);font-size:0.85rem;">...</span>`;
    }

    for (let p = startPage; p <= endPage; p++) {
      const isActive = p === currentPage;
      html += `<button class="page-btn ${isActive ? 'active' : ''}" style="${isActive ? 'background:var(--accent);color:#fff;border-color:var(--accent);font-weight:700;' : ''}" onclick="${changeFnName}(${p})">${p}</button>`;
    }

    if (endPage < totalPages) {
      if (endPage < totalPages - 1) html += `<span style="padding:0 0.25rem;color:var(--muted);font-size:0.85rem;">...</span>`;
      html += `<button class="page-btn" onclick="${changeFnName}(${totalPages})">${totalPages}</button>`;
    }

    html += `<button class="page-btn" onclick="${changeFnName}(${currentPage + 1})" ${currentPage >= totalPages ? 'disabled' : ''}>Next &rarr;</button>`;
    html += `</div>`;
    return html;
  }

