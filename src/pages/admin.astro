  async function deleteUser(id, username) {
    if(!confirm(`Delete user ${username}?`)) return;
    try {
      const resp = await fetch('/api/admin/users', {
        method: 'DELETE', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ id })
      });
      alert((await resp.json()).message || 'Deleted');
      loadUsers();
    } catch(e) { alert('Error: '+e.message); }
  }

  window.openEmailModal = function(to) {
    document.getElementById('emailTo').value = to;
    document.getElementById('emailRecipientsDisplay').value = to === 'all' ? 'All Contributors' : to;
    document.getElementById('emailSubject').value = '';
    document.getElementById('emailBody').value = '';
    document.getElementById('emailModalStatus').style.display = 'none';
    document.getElementById('emailModalOverlay').style.display = 'flex';
  };

