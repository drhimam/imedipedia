<style is:global>
  /* Admin Top Bar */
  .admin-topbar {
    display: flex; justify-content: space-between; align-items: center;
    padding: 0.6rem 1rem; background: var(--card-bg);
    border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 50;
    backdrop-filter: blur(10px); gap: 0.5rem;
  }
  .topbar-left { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }
  .topbar-logo { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 1rem; white-space: nowrap; }
  .topbar-badge { background: var(--accent); color: white; padding: 0.15rem 0.5rem; border-radius: 20px; font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
  .topbar-right { display: flex; align-items: center; gap: 0.4rem; flex-shrink: 0; }
  .topbar-user { font-size: 0.8rem; color: var(--muted); max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .topbar-divider { width: 1px; height: 24px; background: var(--border); margin: 0 0.25rem; }
  .topbar-btn {
    background: transparent; border: 1px solid var(--border); color: var(--text);
    border-radius: 8px; cursor: pointer; font-size: 0.85rem; font-weight: 600;
    display: flex; align-items: center; gap: 0.35rem; padding: 0.45rem 0.75rem;
    transition: all 0.15s; white-space: nowrap; font-family: inherit;
  }
  .topbar-btn:hover { background: var(--accent); color: white; border-color: var(--accent); }
  .topbar-settings-btn:hover { background: var(--accent); color: white; border-color: var(--accent); }
  .topbar-logout-btn { color: #ef4444; border-color: rgba(239,68,68,0.3); }
  .topbar-logout-btn:hover { background: #ef4444; color: white; border-color: #ef4444; }
  .tb-btn-icon { font-size: 1rem; line-height: 1; }
  .tb-btn-label { font-size: 0.8rem; }

  @media (max-width: 640px) {
    .topbar-logo { font-size: 0.85rem; }
    .topbar-user { display: none; }
    .topbar-btn { padding: 0.4rem 0.55rem; }
    .tb-btn-label { display: none; }
    .tb-btn-icon { font-size: 1.15rem; }
    .topbar-badge { display: none; }
  }

  /* Settings Drawer */
  .drawer-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 90; opacity: 0; pointer-events: none; transition: opacity 0.25s; }
  .drawer-overlay.open { opacity: 1; pointer-events: auto; }
  .settings-drawer { position: fixed; top: 0; right: 0; width: 420px; max-width: 90vw; height: 100%; background: var(--card-bg); z-index: 100; transform: translateX(100%); transition: transform 0.3s cubic-bezier(0.4,0,0.2,1); overflow-y: auto; box-shadow: -4px 0 30px rgba(0,0,0,0.2); }
  .settings-drawer.open { transform: translateX(0); }
  .drawer-header { display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border); position: sticky; top: 0; background: var(--card-bg); z-index: 1; }
  .drawer-header h2 { font-family: 'Outfit', sans-serif; font-size: 1.3rem; font-weight: 700; margin: 0; }
  .drawer-close { background: transparent; border: none; color: var(--muted); font-size: 1.3rem; cursor: pointer; width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; }
  .drawer-close:hover { background: rgba(239,68,68,0.1); color: #ef4444; }
  .drawer-body { padding: 1.5rem; display: flex; flex-direction: column; gap: 1.5rem; }
  .drawer-section { border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; }
  .drawer-section-title { font-family: 'Outfit', sans-serif; font-size: 1rem; font-weight: 700; margin: 0 0 1rem; }

  /* Forms */
  .form-group { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 0.75rem; }
  .form-label { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); }
  .form-input { padding: 0.6rem 0.75rem; border-radius: 6px; border: 1px solid var(--border); background: rgba(0,0,0,0.08); color: var(--text); font-size: 0.9rem; width: 100%; box-sizing: border-box; }
  :global([data-theme="light"]) .form-input { background: rgba(255,255,255,0.8); }
  .form-input:focus { outline: none; border-color: var(--accent); }
  .form-textarea { resize: vertical; min-height: 60px; font-family: inherit; }
  /* Chip styles for multi-value fields */
  .chip-container { display: flex; flex-wrap: wrap; gap: 0.4rem; min-height: 0; margin-bottom: 0.25rem; }
  .chip { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.3rem 0.55rem; background: var(--accent); color: #fff; border-radius: 20px; font-size: 0.8rem; font-weight: 500; animation: chipIn 0.2s ease-out; }
  @keyframes chipIn { from { transform: scale(0.8); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  .chip-remove { background: transparent; border: none; color: rgba(255,255,255,0.8); cursor: pointer; font-size: 0.9rem; line-height: 1; padding: 0; width: 16px; height: 16px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
  .chip-remove:hover { color: #fff; background: rgba(255,255,255,0.2); }
  .chip-input-row { display: flex; gap: 0.4rem; }
  .chip-input { flex: 1; min-width: 0; }
  .chip-add-btn { padding: 0.5rem 0.7rem; border-radius: 6px; border: 1px dashed var(--border); background: transparent; color: var(--accent); cursor: pointer; font-size: 0.8rem; font-weight: 600; white-space: nowrap; font-family: inherit; }
  .chip-add-btn:hover { background: var(--accent); color: #fff; border-color: var(--accent); }
  .btn { background: var(--accent); color: #fff; border: none; padding: 0.7rem 1.25rem; font-size: 0.9rem; font-weight: 700; border-radius: 8px; cursor: pointer; transition: opacity 0.15s; }
  .btn:hover { opacity: 0.9; }
  .btn-sm { padding: 0.5rem 1rem; font-size: 0.85rem; }
  .btn-secondary { background: transparent; border: 1px solid var(--accent); color: var(--accent); }
  .btn-secondary:hover { background: var(--accent); color: white; opacity: 1; }
  .btn:disabled { opacity: 0.5; cursor: not-allowed; }

  /* Theme Options */
  .theme-options { display: flex; gap: 0.5rem; }
  .theme-opt { font-family: inherit; flex: 1; padding: 0.6rem; border-radius: 8px; border: 1px solid var(--border); background: transparent; color: var(--text); cursor: pointer; font-size: 0.85rem; font-weight: 600; transition: all 0.15s; }
  .theme-opt:hover { border-color: var(--accent); }
  .theme-opt.active { background: var(--accent); color: white; border-color: var(--accent); }

  /* Alert */
  .alert { padding: 0.6rem 0.75rem; border-radius: 6px; font-size: 0.8rem; }
  .alert-success { background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3); color: #10b981; }
  .alert-error { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #ef4444; }
  .alert-info { background: rgba(59,130,246,0.1); border: 1px solid rgba(59,130,246,0.3); color: #3b82f6; }

  /* Tab Navigation */
  .tab-nav-btn { cursor: pointer; font-family: inherit;
    background: transparent;
    border: none;
    padding: 0.75rem 1.25rem;
    color: var(--muted);
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 600;
    border-bottom: 2px solid transparent;
    transition: all 0.2s;
  }
  .tab-nav-btn:hover { color: var(--text); }
  .tab-nav-btn.active { color: var(--accent); border-bottom-color: var(--accent); }
  .tab-panel { display: none; }
  .tab-panel.active { display: block; }
  .filter-chip { font-family: inherit;
    padding: 0.4rem 0.8rem;
    border-radius: 20px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 500;
    transition: all 0.2s;
  }
  .filter-chip:hover { border-color: var(--accent); color: var(--accent); }
  .filter-chip.active { background: var(--accent); color: white; border-color: var(--accent); }
  .data-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .data-table th { text-align: left; padding: 0.75rem; background: rgba(99,102,241,0.08); border-bottom: 1px solid var(--border); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); }
  .data-table td { padding: 0.75rem; border-bottom: 1px solid var(--border); }
  .data-table tr:hover td { background: rgba(99,102,241,0.03); }
  .badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 20px; font-size: 0.75rem; font-weight: 600; }
  .badge-pending { background: rgba(251,191,36,0.15); color: #f59e0b; }
  .badge-approved { background: rgba(16,185,129,0.15); color: #10b981; }
  .badge-rejected { background: rgba(239,68,68,0.15); color: #ef4444; }
  .badge-published { background: rgba(99,102,241,0.15); color: #6366f1; }
  .action-btn { font-family: inherit; padding: 0.35rem 0.75rem; border-radius: 6px; border: none; cursor: pointer; font-size: 0.8rem; font-weight: 600; margin: 0 0.15rem; transition: all 0.15s; }
  .action-btn:hover { transform: translateY(-1px); }
  .btn-approve { background: #10b981; color: white; }
  .btn-reject { background: #ef4444; color: white; }
  .btn-publish { background: #6366f1; color: white; }
  .btn-copy { background: var(--accent); color: white; }
  .btn-delete { background: var(--border); color: var(--text); }
  .btn-delete-sm { background: transparent; border: 1px solid var(--border); color: var(--muted); padding: 0.35rem 0.5rem; margin: 0 0.15rem; }
  .btn-delete-sm:hover { background: rgba(239,68,68,0.1); border-color: #ef4444; color: #ef4444; }
  .btn-view-admin { background: transparent; border: 1px solid var(--border); color: var(--muted); padding: 0.35rem 0.5rem; margin: 0 0.15rem; }
  .btn-view-admin:hover { background: rgba(16,185,129,0.1); border-color: #10b981; }
  .btn-edit-admin { background: transparent; border: 1px solid var(--border); color: var(--muted); padding: 0.35rem 0.5rem; margin: 0 0.15rem; }
  .btn-edit-admin:hover { background: rgba(59,130,246,0.1); border-color: #3b82f6; }
  .copy-tooltip { position: relative; }
  .img-thumb { width: 48px; height: 48px; object-fit: cover; border-radius: 6px; border: 1px solid var(--border); }
  
  /* Dropdown Menus & Table Controls */
  .table-controls { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem; }
  .table-search { padding: 0.5rem 0.75rem; border-radius: 6px; border: 1px solid var(--border); background: rgba(0,0,0,0.08); color: var(--text); font-size: 0.9rem; min-width: 250px; }
  :global([data-theme="light"]) .table-search { background: rgba(255,255,255,0.8); }
  .table-search:focus { outline: none; border-color: var(--accent); }
  
  .pagination-ctrl { display: flex; gap: 0.5rem; align-items: center; justify-content: flex-end; margin-top: 1rem; }
  .page-btn { padding: 0.4rem 0.8rem; border-radius: 6px; border: 1px solid var(--border); background: var(--card-bg); color: var(--text); cursor: pointer; font-size: 0.85rem; font-weight: 600; }
  .page-btn:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
  .page-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .page-info { font-size: 0.85rem; color: var(--muted); }

  .dropdown { position: relative; display: inline-block; }
  .dropdown-btn { background: transparent; border: none; cursor: pointer; font-size: 1.2rem; padding: 0.2rem 0.5rem; border-radius: 4px; color: var(--muted); }
  .dropdown-btn:hover { background: rgba(0,0,0,0.05); color: var(--text); }
  :global([data-theme="light"]) .dropdown-btn:hover { background: rgba(0,0,0,0.05); }
  .dropdown-content { display: none; position: absolute; right: 0; background-color: var(--card-bg); min-width: 140px; box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2); z-index: 10; border-radius: 6px; border: 1px solid var(--border); overflow: hidden; }
  .dropdown-content button, .dropdown-content a { color: var(--text); padding: 0.6rem 1rem; text-decoration: none; display: block; background: transparent; border: none; width: 100%; text-align: left; font-size: 0.85rem; font-family: inherit; cursor: pointer; }
  .dropdown-content button:hover, .dropdown-content a:hover { background-color: rgba(99,102,241,0.1); color: var(--accent); }
  .dropdown.show .dropdown-content { display: block; }
  .truncate { max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: inline-block; vertical-align: middle; }

  /* Admin View Modal */
  .view-modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 998; display: flex; align-items: center; justify-content: center; animation: modalFadeIn 0.2s ease-out; }
  @keyframes modalFadeIn { from { opacity: 0; } to { opacity: 1; } }
  .view-modal { background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; padding: 2rem; max-width: 700px; width: 90%; max-height: 85vh; overflow-y: auto; animation: modalPopIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
  @keyframes modalPopIn { from { transform: scale(0.85); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  .view-modal h2 { font-family: 'Outfit', sans-serif; font-size: 1.4rem; font-weight: 700; margin: 0 0 0.75rem 0; }
  .view-modal-meta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem; font-size: 0.85rem; color: var(--muted); }
  .view-modal-body { background: rgba(0,0,0,0.05); border: 1px solid var(--border); border-radius: 8px; padding: 1.25rem; font-size: 0.95rem; line-height: 1.7; white-space: pre-wrap; word-break: break-word; max-height: 400px; overflow-y: auto; font-family: inherit; }
  :global([data-theme="light"]) .view-modal-body { background: rgba(0,0,0,0.02); }
  .view-modal-close { background: transparent; border: none; color: var(--muted); font-size: 1.4rem; cursor: pointer; width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .view-modal-close:hover { background: rgba(239,68,68,0.1); color: #ef4444; }
  .view-modal-header { position: relative; }
  /* Edit Modal form */
  .edit-modal-form { display: flex; flex-direction: column; gap: 0.75rem; }
  .edit-modal-form .form-group { margin-bottom: 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .edit-modal-form .form-label { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); }
  .edit-modal-form .form-input { padding: 0.6rem 0.75rem; border-radius: 6px; border: 1px solid var(--border); background: rgba(0,0,0,0.08); color: var(--text); font-size: 0.9rem; width: 100%; box-sizing: border-box; }
  :global([data-theme="light"]) .edit-modal-form .form-input { background: rgba(255,255,255,0.8); }
  .edit-modal-form .form-input:focus { outline: none; border-color: var(--accent); }
  .edit-modal-form textarea.form-input { resize: vertical; min-height: 150px; font-family: inherit; }
  .edit-modal-actions { display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 0.5rem; }
  /* AI action buttons */
  .ai-btn { background: linear-gradient(135deg, #6366f1, #8b5cf6); color: #fff; border: none; border-radius: 6px; padding: 0.3rem 0.6rem; font-size: 0.72rem; font-weight: 600; cursor: pointer; white-space: nowrap; transition: opacity 0.15s, transform 0.15s; }
  .ai-btn:hover { opacity: 0.9; transform: translateY(-1px); }
  .ai-btn:disabled { opacity: 0.55; cursor: wait; transform: none; }
</style>

<script define:vars={{ subjects: subjects, exams: exams }}>
  // Subject + exam taxonomies embedded at build time (zero D1 reads)
  window.ADMIN_SUBJECTS = subjects;
  window.ADMIN_EXAMS = exams;
</script>
<script is:inline>
  // ========== ADMIN TOP BAR & SETTINGS ==========

  let currentProfile = null;

  // --- Chip management for admin settings ---
  const adminChipData = { affiliation: [], specialty: [], experience: [] };

  function renderAdminChips(field) {
    const container = document.getElementById('admin' + field.charAt(0).toUpperCase() + field.slice(1) + 'Chips');
    if (!container) return;
    container.innerHTML = adminChipData[field].map((val, i) =>
      `<span class="chip">${esc(val)}<button type="button" class="chip-remove" onclick="removeAdminChip('${field}',${i})" title="Remove">&times;</button></span>`
    ).join('');
  }

  function addAdminChip(field) {
    const input = document.getElementById('admin' + field.charAt(0).toUpperCase() + field.slice(1) + 'Input');
    if (!input) return;
    const val = input.value.trim();
    if (!val) return;
    if (adminChipData[field].includes(val)) { input.value = ''; return; }
    adminChipData[field].push(val);
    input.value = '';
    input.focus();
    renderAdminChips(field);
  }

  function removeAdminChip(field, index) {
    adminChipData[field].splice(index, 1);
    renderAdminChips(field);
  }

  // Allow Enter key on admin chip inputs
  ['adminAffiliationInput','adminSpecialtyInput','adminExperienceInput'].forEach(function(id) {
    var el = document.getElementById(id);
    if (el) {
      el.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') { e.preventDefault(); addAdminChip(id.replace('admin','').replace('Input','').toLowerCase()); }
      });
    }
  });

  async function loadUserInfo() {
    try {
      const resp = await fetch('/api/profile/get');
      const data = await resp.json();
      if (data.profile) {
        currentProfile = data.profile;
        document.getElementById('topbarUserName').textContent = data.profile.full_name || data.profile.username;
        // Pre-fill settings form
        document.getElementById('settingsFullName').value = data.profile.full_name || '';
        document.getElementById('settingsEmail').value = data.profile.email || '';
        document.getElementById('settingsBio').value = data.profile.bio || '';
        // Load chips
        adminChipData.affiliation = Array.isArray(data.profile.affiliation) ? data.profile.affiliation : [];
        adminChipData.specialty = Array.isArray(data.profile.specialty) ? data.profile.specialty : [];
        adminChipData.experience = Array.isArray(data.profile.experience) ? data.profile.experience : [];
        renderAdminChips('affiliation');
        renderAdminChips('specialty');
        renderAdminChips('experience');
        // MFA status
        const mfaEnabled = data.profile.mfa_enabled;
        document.getElementById('mfaStatusText').textContent = mfaEnabled ? '✅ MFA is enabled' : '⚠️ MFA is not set up';
        document.getElementById('mfaDisabled').style.display = mfaEnabled ? 'none' : 'block';
      }
    } catch (e) {
      document.getElementById('topbarUserName').textContent = 'Admin';
    }
    highlightActiveTheme();
  }

  // Settings Drawer
  function openSettings() {
    document.getElementById('settingsDrawer').classList.add('open');
    document.getElementById('settingsOverlay').classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeSettings() {
    document.getElementById('settingsDrawer').classList.remove('open');
    document.getElementById('settingsOverlay').classList.remove('open');
    document.body.style.overflow = '';
  }

  // Logout
  function doLogout() {
    if (confirm('Are you sure you want to log out?')) {
      document.cookie = 'session_id=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
      sessionStorage.clear();
      window.location.href = '/admin/login';
    }
  }

  // Save Profile
  async function saveProfile() {
    const msg = document.getElementById('profileMsg');
    try {
      const resp = await fetch('/api/profile/update', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({
          full_name: document.getElementById('settingsFullName').value,
          email: document.getElementById('settingsEmail').value,
          affiliation: adminChipData.affiliation,
          specialty: adminChipData.specialty,
          experience: adminChipData.experience,
          bio: document.getElementById('settingsBio').value,
        })
      });
      const data = await resp.json();
      msg.textContent = data.message || data.error;
      msg.className = data.success ? 'alert alert-success' : 'alert alert-error';
      msg.style.display = 'block';
      if (data.success) loadUserInfo();
    } catch (e) {
      msg.textContent = 'Network error';
      msg.className = 'alert alert-error';
      msg.style.display = 'block';
    }
  }

  // Change Password
  async function changePassword() {
    const msg = document.getElementById('pwdMsg');
    const cur = document.getElementById('settingsCurPwd').value;
    const neu = document.getElementById('settingsNewPwd').value;
    if (!cur || !neu) { msg.textContent = 'Both fields required.'; msg.className = 'alert alert-error'; msg.style.display = 'block'; return; }
    if (neu.length < 8) { msg.textContent = 'New password must be at least 8 characters.'; msg.className = 'alert alert-error'; msg.style.display = 'block'; return; }
    try {
      const resp = await fetch('/api/auth/change-password', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ currentPassword: cur, newPassword: neu })
      });
      const data = await resp.json();
      msg.textContent = data.message || data.error;
      msg.className = data.success ? 'alert alert-success' : 'alert alert-error';
      msg.style.display = 'block';
      if (data.success) { document.getElementById('settingsCurPwd').value = ''; document.getElementById('settingsNewPwd').value = ''; }
    } catch (e) {
      msg.textContent = 'Network error';
      msg.className = 'alert alert-error';
      msg.style.display = 'block';
    }
  }

  // MFA Setup
  async function setupMFA() {
    try {
      const resp = await fetch('/api/auth/setup-totp', { method: 'POST' });
      const data = await resp.json();
      if (data.success) {
        document.getElementById('mfaSecretDisplay').textContent = data.secret;
        document.getElementById('mfaSetupArea').style.display = 'block';
        document.getElementById('mfaDisabled').style.display = 'none';
      }
    } catch (e) { console.error(e); }
  }
  async function verifyMFA() {
    const code = document.getElementById('mfaCode').value;
    const msg = document.getElementById('mfaMsg');
    try {
      const resp = await fetch('/api/auth/verify-totp', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ code })
      });
      const data = await resp.json();
      if (data.success) {
        msg.textContent = 'MFA enabled!';
        msg.className = 'alert alert-success';
        document.getElementById('mfaSetupArea').style.display = 'none';
        document.getElementById('mfaStatusText').textContent = '✅ MFA is enabled';
        document.getElementById('mfaDisabled').style.display = 'none';
      } else {
        msg.textContent = data.error || 'Invalid code';
        msg.className = 'alert alert-error';
      }
      msg.style.display = 'block';
    } catch (e) {
      msg.textContent = 'Error verifying';
      msg.className = 'alert alert-error';
      msg.style.display = 'block';
    }
  }

  // Theme
  function setTheme(theme) {
    if (theme === 'system') {
      localStorage.removeItem('theme');
      const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
    } else {
      localStorage.setItem('theme', theme);
      document.documentElement.setAttribute('data-theme', theme);
    }
    highlightActiveTheme();
  }
  function highlightActiveTheme() {
    const current = localStorage.getItem('theme') || 'system';
    document.querySelectorAll('.theme-opt').forEach(b => {
      b.classList.toggle('active', b.dataset.theme === current);
    });
  }

  // ========== TAB SWITCHING ==========
  document.querySelectorAll('.tab-nav-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-nav-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      const tab = btn.dataset.mainTab;
      document.getElementById(`tab-${tab}`).classList.add('active');
      if (tab === 'applications') loadApplications();
      else if (tab === 'submissions') loadSubmissions();
      else if (tab === 'reviewers') loadReviewersTab();
      else if (tab === 'articles') loadArticles();
      else if (tab === 'images') loadImages();
      else if (tab === 'users') loadUsers();
      else if (tab === 'newsletters') loadNewsletters();
      else if (tab === 'subjects') loadSubjects();
      else if (tab === 'exams') loadExams();
    });
  });

  // Global Dropdown Handler
  window.onclick = function(event) {
    if (!event.target.matches('.dropdown-btn')) {
      var dropdowns = document.getElementsByClassName("dropdown-content");
      for (var i = 0; i < dropdowns.length; i++) {
        var openDropdown = dropdowns[i];
        if (openDropdown.parentElement.classList.contains('show')) {
          openDropdown.parentElement.classList.remove('show');
        }
      }
    }
  }
  function toggleDropdown(id) {
    var el = document.getElementById(id);
    if(el) el.classList.toggle("show");
  }

  // Generic text/pdf download utility
  function downloadTextFile(filename, content) {
    const element = document.createElement('a');
    element.setAttribute('href', 'data:text/plain;charset=utf-8,' + encodeURIComponent(content));
    element.setAttribute('download', filename);
    element.style.display = 'none';
    document.body.appendChild(element);
    element.click();
    document.body.removeChild(element);
  }
  function generatePdfFromHtml(title, htmlContent) {
    const win = window.open('', '', 'height=700,width=700');
    win.document.write(`<html><head><title>${title}</title><style>body{font-family:sans-serif;padding:2rem;line-height:1.6;} h1{border-bottom:1px solid #ccc;padding-bottom:10px;}</style></head><body>`);
    win.document.write(htmlContent);
    win.document.write('</body></html>');
    win.document.close();
    win.setTimeout(() => { win.print(); }, 500);
  }

  let currentAppPage = 1;
  let currentAppSearch = '';

  window.handleAppSearch = function() {
    currentAppSearch = document.getElementById('appSearch').value;
    currentAppPage = 1;
    loadApplications();
  };
  window.changeAppPage = function(delta) {
    currentAppPage += delta;
    loadApplications();
  };

  window._loadedApplications = {};

  async function loadApplications() {
    window._loadedApplications = {};
    const container = document.getElementById('applicationsTable');
    const status = document.getElementById('applicationsStatus');
    
    // Set up controls wrapper if missing
    if (!document.getElementById('appControls')) {
      const controls = document.createElement('div');
      controls.id = 'appControls';
      controls.className = 'table-controls';
      controls.innerHTML = `<input type="text" id="appSearch" class="table-search" placeholder="Search applications..." value="${esc(currentAppSearch)}" onkeyup="if(event.key==='Enter') handleAppSearch()">`;
      container.parentElement.insertBefore(controls, container);
    }

    container.innerHTML = '<p style="color:var(--muted);">Loading...</p>';
    try {
      const params = new URLSearchParams();
      if (currentAppSearch) params.set('q', currentAppSearch);
      params.set('page', currentAppPage);
      params.set('limit', 10);
      
      const resp = await fetch('/api/admin/applications?' + params.toString());
      const data = await resp.json();
      
      if (!data.applications?.length) {
        container.innerHTML = '<p style="color:var(--muted);">No applications found.</p>';
        return;
      }
      
      const p = data.pagination || { totalPages: 1, page: 1 };
      
      let html = `<table class="data-table"><thead><tr>
        <th>Name</th><th>Email</th><th>Experience</th><th>Status</th><th>Date</th><th>Actions</th>
      </tr></thead><tbody>`;
      
      data.applications.forEach(a => {
        window._loadedApplications[a.id] = a;
        html += `
        <tr>
          <td><strong class="truncate" style="max-width:150px;" title="${esc(a.name)}">${esc(a.name)}</strong></td>
          <td><span class="truncate" style="max-width:150px;" title="${esc(a.email)}">${esc(a.email)}</span></td>
          <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${esc(a.writing_experience || '')}</td>
          <td><span class="badge badge-${a.status}">${a.status}</span></td>
          <td>${new Date(a.created_at*1000).toLocaleDateString()}</td>
          <td>
            <div class="dropdown">
              <button onclick="toggleDropdown('app-drop-${a.id}')" class="dropdown-btn">⋮</button>
              <div id="app-drop-${a.id}" class="dropdown-content">
                <button onclick="viewApp(${a.id}, 'view')">👁 View / Edit</button>
                ${a.status==='pending' ? `
                  <button onclick="reviewApp(${a.id},'accept')">✅ Accept</button>
                  <button onclick="reviewApp(${a.id},'reject')">❌ Reject</button>
                ` : `<button disabled style="opacity:0.5;cursor:default;">Reviewed</button>`}
                <button onclick="downloadAppAsText(${a.id})">📄 Download Text</button>
                <button onclick="downloadAppAsPdf(${a.id})">📑 Download PDF</button>
                <button onclick="deleteApp(${a.id})" style="color:#ef4444;">🗑 Delete</button>
              </div>
            </div>
          </td>
        </tr>`;
      });
      html += `</tbody></table>`;
      
      // Pagination controls
      html += `<div class="pagination-ctrl">
        <button class="page-btn" onclick="changeAppPage(-1)" ${p.page <= 1 ? 'disabled' : ''}>&larr; Prev</button>
        <span class="page-info">Page ${p.page} of ${p.totalPages}</span>
        <button class="page-btn" onclick="changeAppPage(1)" ${p.page >= p.totalPages ? 'disabled' : ''}>Next &rarr;</button>
      </div>`;
      
      container.innerHTML = html;
      status.style.display = 'none';
    } catch (e) {
      status.textContent = 'Failed to load applications: ' + e.message;
      status.className = 'alert alert-error';
      status.style.display = 'block';
    }
  }

  window.downloadAppAsText = function(id) {
    const a = window._loadedApplications[id];
    if (!a) return;
    const content = `Applicant: ${a.name}\nEmail: ${a.email}\nStatus: ${a.status}\n\nAbout Me:\n${a.about_me}\n\nExperience:\n${a.writing_experience}\n\nLinks:\n${a.portfolio_links}`;
    downloadTextFile(`Application-${a.name.replace(/\s+/g, '_')}.txt`, content);
  };
  
  window.downloadAppAsPdf = function(id) {
    const a = window._loadedApplications[id];
    if (!a) return;
    const content = `<h1>Applicant: ${esc(a.name)}</h1><p><strong>Email:</strong> ${esc(a.email)}</p><p><strong>Status:</strong> ${a.status}</p><h3>About Me</h3><p>${esc(a.about_me).replace(/\n/g, '<br>')}</p><h3>Experience</h3><p>${esc(a.writing_experience).replace(/\n/g, '<br>')}</p><h3>Links</h3><p>${esc(a.portfolio_links).replace(/\n/g, '<br>')}</p>`;
    generatePdfFromHtml(`Application: ${a.name}`, content);
  };

  async function deleteApp(id) {
    if(!confirm('Delete this application forever?')) return;
    try {
      const resp = await fetch('/api/admin/applications', {
        method: 'DELETE', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ id })
      });
      alert((await resp.json()).message || 'Deleted');
      loadApplications();
    } catch(e) { alert('Error: '+e.message); }
  }

  async function reviewApp(id, action) {
    const reason = action === 'reject' ? (prompt('Reason for rejection (optional):') || '') : '';
    try {
      const resp = await fetch('/api/admin/application-review', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ applicationId: id, action, reason })
      });
      const data = await resp.json();
      alert(data.message || data.error);
      loadApplications();
    } catch (e) {
      alert('Error: ' + e.message);
    }
