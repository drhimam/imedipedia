      if (e.key === 'ArrowDown') { e.preventDefault(); adminActiveIdx = Math.min(adminActiveIdx + 1, options.length - 1); options.forEach(function(o, i) { o.style.background = i === adminActiveIdx ? 'rgba(99,102,241,0.12)' : ''; }); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); adminActiveIdx = Math.max(adminActiveIdx - 1, 0); options.forEach(function(o, i) { o.style.background = i === adminActiveIdx ? 'rgba(99,102,241,0.12)' : ''; }); }
      else if (e.key === 'Enter') {
        e.preventDefault();
        if (adminActiveIdx >= 0 && options[adminActiveIdx]) {
          addAdminEditSubject(options[adminActiveIdx].getAttribute('data-name'));
        } else if (options.length > 0) {
          addAdminEditSubject(options[0].getAttribute('data-name'));
