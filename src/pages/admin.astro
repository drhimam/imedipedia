        if (e.target === overlay) closeAdminViewModal();
      });
    }
    const editOverlay = document.getElementById('adminEditModalOverlay');
    if (editOverlay) {
      editOverlay.addEventListener('click', function(e) {
        if (e.target === editOverlay) closeAdminEditModal();
      });
    }
  });

  async function uploadAdminImage() {
    const fileInput = document.getElementById('adminImageFile');
    const nameInput = document.getElementById('adminImageName');
    const folderInput = document.getElementById('adminImageFolder');
    const status = document.getElementById('imagesStatus');

    if (!fileInput.files[0]) {
      status.textContent = 'Please select a file.';
      status.className = 'alert alert-error';
      status.style.display = 'block';
      return;
    }

    const file = fileInput.files[0];
    if (file.size > 1024 * 1024) {
      status.textContent = 'File too large. Maximum is 1MB.';
      status.className = 'alert alert-error';
      status.style.display = 'block';
      return;
    }

    const base64 = await new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(reader.result);
      reader.onerror = () => reject(reader.error);
      reader.readAsDataURL(file);
    });

    try {
      const resp = await fetch('/api/images/upload', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({
          file: base64,
          name: nameInput.value || file.name,
          description: '',
          folder: folderInput.value
        })
      });
      const data = await resp.json();
      if (data.success) {
        status.textContent = `Uploaded: ${data.url}`;
        status.className = 'alert alert-success';
        fileInput.value = '';
        nameInput.value = '';
        loadImages();
      } else {
        status.textContent = data.error || 'Upload failed.';
        status.className = 'alert alert-error';
      }
      status.style.display = 'block';
    } catch (e) {
      status.textContent = 'Upload error: ' + e.message;
      status.className = 'alert alert-error';
      status.style.display = 'block';
    }
  }

  // --- Helpers ---
  function esc(str) {
    if (!str) return '';
    const d = document.createElement('div');
    d.textContent = String(str);
    return d.innerHTML;
  }

  function formatSize(bytes) {
    if (!bytes) return '0 B';
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1048576) return (bytes/1024).toFixed(1) + ' KB';
    return (bytes/1048576).toFixed(1) + ' MB';
  }

  // ========== SUBJECT MANAGEMENT ==========
  var adminSubjects = window.ADMIN_SUBJECTS ? window.ADMIN_SUBJECTS.slice() : [];
  var adminExams = window.ADMIN_EXAMS ? window.ADMIN_EXAMS.slice() : [];
  var adminEditSelectedSubjects = [];
  var adminEditSelectedExams = [];

  function loadSubjects() {
    renderSubjectsTable();
    refreshParentList();
  }

  function renderSubjectsTable() {
    var container = document.getElementById('subjectsTable');
    // Group by parent
    var groups = {};
    adminSubjects.forEach(function(s, i) {
      var parent = s.parent || 'Uncategorized';
      if (!groups[parent]) groups[parent] = [];
      groups[parent].push({ name: s.name, index: i });
    });
    var parentNames = Object.keys(groups).sort();
    var html = '';
    parentNames.forEach(function(parent) {
      var items = groups[parent];
