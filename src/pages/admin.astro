              <label class="form-label">Newsletter Content &amp; Custom Message (Markdown &amp; HTML) *</label>
              <span style="font-size:0.75rem;color:var(--muted);">Includes 4 categories, links, and editor's note</span>
            </div>
            <textarea class="form-input form-textarea" id="nlEditBody" style="min-height:350px;font-family:monospace;font-size:0.9rem;line-height:1.5;">${esc(iss.body_md || '')}</textarea>
