---
// Admin Dashboard — Applications, Submissions, Articles, Images, Subjects
// SSR-only: verifies admin session on every request
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import subjects from '../data/subjects.json';
const SITE_TITLE = "Admin Dashboard";

// Server-side auth check
if (Astro.request) {
  const cookieHeader = Astro.request.headers.get("cookie") || "";
  const match = cookieHeader.match(/session_id=([^;]+)/);
  const sessionId = match ? match[1] : null;

  if (!sessionId) {
    return Astro.redirect("/admin/login");
  }

  try {
    const db = Astro.locals?.runtime?.env?.D1_DB || Astro.locals?.runtime?.env?.DB;
    if (db) {
      const now = Math.floor(Date.now() / 1000);
      const session = await db.prepare("SELECT * FROM sessions WHERE id = ? AND expires_at > ?")
        .bind(sessionId, now).first();

      if (!session) {
        return Astro.redirect("/admin/login");
      }

      const user = await db.prepare("SELECT * FROM users WHERE id = ?").bind(session.user_id).first();
      if (!user || (user.role !== 'admin' && user.role !== 'co-admin')) {
        return Astro.redirect("/admin/login");
      }
    }
  } catch (err) {
    console.error("Admin auth error:", err.message);
    return Astro.redirect("/admin/login");
  }
}
---

<BaseLayout title={SITE_TITLE}>
  <!-- Admin Top Bar -->
  <header class="admin-topbar" id="adminTopbar">
    <div class="topbar-left">
      <span class="topbar-logo">⚕️ iMedipedia</span>
      <span class="topbar-badge">Admin</span>
    </div>
    <div class="topbar-right">
      <span class="topbar-user" id="topbarUserName">Loading...</span>
      <button class="topbar-btn topbar-settings-btn" onclick="openSettings()" title="Settings">
        <span class="tb-btn-icon">⚙️</span><span class="tb-btn-label">Settings</span>
      </button>
      <span class="topbar-divider"></span>
      <button class="topbar-btn topbar-logout-btn" onclick="doLogout()" title="Logout">
        <span class="tb-btn-icon">↪️</span><span class="tb-btn-label">Logout</span>
      </button>
    </div>
  </header>

  <!-- Settings Drawer Overlay -->
  <div class="drawer-overlay" id="settingsOverlay" onclick="closeSettings()"></div>
  <div class="settings-drawer" id="settingsDrawer">
    <div class="drawer-header">
      <h2>⚙️ Settings</h2>
      <button class="drawer-close" onclick="closeSettings()">✕</button>
    </div>
    <div class="drawer-body">
      <!-- Profile Section -->
      <section class="drawer-section">
        <h3 class="drawer-section-title">Profile</h3>
        <div class="form-group">
          <label class="form-label">Full Name</label>
          <input class="form-input" type="text" id="settingsFullName" placeholder="Your name">
        </div>
        <div class="form-group">
          <label class="form-label">Email</label>
          <input class="form-input" type="email" id="settingsEmail" placeholder="your@email.com">
        </div>
        <div class="form-group">
          <label class="form-label">Affiliation</label>
          <div class="chip-container" id="adminAffiliationChips"></div>
          <div class="chip-input-row">
            <input class="form-input chip-input" type="text" id="adminAffiliationInput" placeholder="Add hospital, institution, or organization">
            <button type="button" class="chip-add-btn" onclick="addAdminChip('affiliation')">＋ Add</button>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Specialty</label>
          <div class="chip-container" id="adminSpecialtyChips"></div>
          <div class="chip-input-row">
            <input class="form-input chip-input" type="text" id="adminSpecialtyInput" placeholder="Add medical specialty">
            <button type="button" class="chip-add-btn" onclick="addAdminChip('specialty')">＋ Add</button>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Experience</label>
          <div class="chip-container" id="adminExperienceChips"></div>
          <div class="chip-input-row">
            <input class="form-input chip-input" type="text" id="adminExperienceInput" placeholder="Add work experience or position">
            <button type="button" class="chip-add-btn" onclick="addAdminChip('experience')">＋ Add</button>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Bio</label>
          <textarea class="form-input form-textarea" id="settingsBio" placeholder="Short bio..." rows="3"></textarea>
        </div>
        <button class="btn btn-sm" onclick="saveProfile()">Save Profile</button>
        <div id="profileMsg" class="alert" style="display:none;margin-top:0.75rem;"></div>
      </section>

      <!-- Password Change -->
      <section class="drawer-section">
        <h3 class="drawer-section-title">Change Password</h3>
        <div class="form-group">
          <label class="form-label">Current Password</label>
          <input class="form-input" type="password" id="settingsCurPwd" placeholder="Current password">
        </div>
        <div class="form-group">
          <label class="form-label">New Password (min 8 chars)</label>
          <input class="form-input" type="password" id="settingsNewPwd" placeholder="New password">
        </div>
        <button class="btn btn-sm" onclick="changePassword()">Update Password</button>
        <div id="pwdMsg" class="alert" style="display:none;margin-top:0.75rem;"></div>
      </section>

      <!-- MFA -->
      <section class="drawer-section">
        <h3 class="drawer-section-title">Two-Factor Authentication</h3>
        <p id="mfaStatusText" style="color:var(--muted);font-size:0.9rem;margin:0 0 0.5rem;">Checking...</p>
        <div id="mfaDisabled" style="display:none;">
          <button class="btn btn-sm btn-secondary" onclick="setupMFA()">Set Up MFA</button>
        </div>
        <div id="mfaSetupArea" style="display:none;">
          <p style="color:var(--muted);font-size:0.85rem;margin:0 0 0.5rem;">Enter this key in your authenticator app:</p>
          <div id="mfaSecretDisplay" style="background:rgba(0,0,0,0.1);padding:0.75rem;border-radius:8px;font-family:monospace;font-size:1rem;text-align:center;word-break:break-all;margin-bottom:0.75rem;"></div>
          <div class="form-group">
            <label class="form-label">Verification Code</label>
            <div style="display:flex;gap:0.5rem;">
              <input class="form-input" type="text" id="mfaCode" placeholder="6-digit code" maxlength="6" style="flex:1;">
              <button class="btn btn-sm" onclick="verifyMFA()">Verify</button>
            </div>
          </div>
        </div>
        <div id="mfaMsg" class="alert" style="display:none;margin-top:0.75rem;"></div>
      </section>

      <!-- Theme -->
      <section class="drawer-section">
        <h3 class="drawer-section-title">Appearance</h3>
        <div class="theme-options" id="themeOptions">
          <button class="theme-opt" data-theme="dark" onclick="setTheme('dark')">🌙 Dark</button>
          <button class="theme-opt" data-theme="light" onclick="setTheme('light')">☀️ Light</button>
          <button class="theme-opt" data-theme="system" onclick="setTheme('system')">💻 System</button>
        </div>
      </section>
    </div>
  </div>

  <main class="main-content" style="max-width:1200px;margin:2rem auto;padding:0 1.5rem;">
    <header class="portal-header" style="text-align:center;margin-bottom:2rem;">
      <h1 style="font-family:'Outfit',sans-serif;font-size:2.5rem;font-weight:800;margin-bottom:0.5rem;">Admin Dashboard</h1>
      <p style="color:var(--muted);font-size:1.1rem;">Manage applications, submissions, articles, and images</p>
    </header>

    <!-- Tab Navigation -->
    <nav class="tab-nav" style="display:flex;gap:0.25rem;border-bottom:1px solid var(--border);margin-bottom:2rem;overflow-x:auto;">
      <button class="tab-nav-btn active" data-main-tab="applications">Applications</button>
      <button class="tab-nav-btn" data-main-tab="submissions">Submissions</button>
      <button class="tab-nav-btn" data-main-tab="articles">Articles</button>
      <button class="tab-nav-btn" data-main-tab="images">Images</button>
      <button class="tab-nav-btn" data-main-tab="subjects">Subjects</button>
    </nav>

    <!-- Applications Tab -->
    <div class="tab-panel active" id="tab-applications">
      <div id="applicationsStatus" class="alert alert-info" style="margin-bottom:1rem;display:none;"></div>
      <div id="applicationsTable" style="overflow-x:auto;"></div>
    </div>

    <!-- Submissions Tab -->
    <div class="tab-panel" id="tab-submissions">
      <div id="submissionsStatus" class="alert alert-info" style="margin-bottom:1rem;display:none;"></div>
      <div id="submissionsTable" style="overflow-x:auto;"></div>
    </div>

    <!-- Articles Tab -->
    <div class="tab-panel" id="tab-articles">
      <div id="articlesStatus" class="alert alert-info" style="margin-bottom:1rem;display:none;"></div>
      <div id="articlesTable" style="overflow-x:auto;"></div>
    </div>

    <!-- Images Tab -->
    <div class="tab-panel" id="tab-images">
      <div id="imagesStatus" class="alert alert-info" style="margin-bottom:1rem;display:none;"></div>
      <div style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:1.5rem;">
        <button class="filter-chip active" data-folder="all" onclick="filterImages('all')">All</button>
        <button class="filter-chip" data-folder="covers" onclick="filterImages('covers')">Covers</button>
        <button class="filter-chip" data-folder="inline" onclick="filterImages('inline')">Inline</button>
        <button class="filter-chip" data-folder="uploads" onclick="filterImages('uploads')">Uploads</button>
      </div>
      <details style="margin-bottom:1.5rem;border:1px solid var(--border);border-radius:8px;padding:1rem;">
        <summary style="cursor:pointer;font-weight:600;">Admin Image Upload</summary>
        <div style="margin-top:1rem;display:flex;flex-wrap:wrap;gap:0.5rem;align-items:flex-end;">
          <div><label style="font-size:0.8rem;display:block;margin-bottom:0.25rem;">Name</label><input type="text" id="adminImageName" placeholder="Image name" style="padding:0.5rem;border-radius:6px;border:1px solid var(--border);background:var(--bg);color:var(--text);min-width:150px;"></div>
          <div><label style="font-size:0.8rem;display:block;margin-bottom:0.25rem;">Folder</label><select id="adminImageFolder" style="padding:0.5rem;border-radius:6px;border:1px solid var(--border);background:var(--bg);color:var(--text);"><option value="uploads">Uploads</option><option value="covers">Covers</option><option value="inline">Inline</option></select></div>
          <div><label style="font-size:0.8rem;display:block;margin-bottom:0.25rem;">File (max 1MB)</label><input type="file" id="adminImageFile" accept="image/*" style="padding:0.5rem;"></div>
          <button class="btn" onclick="uploadAdminImage()" style="padding:0.5rem 1rem;font-size:0.9rem;">Upload</button>
        </div>
      </details>
      <div id="imagesTable" style="overflow-x:auto;"></div>
    </div>

    <!-- Subjects Tab -->
    <div class="tab-panel" id="tab-subjects">
      <div id="subjectsStatus" class="alert" style="margin-bottom:1rem;display:none;"></div>
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;flex-wrap:wrap;gap:0.5rem;">
        <h3 style="font-family:'Outfit',sans-serif;margin:0;font-size:1.2rem;">Managed Subject Taxonomy</h3>
        <div style="display:flex;gap:0.5rem;">
          <button class="btn btn-sm" onclick="addNewSubject()">＋ Add Subject</button>
          <button class="btn btn-sm btn-secondary" onclick="saveSubjectsToGitHub()">💾 Save to GitHub</button>
        </div>
      </div>
      <p style="color:var(--muted);font-size:0.9rem;margin-bottom:1.5rem;">Manage the controlled subject list. Contributors select from these subjects when submitting articles. Changes deploy when you save to GitHub (~2 min).</p>
      <!-- Add/Edit inline form -->
      <div id="subjEditRow" style="display:none;border:1px solid var(--accent);border-radius:8px;padding:1rem;margin-bottom:1rem;background:rgba(99,102,241,0.05);">
        <div style="display:flex;gap:0.75rem;align-items:flex-end;flex-wrap:wrap;">
          <div class="form-group" style="flex:1;min-width:200px;">
            <label class="form-label">Subject Name</label>
            <input class="form-input" type="text" id="subjEditName" placeholder="e.g., Respiratory Physiology" maxlength="200">
          </div>
          <div class="form-group" style="flex:1;min-width:150px;">
            <label class="form-label">Parent / Group</label>
            <input class="form-input" type="text" id="subjEditParent" placeholder="e.g., Physiology" maxlength="200" list="parentList">
            <datalist id="parentList"></datalist>
          </div>
          <div style="display:flex;gap:0.5rem;padding-bottom:0.25rem;">
            <button class="btn btn-sm" id="subjSaveBtn" onclick="saveSubjectEdit()">Save</button>
            <button class="btn btn-sm btn-secondary" onclick="cancelSubjectEdit()">Cancel</button>
          </div>
        </div>
        <input type="hidden" id="subjEditIndex" value="-1">
      </div>
      <div id="subjectsTable" style="overflow-x:auto;"></div>
    </div>
  </main>

  <!-- Admin View Submission Modal -->
  <div class="view-modal-overlay" id="adminViewModalOverlay" style="display:none;">
    <div class="view-modal" id="adminViewModalContent"></div>
  </div>

  <!-- Admin Edit Submission Modal -->
  <div class="view-modal-overlay" id="adminEditModalOverlay" style="display:none;">
    <div class="view-modal" style="max-width:750px;">
      <div class="view-modal-header">
        <button class="view-modal-close" onclick="closeAdminEditModal()">&times;</button>
        <h2>✏️ Edit Submission</h2>
      </div>
      <div id="adminEditStatus" class="alert" style="display:none;margin-bottom:1rem;"></div>
      <form id="adminEditForm" class="edit-modal-form" onsubmit="return false;">
        <input type="hidden" id="adminEditId">
        <div class="form-group">
          <label class="form-label">Title *</label>
          <input class="form-input" type="text" id="adminEditTitle" required maxlength="500">
        </div>
        <div class="form-group">
          <label class="form-label">Author</label>
          <input class="form-input" type="text" id="adminEditAuthor">
        </div>
        <div style="display:flex;gap:0.75rem;">
          <div class="form-group" style="flex:1;">
            <label class="form-label">Type</label>
            <select class="form-input" id="adminEditType">
              <option value="general">Clinical Digest</option>
              <option value="update">Clinical Guidelines</option>
              <option value="case">Case Reports</option>
              <option value="education">Board Review</option>
            </select>
          </div>
          <div class="form-group" style="flex:1;">
            <label class="form-label">Subject</label>
            <input class="form-input" type="text" id="adminEditSubject" maxlength="200">
          </div>
          <div class="form-group" style="flex:1;">
            <label class="form-label">Topic</label>
            <input class="form-input" type="text" id="adminEditTopic" maxlength="200">
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Subjects</label>
          <div style="position:relative;">
            <input class="form-input" type="text" id="adminEditSubjectSearch" placeholder="Search subjects..." autocomplete="off">
            <div id="adminEditSubjectDropdown" class="subject-dropdown" style="display:none;position:absolute;top:100%;left:0;right:0;background:var(--card-bg);border:1px solid var(--border);border-radius:8px;max-height:200px;overflow-y:auto;z-index:10;box-shadow:0 8px 24px rgba(0,0,0,0.2);"></div>
          </div>
          <div id="adminEditSubjectChips" style="display:flex;flex-wrap:wrap;gap:0.4rem;margin-top:0.5rem;"></div>
        </div>
        <div class="form-group">
          <label class="form-label">Description</label>
          <input class="form-input" type="text" id="adminEditDescription" maxlength="1000">
        </div>
        <div class="form-group">
          <label class="form-label">Article Content (Markdown) *</label>
          <textarea class="form-input" id="adminEditBody" required></textarea>
        </div>
        <div class="edit-modal-actions">
          <button type="button" class="topbar-btn" onclick="closeAdminEditModal()" style="padding:0.6rem 1.25rem;">Cancel</button>
          <button type="button" class="btn" onclick="saveAdminEdit()">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</BaseLayout>

<style>
  /* Admin Top Bar */
  .admin-topbar {
    display: flex; justify-content: space-between; align-items: center;
    padding: 0.6rem 1rem; background: var(--card-bg);
    border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 50;
    backdrop-filter: blur(10px); gap: 0.5rem;
  }
  .topbar-left { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }
  .topbar-logo { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 1rem; white-space: nowrap; }
  .topbar-badge { background: var(--accent); color: white; padding: 0.15rem 0.5rem; border-radius: 20px; font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
  .topbar-right { display: flex; align-items: center; gap: 0.4rem; flex-shrink: 0; }
  .topbar-user { font-size: 0.8rem; color: var(--muted); max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .topbar-divider { width: 1px; height: 24px; background: var(--border); margin: 0 0.25rem; }
  .topbar-btn {
    background: transparent; border: 1px solid var(--border); color: var(--text);
    border-radius: 8px; cursor: pointer; font-size: 0.85rem; font-weight: 600;
    display: flex; align-items: center; gap: 0.35rem; padding: 0.45rem 0.75rem;
    transition: all 0.15s; white-space: nowrap; font-family: inherit;
  }
  .topbar-btn:hover { background: var(--accent); color: white; border-color: var(--accent); }
  .topbar-settings-btn:hover { background: var(--accent); color: white; border-color: var(--accent); }
  .topbar-logout-btn { color: #ef4444; border-color: rgba(239,68,68,0.3); }
  .topbar-logout-btn:hover { background: #ef4444; color: white; border-color: #ef4444; }
  .tb-btn-icon { font-size: 1rem; line-height: 1; }
  .tb-btn-label { font-size: 0.8rem; }

  @media (max-width: 640px) {
    .topbar-logo { font-size: 0.85rem; }
    .topbar-user { display: none; }
    .topbar-btn { padding: 0.4rem 0.55rem; }
    .tb-btn-label { display: none; }
    .tb-btn-icon { font-size: 1.15rem; }
    .topbar-badge { display: none; }
  }

  /* Settings Drawer */
  .drawer-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 90; opacity: 0; pointer-events: none; transition: opacity 0.25s; }
  .drawer-overlay.open { opacity: 1; pointer-events: auto; }
  .settings-drawer { position: fixed; top: 0; right: 0; width: 420px; max-width: 90vw; height: 100%; background: var(--card-bg); z-index: 100; transform: translateX(100%); transition: transform 0.3s cubic-bezier(0.4,0,0.2,1); overflow-y: auto; box-shadow: -4px 0 30px rgba(0,0,0,0.2); }
  .settings-drawer.open { transform: translateX(0); }
  .drawer-header { display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border); position: sticky; top: 0; background: var(--card-bg); z-index: 1; }
  .drawer-header h2 { font-family: 'Outfit', sans-serif; font-size: 1.3rem; font-weight: 700; margin: 0; }
  .drawer-close { background: transparent; border: none; color: var(--muted); font-size: 1.3rem; cursor: pointer; width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; }
  .drawer-close:hover { background: rgba(239,68,68,0.1); color: #ef4444; }
  .drawer-body { padding: 1.5rem; display: flex; flex-direction: column; gap: 1.5rem; }
  .drawer-section { border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; }
  .drawer-section-title { font-family: 'Outfit', sans-serif; font-size: 1rem; font-weight: 700; margin: 0 0 1rem; }

  /* Forms */
  .form-group { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 0.75rem; }
  .form-label { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); }
  .form-input { padding: 0.6rem 0.75rem; border-radius: 6px; border: 1px solid var(--border); background: rgba(0,0,0,0.08); color: var(--text); font-size: 0.9rem; width: 100%; box-sizing: border-box; }
  :global([data-theme="light"]) .form-input { background: rgba(255,255,255,0.8); }
  .form-input:focus { outline: none; border-color: var(--accent); }
  .form-textarea { resize: vertical; min-height: 60px; font-family: inherit; }
  /* Chip styles for multi-value fields */
  .chip-container { display: flex; flex-wrap: wrap; gap: 0.4rem; min-height: 0; margin-bottom: 0.25rem; }
  .chip { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.3rem 0.55rem; background: var(--accent); color: #fff; border-radius: 20px; font-size: 0.8rem; font-weight: 500; animation: chipIn 0.2s ease-out; }
  @keyframes chipIn { from { transform: scale(0.8); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  .chip-remove { background: transparent; border: none; color: rgba(255,255,255,0.8); cursor: pointer; font-size: 0.9rem; line-height: 1; padding: 0; width: 16px; height: 16px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
  .chip-remove:hover { color: #fff; background: rgba(255,255,255,0.2); }
  .chip-input-row { display: flex; gap: 0.4rem; }
  .chip-input { flex: 1; min-width: 0; }
  .chip-add-btn { padding: 0.5rem 0.7rem; border-radius: 6px; border: 1px dashed var(--border); background: transparent; color: var(--accent); cursor: pointer; font-size: 0.8rem; font-weight: 600; white-space: nowrap; font-family: inherit; }
  .chip-add-btn:hover { background: var(--accent); color: #fff; border-color: var(--accent); }
  .btn { background: var(--accent); color: #fff; border: none; padding: 0.7rem 1.25rem; font-size: 0.9rem; font-weight: 700; border-radius: 8px; cursor: pointer; transition: opacity 0.15s; }
  .btn:hover { opacity: 0.9; }
  .btn-sm { padding: 0.5rem 1rem; font-size: 0.85rem; }
  .btn-secondary { background: transparent; border: 1px solid var(--accent); color: var(--accent); }
  .btn-secondary:hover { background: var(--accent); color: white; opacity: 1; }
  .btn:disabled { opacity: 0.5; cursor: not-allowed; }

  /* Theme Options */
  .theme-options { display: flex; gap: 0.5rem; }
  .theme-opt { font-family: inherit; flex: 1; padding: 0.6rem; border-radius: 8px; border: 1px solid var(--border); background: transparent; color: var(--text); cursor: pointer; font-size: 0.85rem; font-weight: 600; transition: all 0.15s; }
  .theme-opt:hover { border-color: var(--accent); }
  .theme-opt.active { background: var(--accent); color: white; border-color: var(--accent); }

  /* Alert */
  .alert { padding: 0.6rem 0.75rem; border-radius: 6px; font-size: 0.8rem; }
  .alert-success { background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3); color: #10b981; }
  .alert-error { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #ef4444; }
  .alert-info { background: rgba(59,130,246,0.1); border: 1px solid rgba(59,130,246,0.3); color: #3b82f6; }

  /* Tab Navigation */
  .tab-nav-btn { cursor: pointer; font-family: inherit;
    background: transparent;
    border: none;
    padding: 0.75rem 1.25rem;
    color: var(--muted);
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 600;
    border-bottom: 2px solid transparent;
    transition: all 0.2s;
  }
  .tab-nav-btn:hover { color: var(--text); }
  .tab-nav-btn.active { color: var(--accent); border-bottom-color: var(--accent); }
  .tab-panel { display: none; }
  .tab-panel.active { display: block; }
  .filter-chip { font-family: inherit;
    padding: 0.4rem 0.8rem;
    border-radius: 20px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 500;
    transition: all 0.2s;
  }
  .filter-chip:hover { border-color: var(--accent); color: var(--accent); }
  .filter-chip.active { background: var(--accent); color: white; border-color: var(--accent); }
  .data-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .data-table th { text-align: left; padding: 0.75rem; background: rgba(99,102,241,0.08); border-bottom: 1px solid var(--border); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); }
  .data-table td { padding: 0.75rem; border-bottom: 1px solid var(--border); }
  .data-table tr:hover td { background: rgba(99,102,241,0.03); }
  .badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 20px; font-size: 0.75rem; font-weight: 600; }
  .badge-pending { background: rgba(251,191,36,0.15); color: #f59e0b; }
  .badge-approved { background: rgba(16,185,129,0.15); color: #10b981; }
  .badge-rejected { background: rgba(239,68,68,0.15); color: #ef4444; }
  .badge-published { background: rgba(99,102,241,0.15); color: #6366f1; }
  .action-btn { font-family: inherit; padding: 0.35rem 0.75rem; border-radius: 6px; border: none; cursor: pointer; font-size: 0.8rem; font-weight: 600; margin: 0 0.15rem; transition: all 0.15s; }
  .action-btn:hover { transform: translateY(-1px); }
  .btn-approve { background: #10b981; color: white; }
  .btn-reject { background: #ef4444; color: white; }
  .btn-publish { background: #6366f1; color: white; }
  .btn-copy { background: var(--accent); color: white; }
  .btn-delete { background: var(--border); color: var(--text); }
  .btn-delete-sm { background: transparent; border: 1px solid var(--border); color: var(--muted); padding: 0.35rem 0.5rem; margin: 0 0.15rem; }
  .btn-delete-sm:hover { background: rgba(239,68,68,0.1); border-color: #ef4444; color: #ef4444; }
  .btn-view-admin { background: transparent; border: 1px solid var(--border); color: var(--muted); padding: 0.35rem 0.5rem; margin: 0 0.15rem; }
  .btn-view-admin:hover { background: rgba(16,185,129,0.1); border-color: #10b981; }
  .btn-edit-admin { background: transparent; border: 1px solid var(--border); color: var(--muted); padding: 0.35rem 0.5rem; margin: 0 0.15rem; }
  .btn-edit-admin:hover { background: rgba(59,130,246,0.1); border-color: #3b82f6; }
  .copy-tooltip { position: relative; }
  .img-thumb { width: 48px; height: 48px; object-fit: cover; border-radius: 6px; border: 1px solid var(--border); }
  /* Admin View Modal */
  .view-modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 998; display: flex; align-items: center; justify-content: center; animation: modalFadeIn 0.2s ease-out; }
  @keyframes modalFadeIn { from { opacity: 0; } to { opacity: 1; } }
  .view-modal { background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; padding: 2rem; max-width: 700px; width: 90%; max-height: 85vh; overflow-y: auto; animation: modalPopIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
  @keyframes modalPopIn { from { transform: scale(0.85); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  .view-modal h2 { font-family: 'Outfit', sans-serif; font-size: 1.4rem; font-weight: 700; margin: 0 0 0.75rem 0; }
  .view-modal-meta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem; font-size: 0.85rem; color: var(--muted); }
  .view-modal-body { background: rgba(0,0,0,0.05); border: 1px solid var(--border); border-radius: 8px; padding: 1.25rem; font-size: 0.95rem; line-height: 1.7; white-space: pre-wrap; word-break: break-word; max-height: 400px; overflow-y: auto; font-family: inherit; }
  :global([data-theme="light"]) .view-modal-body { background: rgba(0,0,0,0.02); }
  .view-modal-close { position: absolute; top: 1rem; right: 1rem; background: transparent; border: none; color: var(--muted); font-size: 1.3rem; cursor: pointer; width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; }
  .view-modal-close:hover { background: rgba(239,68,68,0.1); color: #ef4444; }
  .view-modal-header { position: relative; }
  /* Edit Modal form */
  .edit-modal-form { display: flex; flex-direction: column; gap: 0.75rem; }
  .edit-modal-form .form-group { margin-bottom: 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .edit-modal-form .form-label { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); }
  .edit-modal-form .form-input { padding: 0.6rem 0.75rem; border-radius: 6px; border: 1px solid var(--border); background: rgba(0,0,0,0.08); color: var(--text); font-size: 0.9rem; width: 100%; box-sizing: border-box; }
  :global([data-theme="light"]) .edit-modal-form .form-input { background: rgba(255,255,255,0.8); }
  .edit-modal-form .form-input:focus { outline: none; border-color: var(--accent); }
  .edit-modal-form textarea.form-input { resize: vertical; min-height: 150px; font-family: inherit; }
  .edit-modal-actions { display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 0.5rem; }
</style>

<script define:vars={{ subjects: subjects }}>
  // Subject taxonomy embedded at build time (zero D1 reads)
  window.ADMIN_SUBJECTS = subjects;
</script>
<script is:inline>
  // ========== ADMIN TOP BAR & SETTINGS ==========

  let currentProfile = null;

  // --- Chip management for admin settings ---
  const adminChipData = { affiliation: [], specialty: [], experience: [] };

  function renderAdminChips(field) {
    const container = document.getElementById('admin' + field.charAt(0).toUpperCase() + field.slice(1) + 'Chips');
    if (!container) return;
    container.innerHTML = adminChipData[field].map((val, i) =>
      `<span class="chip">${esc(val)}<button type="button" class="chip-remove" onclick="removeAdminChip('${field}',${i})" title="Remove">&times;</button></span>`
    ).join('');
  }

  function addAdminChip(field) {
    const input = document.getElementById('admin' + field.charAt(0).toUpperCase() + field.slice(1) + 'Input');
    if (!input) return;
    const val = input.value.trim();
    if (!val) return;
    if (adminChipData[field].includes(val)) { input.value = ''; return; }
    adminChipData[field].push(val);
    input.value = '';
    input.focus();
    renderAdminChips(field);
  }

  function removeAdminChip(field, index) {
    adminChipData[field].splice(index, 1);
    renderAdminChips(field);
  }

  // Allow Enter key on admin chip inputs
  ['adminAffiliationInput','adminSpecialtyInput','adminExperienceInput'].forEach(function(id) {
    var el = document.getElementById(id);
    if (el) {
      el.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') { e.preventDefault(); addAdminChip(id.replace('admin','').replace('Input','').toLowerCase()); }
      });
    }
  });

  async function loadUserInfo() {
    try {
      const resp = await fetch('/api/profile/get');
      const data = await resp.json();
      if (data.profile) {
        currentProfile = data.profile;
        document.getElementById('topbarUserName').textContent = data.profile.full_name || data.profile.username;
        // Pre-fill settings form
        document.getElementById('settingsFullName').value = data.profile.full_name || '';
        document.getElementById('settingsEmail').value = data.profile.email || '';
        document.getElementById('settingsBio').value = data.profile.bio || '';
        // Load chips
        adminChipData.affiliation = Array.isArray(data.profile.affiliation) ? data.profile.affiliation : [];
        adminChipData.specialty = Array.isArray(data.profile.specialty) ? data.profile.specialty : [];
        adminChipData.experience = Array.isArray(data.profile.experience) ? data.profile.experience : [];
        renderAdminChips('affiliation');
        renderAdminChips('specialty');
        renderAdminChips('experience');
        // MFA status
        const mfaEnabled = data.profile.mfa_enabled;
        document.getElementById('mfaStatusText').textContent = mfaEnabled ? '✅ MFA is enabled' : '⚠️ MFA is not set up';
        document.getElementById('mfaDisabled').style.display = mfaEnabled ? 'none' : 'block';
      }
    } catch (e) {
      document.getElementById('topbarUserName').textContent = 'Admin';
    }
    highlightActiveTheme();
  }

  // Settings Drawer
  function openSettings() {
    document.getElementById('settingsDrawer').classList.add('open');
    document.getElementById('settingsOverlay').classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeSettings() {
    document.getElementById('settingsDrawer').classList.remove('open');
    document.getElementById('settingsOverlay').classList.remove('open');
    document.body.style.overflow = '';
  }

  // Logout
  function doLogout() {
    if (confirm('Are you sure you want to log out?')) {
      document.cookie = 'session_id=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
      sessionStorage.clear();
      window.location.href = '/admin/login';
    }
  }

  // Save Profile
  async function saveProfile() {
    const msg = document.getElementById('profileMsg');
    try {
      const resp = await fetch('/api/profile/update', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({
          full_name: document.getElementById('settingsFullName').value,
          email: document.getElementById('settingsEmail').value,
          affiliation: adminChipData.affiliation,
          specialty: adminChipData.specialty,
          experience: adminChipData.experience,
          bio: document.getElementById('settingsBio').value,
        })
      });
      const data = await resp.json();
      msg.textContent = data.message || data.error;
      msg.className = data.success ? 'alert alert-success' : 'alert alert-error';
      msg.style.display = 'block';
      if (data.success) loadUserInfo();
    } catch (e) {
      msg.textContent = 'Network error';
      msg.className = 'alert alert-error';
      msg.style.display = 'block';
    }
  }

  // Change Password
  async function changePassword() {
    const msg = document.getElementById('pwdMsg');
    const cur = document.getElementById('settingsCurPwd').value;
    const neu = document.getElementById('settingsNewPwd').value;
    if (!cur || !neu) { msg.textContent = 'Both fields required.'; msg.className = 'alert alert-error'; msg.style.display = 'block'; return; }
    if (neu.length < 8) { msg.textContent = 'New password must be at least 8 characters.'; msg.className = 'alert alert-error'; msg.style.display = 'block'; return; }
    try {
      const resp = await fetch('/api/auth/change-password', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ currentPassword: cur, newPassword: neu })
      });
      const data = await resp.json();
      msg.textContent = data.message || data.error;
      msg.className = data.success ? 'alert alert-success' : 'alert alert-error';
      msg.style.display = 'block';
      if (data.success) { document.getElementById('settingsCurPwd').value = ''; document.getElementById('settingsNewPwd').value = ''; }
    } catch (e) {
      msg.textContent = 'Network error';
      msg.className = 'alert alert-error';
      msg.style.display = 'block';
    }
  }

  // MFA Setup
  async function setupMFA() {
    try {
      const resp = await fetch('/api/auth/setup-totp', { method: 'POST' });
      const data = await resp.json();
      if (data.success) {
        document.getElementById('mfaSecretDisplay').textContent = data.secret;
        document.getElementById('mfaSetupArea').style.display = 'block';
        document.getElementById('mfaDisabled').style.display = 'none';
      }
    } catch (e) { console.error(e); }
  }
  async function verifyMFA() {
    const code = document.getElementById('mfaCode').value;
    const msg = document.getElementById('mfaMsg');
    try {
      const resp = await fetch('/api/auth/verify-totp', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ code })
      });
      const data = await resp.json();
      if (data.success) {
        msg.textContent = 'MFA enabled!';
        msg.className = 'alert alert-success';
        document.getElementById('mfaSetupArea').style.display = 'none';
        document.getElementById('mfaStatusText').textContent = '✅ MFA is enabled';
        document.getElementById('mfaDisabled').style.display = 'none';
      } else {
        msg.textContent = data.error || 'Invalid code';
        msg.className = 'alert alert-error';
      }
      msg.style.display = 'block';
    } catch (e) {
      msg.textContent = 'Error verifying';
      msg.className = 'alert alert-error';
      msg.style.display = 'block';
    }
  }

  // Theme
  function setTheme(theme) {
    if (theme === 'system') {
      localStorage.removeItem('theme');
      const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
    } else {
      localStorage.setItem('theme', theme);
      document.documentElement.setAttribute('data-theme', theme);
    }
    highlightActiveTheme();
  }
  function highlightActiveTheme() {
    const current = localStorage.getItem('theme') || 'system';
    document.querySelectorAll('.theme-opt').forEach(b => {
      b.classList.toggle('active', b.dataset.theme === current);
    });
  }

  // ========== TAB SWITCHING ==========
  document.querySelectorAll('.tab-nav-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-nav-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      const tab = btn.dataset.mainTab;
      document.getElementById(`tab-${tab}`).classList.add('active');
      if (tab === 'applications') loadApplications();
      else if (tab === 'submissions') loadSubmissions();
      else if (tab === 'articles') loadArticles();
      else if (tab === 'images') loadImages();
      else if (tab === 'subjects') loadSubjects();
    });
  });

  // --- Applications ---
  async function loadApplications() {
    const container = document.getElementById('applicationsTable');
    const status = document.getElementById('applicationsStatus');
    container.innerHTML = '<p style="color:var(--muted);">Loading...</p>';
    try {
      const resp = await fetch('/api/admin/applications');
      const data = await resp.json();
      if (!data.applications?.length) {
        container.innerHTML = '<p style="color:var(--muted);">No applications found.</p>';
        return;
      }
      container.innerHTML = `<table class="data-table"><thead><tr>
        <th>Name</th><th>Email</th><th>Experience</th><th>Status</th><th>Date</th><th>Actions</th>
      </tr></thead><tbody>${data.applications.map(a => `
        <tr>
          <td><strong>${esc(a.name)}</strong></td>
          <td>${esc(a.email)}</td>
          <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${esc(a.writing_experience || '')}</td>
          <td><span class="badge badge-${a.status}">${a.status}</span></td>
          <td>${new Date(a.created_at*1000).toLocaleDateString()}</td>
          <td>${a.status==='pending' ? `
            <button class="action-btn btn-approve" onclick="reviewApp(${a.id},'accept')">Accept</button>
            <button class="action-btn btn-reject" onclick="reviewApp(${a.id},'reject')">Reject</button>
          ` : `<button class="action-btn" disabled style="opacity:0.5;">Reviewed</button>`}</td>
        </tr>
      `).join('')}</tbody></table>`;
      status.style.display = 'none';
    } catch (e) {
      status.textContent = 'Failed to load applications: ' + e.message;
      status.className = 'alert alert-error';
      status.style.display = 'block';
    }
  }

  async function reviewApp(id, action) {
    const reason = action === 'reject' ? (prompt('Reason for rejection (optional):') || '') : '';
    try {
      const resp = await fetch('/api/admin/application-review', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ applicationId: id, action, reason })
      });
      const data = await resp.json();
      alert(data.message || data.error);
      loadApplications();
    } catch (e) {
      alert('Error: ' + e.message);
    }
  }

  // --- Submissions ---
  async function loadSubmissions() {
    const container = document.getElementById('submissionsTable');
    container.innerHTML = '<p style="color:var(--muted);">Loading...</p>';
    try {
      const resp = await fetch('/api/admin/submissions');
      const data = await resp.json();
      if (!data.submissions?.length) {
        container.innerHTML = '<p style="color:var(--muted);">No submissions found.</p>';
        return;
      }
      container.innerHTML = `<table class="data-table"><thead><tr>
        <th>Title</th><th>Author</th><th>Type</th><th>Status</th><th>Date</th><th>Actions</th>
      </tr></thead><tbody>${data.submissions.map(s => `
        <tr>
          <td><strong>${esc(s.title)}</strong></td>
          <td>${esc(s.author || s.author_name || '')}</td>
          <td>${esc(s.type || 'general')}</td>
          <td><span class="badge badge-${s.status === 'published' ? 'approved' : s.status}">${s.status}</span></td>
          <td>${new Date(s.created_at*1000).toLocaleDateString()}</td>
          <td>
            <button class="action-btn btn-view-admin" onclick="viewAdminSubmission(${s.id})" title="View">👁</button>
            <button class="action-btn btn-edit-admin" onclick="editAdminSubmission(${s.id})" title="Edit">✏️</button>
            ${s.status==='pending' ? `
              <button class="action-btn btn-approve" onclick="reviewSub(${s.id},'approve')">Approve</button>
              <button class="action-btn btn-reject" onclick="reviewSub(${s.id},'reject')">Reject</button>
            ` : s.status==='approved' ? `
              <button class="action-btn btn-publish" onclick="publishArticle(${s.id})">Publish</button>
            ` : ''}
            <button class="action-btn btn-delete-sm" onclick="deleteAdminSubmission(${s.id})" title="Delete">🗑</button>
          </td>
        </tr>
      `).join('')}</tbody></table>`;
    } catch (e) {
      container.innerHTML = `<p class="alert alert-error">Error: ${esc(e.message)}</p>`;
    }
  }

  async function reviewSub(id, action) {
    const notes = action === 'reject' ? (prompt('Review notes (optional):') || '') : '';
    try {
      const resp = await fetch('/api/admin/review', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ submissionId: id, action, notes })
      });
      const data = await resp.json();
      alert(data.message || data.error);
      loadSubmissions();
    } catch (e) {
      alert('Error: ' + e.message);
    }
  }

  async function publishArticle(id) {
    if (!confirm('Publish this article? This will push to GitHub.')) return;
    try {
      const resp = await fetch('/api/admin/publish', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ submissionId: id })
      });
      const data = await resp.json();
      alert(data.message || data.error);
      loadSubmissions();
    } catch (e) {
      alert('Error: ' + e.message);
    }
  }

  // --- Articles ---
  async function loadArticles() {
    const container = document.getElementById('articlesTable');
    container.innerHTML = '<p style="color:var(--muted);">Loading...</p>';
    try {
      const resp = await fetch('/api/admin/articles');
      const data = await resp.json();
      if (!data.articles?.length) {
        container.innerHTML = '<p style="color:var(--muted);">No published articles found.</p>';
        return;
      }
      container.innerHTML = `<table class="data-table"><thead><tr>
        <th>File</th><th>Path</th><th>Actions</th>
      </tr></thead><tbody>${data.articles.map(a => `
        <tr>
          <td><strong>${esc(a.name)}</strong></td>
          <td style="font-family:monospace;font-size:0.85rem;">${esc(a.path)}</td>
          <td><a href="${esc(a.url)}" target="_blank" class="action-btn btn-publish" style="text-decoration:none;">View on GitHub</a></td>
        </tr>
      `).join('')}</tbody></table>`;
      if (data.message) container.innerHTML += `<p style="color:var(--muted);margin-top:0.5rem;">${esc(data.message)}</p>`;
    } catch (e) {
      container.innerHTML = `<p class="alert alert-error">Error: ${esc(e.message)}</p>`;
    }
  }

  // --- Images ---
  let currentImageFolder = 'all';

  async function loadImages(folder = currentImageFolder) {
    const container = document.getElementById('imagesTable');
    const status = document.getElementById('imagesStatus');
    container.innerHTML = '<p style="color:var(--muted);">Loading...</p>';
    try {
      const params = new URLSearchParams();
      if (folder && folder !== 'all') params.set('folder', folder);
      const resp = await fetch(`/api/admin/images?${params}`);
      const data = await resp.json();
      if (!data.images?.length) {
        container.innerHTML = '<p style="color:var(--muted);">No images found.</p>';
        return;
      }
      container.innerHTML = `<table class="data-table"><thead><tr>
        <th></th><th>Name</th><th>Key</th><th>Folder</th><th>Size</th><th>Date</th><th>Actions</th>
      </tr></thead><tbody>${data.images.map(img => `
        <tr>
          <td><img src="${esc(img.url)}" class="img-thumb" alt="" loading="lazy" onerror="this.style.display='none'"></td>
          <td><strong>${esc(img.name)}</strong></td>
          <td style="font-family:monospace;font-size:0.8rem;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${esc(img.key)}</td>
          <td><span class="badge badge-pending">${esc(img.folder)}</span></td>
          <td>${formatSize(img.size_bytes)}</td>
          <td>${new Date(img.created_at*1000).toLocaleDateString()}</td>
          <td>
            <button class="action-btn btn-copy" onclick="copyImageUrl('${esc(img.url).replace(/'/g, "\\'")}')">Copy URL</button>
            <button class="action-btn btn-delete" onclick="deleteImage(${img.id},'${esc(img.key).replace(/'/g, "\\'")}')">Delete</button>
          </td>
        </tr>
      `).join('')}</tbody></table>`;
    } catch (e) {
      container.innerHTML = `<p class="alert alert-error">Error: ${esc(e.message)}</p>`;
    }
  }

  function filterImages(folder) {
    currentImageFolder = folder;
    document.querySelectorAll('#tab-images .filter-chip').forEach(c => c.classList.remove('active'));
    document.querySelector(`#tab-images [data-folder="${folder}"]`)?.classList.add('active');
    loadImages(folder);
  }

  function copyImageUrl(url) {
    navigator.clipboard.writeText(url).then(() => {
      alert('Image URL copied!');
    }).catch(() => {
      prompt('Copy this URL:', url);
    });
  }

  async function deleteImage(id, key) {
    if (!confirm(`Delete image "${key}"? This cannot be undone.`)) return;
    try {
      const resp = await fetch('/api/admin/images', {
        method: 'DELETE', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ id, key })
      });
      const data = await resp.json();
      alert(data.message || data.error);
      loadImages();
    } catch (e) {
      alert('Error: ' + e.message);
    }
  }

  // --- Admin View Submission ---
  async function viewAdminSubmission(id) {
    try {
      const resp = await fetch('/api/submissions/' + id);
      const data = await resp.json();
      if (!data.success) { alert(data.error); return; }
      const s = data.submission;
      const date = new Date(s.created_at*1000).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      let subjectsDisplay = '';
      try {
        var subjParsed = JSON.parse(s.subject || '[]');
        if (Array.isArray(subjParsed) && subjParsed.length > 0) {
          subjectsDisplay = subjParsed.join(', ');
        } else {
          var tagParsed = JSON.parse(s.tag || '[]');
          subjectsDisplay = Array.isArray(tagParsed) ? tagParsed.join(', ') : (s.tag || '—');
        }
      } catch(e) { subjectsDisplay = s.subject || s.tag || '—'; }
      const modal = document.getElementById('adminViewModalContent');
      modal.innerHTML =
        '<div class="view-modal-header">' +
          '<button class="view-modal-close" onclick="closeAdminViewModal()">&times;</button>' +
          '<h2>' + esc(s.title) + '</h2>' +
          '<div class="view-modal-meta">' +
            '<span><strong>Author:</strong> ' + esc(s.author) + '</span>' +
            '<span><strong>Type:</strong> ' + esc(s.type || 'general') + '</span>' +
            '<span><strong>Subjects:</strong> ' + esc(subjectsDisplay) + '</span>' +
            '<span><strong>Status:</strong> <span class="badge badge-' + s.status + '">' + s.status + '</span></span>' +
            '<span><strong>Date:</strong> ' + date + '</span>' +
          '</div>' +
          (s.image ? '<div style="margin-bottom:1rem;"><img src="' + esc(s.image) + '" style="max-width:100%;max-height:300px;border-radius:8px;object-fit:cover;" alt="Cover"></div>' : '') +
          (s.description ? '<p style="color:var(--muted);font-style:italic;margin-bottom:1rem;">' + esc(s.description) + '</p>' : '') +
          '<div class="view-modal-body">' + esc(s.body).replace(/\\n/g, '<br>') + '</div>' +
          (s.admin_notes ? '<div style="margin-top:1rem;padding:0.75rem;background:rgba(251,191,36,0.1);border:1px solid rgba(251,191,36,0.3);border-radius:8px;font-size:0.85rem;"><strong>Admin Notes:</strong> ' + esc(s.admin_notes) + '</div>' : '') +
        '</div>';
      document.getElementById('adminViewModalOverlay').style.display = 'flex';
    } catch(e) {
      alert('Failed to load submission: ' + e.message);
    }
  }

  function closeAdminViewModal() {
    document.getElementById('adminViewModalOverlay').style.display = 'none';
  }

  // Admin delete submission
  async function deleteAdminSubmission(id) {
    if (!confirm('Delete this submission? This action cannot be undone.')) return;
    try {
      const resp = await fetch('/api/submissions/' + id, { method: 'DELETE' });
      const data = await resp.json();
      alert(data.message || data.error);
      loadSubmissions();
    } catch(e) {
      alert('Error: ' + e.message);
    }
  }

  // Admin edit submission
  async function editAdminSubmission(id) {
    try {
      const resp = await fetch('/api/submissions/' + id);
      const data = await resp.json();
      if (!data.success) { alert(data.error); return; }
      const s = data.submission;

      document.getElementById('adminEditId').value = s.id;
      document.getElementById('adminEditTitle').value = s.title || '';
      document.getElementById('adminEditAuthor').value = s.author || '';
      document.getElementById('adminEditType').value = s.type || 'general';
      document.getElementById('adminEditSubject').value = s.subject || '';
      document.getElementById('adminEditTopic').value = s.topic || '';
      document.getElementById('adminEditDescription').value = s.description || '';
      document.getElementById('adminEditBody').value = s.body || '';

      // Subjects: parse JSON array
      adminEditSelectedSubjects = [];
      try {
        var subjData = JSON.parse(s.subject || '[]');
        if (Array.isArray(subjData) && subjData.length > 0) {
          adminEditSelectedSubjects = subjData;
        } else {
          var tagData = JSON.parse(s.tag || '[]');
          adminEditSelectedSubjects = Array.isArray(tagData) ? tagData : [];
        }
      } catch(e) {
        if (s.subject && typeof s.subject === 'string' && s.subject.trim()) {
          adminEditSelectedSubjects = [s.subject.trim()];
        }
      }
      renderAdminEditSubjectChips();

      document.getElementById('adminEditStatus').style.display = 'none';
      document.getElementById('adminEditModalOverlay').style.display = 'flex';
    } catch(e) {
      alert('Failed to load submission: ' + e.message);
    }
  }

  function closeAdminEditModal() {
    document.getElementById('adminEditModalOverlay').style.display = 'none';
    adminEditSelectedSubjects = [];
    renderAdminEditSubjectChips();
    document.getElementById('adminEditSubjectSearch').value = '';
    var dd = document.getElementById('adminEditSubjectDropdown');
    if (dd) dd.style.display = 'none';
  }

  async function saveAdminEdit() {
    const id = document.getElementById('adminEditId').value;
    const statusEl = document.getElementById('adminEditStatus');

    const payload = {
      title: document.getElementById('adminEditTitle').value.trim(),
      author: document.getElementById('adminEditAuthor').value.trim(),
      type: document.getElementById('adminEditType').value,
      subject: document.getElementById('adminEditSubject').value.trim(),
      topic: document.getElementById('adminEditTopic').value.trim(),
      subjects: adminEditSelectedSubjects,
      description: document.getElementById('adminEditDescription').value.trim(),
      body: document.getElementById('adminEditBody').value.trim(),
    };

    try {
      const resp = await fetch('/api/submissions/' + id, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await resp.json();

      if (data.success) {
        statusEl.textContent = data.message || 'Saved successfully.';
        statusEl.className = 'alert alert-success';
        statusEl.style.display = 'block';
        setTimeout(function() {
          closeAdminEditModal();
          loadSubmissions();
        }, 800);
      } else {
        statusEl.textContent = data.error || 'Save failed.';
        statusEl.className = 'alert alert-error';
        statusEl.style.display = 'block';
      }
    } catch(e) {
      statusEl.textContent = 'Network error: ' + e.message;
      statusEl.className = 'alert alert-error';
      statusEl.style.display = 'block';
    }
  }

  // Initialize modals click-outside-to-close
  document.addEventListener('DOMContentLoaded', function() {
    const overlay = document.getElementById('adminViewModalOverlay');
    if (overlay) {
      overlay.addEventListener('click', function(e) {
        if (e.target === overlay) closeAdminViewModal();
      });
    }
    const editOverlay = document.getElementById('adminEditModalOverlay');
    if (editOverlay) {
      editOverlay.addEventListener('click', function(e) {
        if (e.target === editOverlay) closeAdminEditModal();
      });
    }
  });

  async function uploadAdminImage() {
    const fileInput = document.getElementById('adminImageFile');
    const nameInput = document.getElementById('adminImageName');
    const folderInput = document.getElementById('adminImageFolder');
    const status = document.getElementById('imagesStatus');

    if (!fileInput.files[0]) {
      status.textContent = 'Please select a file.';
      status.className = 'alert alert-error';
      status.style.display = 'block';
      return;
    }

    const file = fileInput.files[0];
    if (file.size > 1024 * 1024) {
      status.textContent = 'File too large. Maximum is 1MB.';
      status.className = 'alert alert-error';
      status.style.display = 'block';
      return;
    }

    const base64 = await new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(reader.result);
      reader.onerror = () => reject(reader.error);
      reader.readAsDataURL(file);
    });

    try {
      const resp = await fetch('/api/images/upload', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({
          file: base64,
          name: nameInput.value || file.name,
          description: '',
          folder: folderInput.value
        })
      });
      const data = await resp.json();
      if (data.success) {
        status.textContent = `Uploaded: ${data.url}`;
        status.className = 'alert alert-success';
        fileInput.value = '';
        nameInput.value = '';
        loadImages();
      } else {
        status.textContent = data.error || 'Upload failed.';
        status.className = 'alert alert-error';
      }
      status.style.display = 'block';
    } catch (e) {
      status.textContent = 'Upload error: ' + e.message;
      status.className = 'alert alert-error';
      status.style.display = 'block';
    }
  }

  // --- Helpers ---
  function esc(str) {
    if (!str) return '';
    const d = document.createElement('div');
    d.textContent = String(str);
    return d.innerHTML;
  }

  function formatSize(bytes) {
    if (!bytes) return '0 B';
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1048576) return (bytes/1024).toFixed(1) + ' KB';
    return (bytes/1048576).toFixed(1) + ' MB';
  }

  // ========== SUBJECT MANAGEMENT ==========
  var adminSubjects = window.ADMIN_SUBJECTS ? window.ADMIN_SUBJECTS.slice() : [];
  var adminEditSelectedSubjects = [];

  function loadSubjects() {
    renderSubjectsTable();
    refreshParentList();
  }

  function renderSubjectsTable() {
    var container = document.getElementById('subjectsTable');
    // Group by parent
    var groups = {};
    adminSubjects.forEach(function(s, i) {
      var parent = s.parent || 'Uncategorized';
      if (!groups[parent]) groups[parent] = [];
      groups[parent].push({ name: s.name, index: i });
    });
    var parentNames = Object.keys(groups).sort();
    var html = '';
    parentNames.forEach(function(parent) {
      var items = groups[parent];
      html += '<h4 style="font-family:Outfit,sans-serif;font-size:1rem;margin:1.5rem 0 0.5rem;color:var(--accent);border-bottom:1px solid var(--border);padding-bottom:0.25rem;">' + esc(parent) + ' <span style="font-weight:400;font-size:0.8rem;color:var(--muted);">(' + items.length + ')</span></h4>';
      html += '<table class="data-table"><tbody>';
      items.forEach(function(s) {
        html += '<tr>' +
          '<td style="width:40px;font-size:1.2rem;text-align:center;">📚</td>' +
          '<td><strong>' + esc(s.name) + '</strong></td>' +
          '<td style="white-space:nowrap;">' +
            '<button class="action-btn btn-edit-admin" onclick="editSubject(' + s.index + ')" title="Edit">✏️</button>' +
            '<button class="action-btn btn-delete-sm" onclick="deleteSubject(' + s.index + ')" title="Delete">🗑</button>' +
          '</td>' +
          '</tr>';
      });
      html += '</tbody></table>';
    });
    if (adminSubjects.length === 0) {
      html = '<p style="color:var(--muted);text-align:center;padding:2rem;">No subjects defined. Click "＋ Add Subject" to create the taxonomy.</p>';
    }
    container.innerHTML = html;
  }

  function refreshParentList() {
    var datalist = document.getElementById('parentList');
    var parents = [];
    adminSubjects.forEach(function(s) { if (s.parent && parents.indexOf(s.parent) === -1) parents.push(s.parent); });
    datalist.innerHTML = parents.map(function(p) { return '<option value="' + esc(p) + '">'; }).join('');
  }

  function addNewSubject() {
    document.getElementById('subjEditName').value = '';
    document.getElementById('subjEditParent').value = '';
    document.getElementById('subjEditIndex').value = '-1';
    document.getElementById('subjEditRow').style.display = 'block';
    document.getElementById('subjEditName').focus();
  }

  function editSubject(index) {
    var s = adminSubjects[index];
    document.getElementById('subjEditName').value = s.name;
    document.getElementById('subjEditParent').value = s.parent || '';
    document.getElementById('subjEditIndex').value = index;
    document.getElementById('subjEditRow').style.display = 'block';
    document.getElementById('subjEditName').focus();
  }

  function saveSubjectEdit() {
    var name = document.getElementById('subjEditName').value.trim();
    var parent = document.getElementById('subjEditParent').value.trim();
    var index = parseInt(document.getElementById('subjEditIndex').value);
    if (!name) { alert('Subject name is required.'); return; }

    if (index >= 0) {
      adminSubjects[index] = { name: name, parent: parent || undefined };
    } else {
      adminSubjects.push({ name: name, parent: parent || undefined });
    }

    // Sort by parent then name
    adminSubjects.sort(function(a, b) {
      var pa = (a.parent || '').toLowerCase();
      var pb = (b.parent || '').toLowerCase();
      if (pa !== pb) return pa < pb ? -1 : 1;
      return a.name.toLowerCase() < b.name.toLowerCase() ? -1 : 1;
    });

    cancelSubjectEdit();
    renderSubjectsTable();
    refreshParentList();
  }

  function cancelSubjectEdit() {
    document.getElementById('subjEditRow').style.display = 'none';
    document.getElementById('subjEditIndex').value = '-1';
  }

  function deleteSubject(index) {
    if (!confirm('Delete "' + adminSubjects[index].name + '" from the taxonomy?')) return;
    adminSubjects.splice(index, 1);
    renderSubjectsTable();
    refreshParentList();
  }

  async function saveSubjectsToGitHub() {
    if (!confirm('Save ' + adminSubjects.length + ' subjects to GitHub? This will trigger a redeployment.')) return;
    var statusEl = document.getElementById('subjectsStatus');
    statusEl.textContent = 'Saving...';
    statusEl.className = 'alert alert-info';
    statusEl.style.display = 'block';

    try {
      var resp = await fetch('/api/admin/subjects-save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ subjects: adminSubjects })
      });
      var data = await resp.json();
      if (data.success) {
        statusEl.textContent = data.message;
        statusEl.className = 'alert alert-success';
        window.ADMIN_SUBJECTS = adminSubjects.slice();
      } else {
        statusEl.textContent = data.error || 'Save failed.';
        statusEl.className = 'alert alert-error';
      }
    } catch(e) {
      statusEl.textContent = 'Network error: ' + e.message;
      statusEl.className = 'alert alert-error';
    }
  }

  // ========== ADMIN EDIT SUBJECT AUTOCOMPLETE ==========
  function adminMatchSubjects(query) {
    if (!query || query.length < 2) return [];
    var q = query.toLowerCase();
    return (window.ADMIN_SUBJECTS || []).filter(function(s) {
      return s.name.toLowerCase().indexOf(q) !== -1;
    }).sort(function(a, b) {
      var aStarts = a.name.toLowerCase().indexOf(q) === 0 ? 0 : 1;
      var bStarts = b.name.toLowerCase().indexOf(q) === 0 ? 0 : 1;
      return aStarts - bStarts || a.name.length - b.name.length;
    }).slice(0, 12);
  }

  function renderAdminEditSubjectChips() {
    var container = document.getElementById('adminEditSubjectChips');
    container.innerHTML = adminEditSelectedSubjects.map(function(s, i) {
      return '<span class="chip">' + esc(s) + '<button type="button" class="chip-remove" onclick="removeAdminEditSubject(' + i + ')" title="Remove">&times;</button></span>';
    }).join('');
  }

  function addAdminEditSubject(name) {
    if (adminEditSelectedSubjects.indexOf(name) === -1) {
      adminEditSelectedSubjects.push(name);
      renderAdminEditSubjectChips();
    }
    document.getElementById('adminEditSubjectSearch').value = '';
    document.getElementById('adminEditSubjectDropdown').style.display = 'none';
  }

  function removeAdminEditSubject(index) {
    adminEditSelectedSubjects.splice(index, 1);
    renderAdminEditSubjectChips();
  }

  // Initialize subject autocomplete for admin edit modal
  var adminEditSearchEl = document.getElementById('adminEditSubjectSearch');
  if (adminEditSearchEl) {
    var adminEditDropdownEl = document.getElementById('adminEditSubjectDropdown');
    var adminActiveIdx = -1;

    adminEditSearchEl.addEventListener('input', function() {
      var query = this.value;
      if (query.length < 2) {
        adminEditDropdownEl.style.display = 'none';
        return;
      }
      var matches = adminMatchSubjects(query);
      if (matches.length === 0) {
        adminEditDropdownEl.innerHTML = '<div style="padding:0.65rem 1rem;color:var(--muted);font-size:0.85rem;">No matches</div>';
      } else {
        adminEditDropdownEl.innerHTML = matches.map(function(s) {
          return '<div class="subject-option" data-name="' + esc(s.name) + '" style="padding:0.5rem 0.75rem;cursor:pointer;font-size:0.85rem;border-bottom:1px solid rgba(255,255,255,0.03);"' +
            'onmousedown="event.preventDefault();addAdminEditSubject(\'' + esc(s.name).replace(/'/g, "\\'") + '\')">' +
            esc(s.name) + (s.parent ? ' <span style="font-size:0.7rem;color:var(--muted);">(' + esc(s.parent) + ')</span>' : '') +
            '</div>';
        }).join('');
      }
      adminEditDropdownEl.style.display = 'block';
      adminActiveIdx = -1;
    });

    adminEditSearchEl.addEventListener('keydown', function(e) {
      var options = adminEditDropdownEl.querySelectorAll('.subject-option');
      if (e.key === 'ArrowDown') { e.preventDefault(); adminActiveIdx = Math.min(adminActiveIdx + 1, options.length - 1); options.forEach(function(o, i) { o.style.background = i === adminActiveIdx ? 'rgba(99,102,241,0.12)' : ''; }); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); adminActiveIdx = Math.max(adminActiveIdx - 1, 0); options.forEach(function(o, i) { o.style.background = i === adminActiveIdx ? 'rgba(99,102,241,0.12)' : ''; }); }
      else if (e.key === 'Enter') {
        e.preventDefault();
        if (adminActiveIdx >= 0 && options[adminActiveIdx]) {
          addAdminEditSubject(options[adminActiveIdx].getAttribute('data-name'));
        } else if (options.length > 0) {
          addAdminEditSubject(options[0].getAttribute('data-name'));
        }
        adminActiveIdx = -1;
      }
    });

    document.addEventListener('click', function(e) {
      if (!adminEditSearchEl.contains(e.target) && !adminEditDropdownEl.contains(e.target)) {
        adminEditDropdownEl.style.display = 'none';
      }
    });
  }

  // Load on page load
  loadUserInfo();
  loadApplications();
</script>
