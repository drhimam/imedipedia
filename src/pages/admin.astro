        .replace(/^### (.*$)/gim, '<h3 style="color:var(--text);margin:20px 0 8px;font-size:1.2rem;font-weight:700;border-bottom:1px solid var(--border);padding-bottom:5px;">$1</h3>')
        .replace(/^#### (.*$)/gim, '<h4 style="color:var(--text);margin:14px 0 4px;font-size:1.05rem;font-weight:600;">$1</h4>')
        .replace(/^## (.*$)/gim, '<h2 style="color:var(--accent);margin:24px 0 10px;font-size:1.5rem;font-weight:800;letter-spacing:-0.3px;">$1</h2>')
        .replace(/\*\*(.*?)\*\*/g, '<strong style="color:var(--text);">$1</strong>')
        .replace(/\*(.*?)\*/g, '<em style="color:var(--muted);">$1</em>')
        .replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" target="_blank" style="color:var(--accent);text-decoration:none;font-weight:600;">$1</a>')
        .replace(/^---$/gim, '<hr style="border:none;border-top:1px solid var(--border);margin:20px 0;">')
        .replace(/\n\n/g, '</p><p style="margin:0 0 12px;line-height:1.65;color:var(--text);font-size:0.98rem;">')
        .replace(/\n/g, '<br>');
