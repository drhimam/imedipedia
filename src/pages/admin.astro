  window.saveUserEdit = async function(id) {
    const full_name = document.getElementById('userEditFullName').value.trim();
    const email = document.getElementById('userEditEmail').value.trim();
    const role = document.getElementById('userEditRole').value;
    const avatar_url = document.getElementById('userEditAvatarUrl').value.trim();
    const bio = document.getElementById('userEditBio').value.trim();
    const mfa_enabled = document.getElementById('userEditMfaEnabled').checked;
    const force_password_change = document.getElementById('userEditForcePasswordChange').checked;

    const strToArr = (str) => str.split(',').map(s => s.trim()).filter(Boolean);
    const affiliation = strToArr(document.getElementById('userEditAffiliation').value);
    const specialty = strToArr(document.getElementById('userEditSpecialty').value);
    const experience = strToArr(document.getElementById('userEditExperience').value);

    if (!id) {
      alert('User ID is required.');
      return;
    }

    const btn = document.getElementById('userEditSaveBtn');
    const statusEl = document.getElementById('userEditStatus');
    btn.disabled = true;
    btn.textContent = 'Saving...';
    statusEl.style.display = 'none';

    try {
      const resp = await fetch('/api/admin/users', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id, full_name, email, role, avatar_url, bio, affiliation, specialty, experience, mfa_enabled, force_password_change
        })
      });
      const data = await resp.json();
      statusEl.style.display = 'block';
      if (data.success) {
        statusEl.className = 'alert alert-success';
        statusEl.textContent = data.message || 'User updated successfully.';
        window._loadedUsers[id] = {
          ...window._loadedUsers[id], full_name, email, role, avatar_url, bio,
          affiliation: JSON.stringify(affiliation),
          specialty: JSON.stringify(specialty),
          experience: JSON.stringify(experience),
          mfa_enabled: mfa_enabled ? 1 : 0,
          force_password_change: force_password_change ? 1 : 0
        };
        setTimeout(() => { viewUser(id, 'view'); loadUsers(); }, 800);
      } else {
        statusEl.className = 'alert alert-error';
        statusEl.textContent = data.error || 'Failed to update user.';
      }
    } catch(e) {
      statusEl.style.display = 'block';
      statusEl.className = 'alert alert-error';
      statusEl.textContent = 'Error: ' + e.message;
    } finally {
      btn.disabled = false;
      btn.textContent = 'Save Changes';
    }
  };

  // --- Newsletter Functions ---
  window._loadedNewsletters = {};

  async function loadNewsletters() {
    const tableDiv = document.getElementById('newslettersTable');
    const subsDiv = document.getElementById('subscribersTable');
    if (!tableDiv || !subsDiv) return;

    tableDiv.innerHTML = '<p style="color:var(--muted);">Loading newsletter issues...</p>';
    subsDiv.innerHTML = '<p style="color:var(--muted);">Loading subscribers...</p>';

    try {
      const resp = await fetch('/api/admin/newsletter/list');
      const data = await resp.json();

      if (!resp.ok) {
        tableDiv.innerHTML = `<p class="alert alert-error">${esc(data.error || 'Failed to load newsletters.')}</p>`;
        return;
      }

      // Store in memory map
      window._loadedNewsletters = {};
      (data.newsletters || []).forEach(n => { window._loadedNewsletters[n.id] = n; });

      // Update metrics
      document.getElementById('activeSubCount').textContent = data.stats?.active || 0;
      document.getElementById('totalSubCount').textContent = data.stats?.total || 0;
      document.getElementById('unsubCount').textContent = data.stats?.unsubscribed || 0;

      // Render Newsletters Table
      const issues = data.newsletters || [];
      if (issues.length === 0) {
        tableDiv.innerHTML = '<p style="color:var(--muted);">No digest issues created yet. Click "Generate New Issue" above!</p>';
      } else {
        let html = `<table class="data-table"><thead><tr>
          <th>Issue #</th><th>Title</th><th>Subject</th><th>Status</th><th>Created</th><th>Actions</th>
        </tr></thead><tbody>`;

        issues.forEach(iss => {
          html += `<tr>
            <td><strong>#${iss.issue_number}</strong></td>
            <td><strong class="truncate" style="max-width:220px;">${esc(iss.title)}</strong></td>
            <td><span class="truncate" style="max-width:250px;">${esc(iss.subject)}</span></td>
            <td><span class="badge badge-${iss.status === 'sent' ? 'approved' : 'pending'}">${iss.status}</span></td>
            <td>${new Date(iss.created_at * 1000).toLocaleDateString()}</td>
            <td>
              <div class="dropdown">
                <button onclick="toggleDropdown('nl-drop-${iss.id}')" class="dropdown-btn">⋮</button>
                <div id="nl-drop-${iss.id}" class="dropdown-content">
                  <button onclick="viewNewsletter(${iss.id}, 'view')">🌐 Web Preview / Edit</button>
                  <button onclick="window.open('/admin/newsletter-preview?id=${iss.id}', '_blank')">↗️ Open in New Tab</button>
                  <button onclick="sendNewsletter(${iss.id})">📧 Send to Subscribers (SES)</button>
                  <button onclick="publishNewsletter(${iss.id})">🚀 Publish to /general</button>
                  <button onclick="downloadNewsletterMd(${iss.id})">📄 Download Markdown</button>
                  <button onclick="downloadNewsletterPdf(${iss.id})">📑 Download PDF</button>
                  <button onclick="deleteNewsletter(${iss.id})" style="color:#ef4444;">🗑 Delete</button>
                </div>
              </div>
            </td>
          </tr>`;
        });
        html += `</tbody></table>`;
        tableDiv.innerHTML = html;
      }

      // Render Subscribers Table
      const subs = data.subscribers || [];
      if (subs.length === 0) {
        subsDiv.innerHTML = '<p style="color:var(--muted);">No subscribers yet.</p>';
      } else {
        let sHtml = `<table class="data-table"><thead><tr>
          <th>Email</th><th>Name</th><th>Subscribed Date</th><th>Status</th>
        </tr></thead><tbody>`;

        subs.forEach(s => {
          const isUnsub = !!s.unsubscribed_at;
          sHtml += `<tr>
            <td><strong>${esc(s.email)}</strong></td>
            <td>${esc(s.name || 'N/A')}</td>
            <td>${new Date(s.subscribed_at * 1000).toLocaleDateString()}</td>
            <td><span class="badge badge-${isUnsub ? 'rejected' : 'approved'}">${isUnsub ? 'Unsubscribed' : 'Active'}</span></td>
          </tr>`;
        });
        sHtml += `</tbody></table>`;
        subsDiv.innerHTML = sHtml;
      }

    } catch (e) {
      tableDiv.innerHTML = `<p class="alert alert-error">Error: ${esc(e.message)}</p>`;
    }
  }

  window.generateWeeklyDigest = async function() {
    const btn = document.getElementById('generateDigestBtn');
    if (btn) { btn.disabled = true; btn.textContent = '✨ Synthesizing Digest...'; }

    try {
      const resp = await fetch('/api/admin/newsletter/generate', { method: 'POST' });
      const data = await resp.json();
      if (data.success && data.newsletter) {
        await loadNewsletters();
        // Automatically open View/Edit modal for the newly generated issue
        viewNewsletter(data.newsletter.id, 'edit');
      } else {
        alert(data.error || 'Failed to generate digest.');
      }
    } catch(e) {
      alert('Error: ' + e.message);
    } finally {
      if (btn) { btn.disabled = false; btn.textContent = '✨ Generate New Issue (AI)'; }
    }
  };

