      listEl.innerHTML = loadedReviewersRoster.map(r => {
        let aff = '';
        try { aff = JSON.parse(r.affiliation || '[]').join(', '); } catch { aff = r.affiliation || ''; }
        let spec = '';
        try { spec = JSON.parse(r.specialty || '[]').join(', '); } catch { spec = r.specialty || ''; }

        return `
          <label style="display:flex;align-items:flex-start;gap:0.75rem;padding:0.5rem;border-bottom:1px solid rgba(255,255,255,0.05);cursor:pointer;">
            <input type="checkbox" name="selectedReviewers" value="${r.id}" style="margin-top:0.25rem;">
            <div>
              <strong style="color:var(--text);font-size:0.95rem;">${esc(r.full_name || r.username)}</strong>
              <div style="font-size:0.8rem;color:var(--muted);">${esc(aff || r.email || '')} ${spec ? '• ' + esc(spec) : ''}</div>
            </div>
          </label>
        `;
      }).join('');

    } catch (err) {
      listEl.innerHTML = `<p style="color:#ef4444;font-size:0.85rem;margin:0;">Error loading reviewers: ${esc(err.message)}</p>`;
    }
  };

  window.closeAssignReviewersModal = function() {
    document.getElementById('assignReviewersModalOverlay').style.display = 'none';
  };

  window.submitReviewerAssignment = async function() {
    const subId = document.getElementById('assignSubmissionId').value;
    const checkboxes = document.querySelectorAll('#reviewersSelectionList input[name="selectedReviewers"]:checked');
    const reviewerUserIds = Array.from(checkboxes).map(cb => cb.value);

    if (!reviewerUserIds.length) {
      alert('Please select at least one peer reviewer from the list.');
      return;
    }

    const btn = document.getElementById('sendAssignmentBtn');
    btn.disabled = true;
    const origText = btn.textContent;
    btn.textContent = 'Assigning & sending emails...';

    const statusEl = document.getElementById('assignModalStatus');
    statusEl.style.display = 'none';

    try {
      const resp = await fetch('/api/admin/assign-reviewers', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          submissionId: parseInt(subId),
          reviewerUserIds: reviewerUserIds
        })
      });
      const data = await resp.json();
      if (resp.ok && data.success) {
        statusEl.className = 'alert alert-success';
        statusEl.textContent = data.message || 'Assignment completed and email notifications sent.';
        statusEl.style.display = 'block';
        setTimeout(() => {
          closeAssignReviewersModal();
          loadSubmissions();
        }, 1500);
      } else {
        statusEl.className = 'alert alert-error';
        statusEl.textContent = data.error || 'Assignment failed.';
        statusEl.style.display = 'block';
      }
    } catch (e) {
      statusEl.className = 'alert alert-error';
      statusEl.textContent = 'Error: ' + e.message;
      statusEl.style.display = 'block';
    } finally {
      btn.disabled = false;
      btn.textContent = origText;
    }
  };

  // --- View Peer Reviews Modal ---
  window.viewPeerReviews = async function(submissionId, articleTitle) {
    document.getElementById('reviewDetailsSubTitle').textContent = 'Manuscript: "' + articleTitle + '"';
    const container = document.getElementById('peerReviewsContainer');
    container.innerHTML = '<p style="color:var(--muted);">Loading evaluations...</p>';
    document.getElementById('peerReviewDetailsModalOverlay').style.display = 'flex';

    try {
      const resp = await fetch(`/api/admin/assign-reviewers?submissionId=${submissionId}`);
      const data = await resp.json();
      const assignments = data.assignments || [];

      if (!assignments.length) {
        container.innerHTML = '<p style="color:var(--muted);padding:1rem 0;">No peer reviewers assigned yet for this submission.</p>';
        return;
      }

      container.innerHTML = assignments.map(a => {
        const isDone = !!a.recommendation;
        const recColors = { accept: '#10b981', minor_revisions: '#f59e0b', major_revisions: '#ea580c', reject: '#ef4444' };
        const recColor = recColors[a.recommendation] || 'var(--accent)';

        return `
          <div style="background:var(--card-bg);border:1px solid var(--border);border-radius:12px;padding:1.25rem;margin-bottom:1rem;">
            <div style="display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--border);padding-bottom:0.75rem;margin-bottom:0.75rem;">
              <div>
                <strong style="font-size:1.05rem;">👨‍⚕️ ${esc(a.reviewer_name || 'Reviewer')}</strong>
                <span style="color:var(--muted);font-size:0.85rem;margin-left:0.5rem;">(${esc(a.reviewer_email || '')})</span>
              </div>
              <span class="badge" style="background:${isDone ? 'rgba(16,185,129,0.15)' : 'rgba(245,158,11,0.15)'};color:${isDone ? '#10b981' : '#f59e0b'};">
                ${isDone ? 'Completed' : 'Pending Evaluation'}
              </span>
            </div>

            ${isDone ? `
              <div style="margin-bottom:0.75rem;display:flex;gap:1.5rem;flex-wrap:wrap;font-size:0.9rem;">
                <div><strong>Recommendation:</strong> <span style="color:${recColor};font-weight:700;">${esc(a.recommendation)}</span></div>
                <div><strong>Accuracy:</strong> ${a.clinical_accuracy_score}/5</div>
                <div><strong>Structure:</strong> ${a.structure_score}/5</div>
                <div><strong>Evidence:</strong> ${a.evidence_score}/5</div>
              </div>

              <div style="background:rgba(0,0,0,0.15);padding:1rem;border-radius:8px;margin-bottom:0.75rem;">
                <h4 style="margin:0 0 0.4rem 0;font-size:0.9rem;color:var(--accent);">Author Comments / Feedback:</h4>
                <div style="font-size:0.9rem;line-height:1.6;white-space:pre-wrap;color:var(--text);">${esc(a.author_comments || '')}</div>
              </div>

              ${a.editor_notes ? `
                <div style="background:rgba(239,68,68,0.05);border-left:3px solid #ef4444;padding:0.75rem;border-radius:4px;font-size:0.85rem;">
                  <strong style="color:#ef4444;">Confidential Editor Notes:</strong> ${esc(a.editor_notes)}
                </div>
              ` : ''}
            ` : `
              <p style="color:var(--muted);font-size:0.9rem;margin:0;">Reviewer has been invited on ${new Date(a.assigned_at * 1000).toLocaleDateString()} and has not yet submitted evaluation scores.</p>
            `}
          </div>
        `;
      }).join('');

    } catch (e) {
      container.innerHTML = `<p class="alert alert-error">Error: ${esc(e.message)}</p>`;
    }
  };

  window.closePeerReviewDetailsModal = function() {
    document.getElementById('peerReviewDetailsModalOverlay').style.display = 'none';
  };

  // Handle initial tab from URL params (e.g. ?tab=reviewers&subtab=status)
  const urlParams = new URLSearchParams(window.location.search);
  const initialTab = urlParams.get('tab');
  const initialSubtab = urlParams.get('subtab');

  loadUserInfo();
  if (initialTab) {
    const tabBtn = document.querySelector(`.tab-nav-btn[data-main-tab="${initialTab}"]`);
    if (tabBtn) {
      tabBtn.click();
      if (initialTab === 'reviewers' && initialSubtab) {
        setTimeout(() => switchReviewerSubtab(initialSubtab), 50);
      }
    } else {
      loadApplications();
    }
  } else {
    loadApplications();
  }
</script>
