  var adminEditExamSearchEl = document.getElementById('adminEditExamSearch');
  if (adminEditExamSearchEl) {
    var adminEditExamDropdownEl = document.getElementById('adminEditExamDropdown');
    var adminExamActiveIdx = -1;

    adminEditExamSearchEl.addEventListener('input', function() {
      var query = this.value;
      if (query.length < 2) {
        adminEditExamDropdownEl.style.display = 'none';
        return;
      }
      var matches = adminMatchExams(query);
      if (matches.length === 0) {
        adminEditExamDropdownEl.innerHTML = '<div style="padding:0.65rem 1rem;color:var(--muted);font-size:0.85rem;">No matches</div>';
      } else {
        adminEditExamDropdownEl.innerHTML = matches.map(function(e) {
          return '<div class="subject-option" data-name="' + esc(e.name) + '" style="padding:0.5rem 0.75rem;cursor:pointer;font-size:0.85rem;border-bottom:1px solid rgba(255,255,255,0.03);"' +
            'onmousedown="event.preventDefault();addAdminEditExam(\'' + esc(e.name).replace(/'/g, "\\'") + '\')">' +
            esc(e.name) + (e.category ? ' <span style="font-size:0.7rem;color:var(--muted);">(' + esc(e.category) + ')</span>' : '') +
            '</div>';
        }).join('');
      }
      adminEditExamDropdownEl.style.display = 'block';
      adminExamActiveIdx = -1;
    });

    adminEditExamSearchEl.addEventListener('keydown', function(e) {
      var options = adminEditExamDropdownEl.querySelectorAll('.subject-option');
      if (e.key === 'ArrowDown') { e.preventDefault(); adminExamActiveIdx = Math.min(adminExamActiveIdx + 1, options.length - 1); options.forEach(function(o, i) { o.style.background = i === adminExamActiveIdx ? 'rgba(99,102,241,0.12)' : ''; }); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); adminExamActiveIdx = Math.max(adminExamActiveIdx - 1, 0); options.forEach(function(o, i) { o.style.background = i === adminExamActiveIdx ? 'rgba(99,102,241,0.12)' : ''; }); }
      else if (e.key === 'Enter') {
        e.preventDefault();
        if (adminExamActiveIdx >= 0 && options[adminExamActiveIdx]) {
          addAdminEditExam(options[adminExamActiveIdx].getAttribute('data-name'));
        } else if (options.length > 0) {
          addAdminEditExam(options[0].getAttribute('data-name'));
        }
        adminExamActiveIdx = -1;
      }
    });

    document.addEventListener('click', function(e) {
      if (!adminEditExamSearchEl.contains(e.target) && !adminEditExamDropdownEl.contains(e.target)) {
        adminEditExamDropdownEl.style.display = 'none';
      }
    });
  }

  // ========== AI HELPERS ==========
  async function aiGenerate(prompt, buttonEl) {
    if (!prompt || !prompt.trim()) { alert('Nothing to send to AI — add some content first.'); return null; }
    const doFetch = async () => {
      const resp = await fetch('/api/ai/generate', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ prompt })
      });
      const data = await resp.json();
      if (!resp.ok || data.error) throw new Error(data.error || ('Request failed (' + resp.status + ')'));
      return data.result || '';
    };
    if (buttonEl) {
      buttonEl.disabled = true;
      const original = buttonEl.textContent;
      buttonEl.textContent = '⏳ Working...';
      try { return await doFetch(); }
      catch (e) { alert('AI error: ' + e.message); return null; }
      finally { buttonEl.disabled = false; buttonEl.textContent = original; }
    }
    try { return await doFetch(); }
    catch (e) { alert('AI error: ' + e.message); return null; }
  }

