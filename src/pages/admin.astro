  // ========== ADMIN EDIT SUBJECT AUTOCOMPLETE ==========
  function adminMatchSubjects(query) {
    if (!query || query.length < 2) return [];
    var q = query.toLowerCase();
    return (window.ADMIN_SUBJECTS || []).filter(function(s) {
      return s.name.toLowerCase().indexOf(q) !== -1;
    }).sort(function(a, b) {
      var aStarts = a.name.toLowerCase().indexOf(q) === 0 ? 0 : 1;
      var bStarts = b.name.toLowerCase().indexOf(q) === 0 ? 0 : 1;
      return aStarts - bStarts || a.name.length - b.name.length;
    }).slice(0, 12);
  }

  function renderAdminEditSubjectChips() {
    var container = document.getElementById('adminEditSubjectChips');
    container.innerHTML = adminEditSelectedSubjects.map(function(s, i) {
      return '<span class="chip">' + esc(s) + '<button type="button" class="chip-remove" onclick="removeAdminEditSubject(' + i + ')" title="Remove">&times;</button></span>';
    }).join('');
  }

  function addAdminEditSubject(name) {
    if (adminEditSelectedSubjects.indexOf(name) === -1) {
      adminEditSelectedSubjects.push(name);
      renderAdminEditSubjectChips();
    }
    document.getElementById('adminEditSubjectSearch').value = '';
    document.getElementById('adminEditSubjectDropdown').style.display = 'none';
  }

  function removeAdminEditSubject(index) {
